}

.hot-profile-avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  object-fit: cover;
  display: block;
}

.hot-profile-meta {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.hot-profile-name-row {
  display: flex;
  align-items: center;
  gap: 0.35rem;
}

.hot-profile-name {
  font-family: 'Cinzel', 'Playfair Display', serif;
  font-size: 1.15rem;
  font-weight: 700;
  letter-spacing: 0.05em;
  color: #ffffff;
  margin: 0;
  text-shadow: 0 0 14px rgba(192, 132, 252, 0.85), 0 2px 4px rgba(0, 0, 0, 0.7);
