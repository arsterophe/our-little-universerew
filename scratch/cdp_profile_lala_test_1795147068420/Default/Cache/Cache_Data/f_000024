  font-weight: 700;
  padding: 12px 32px;
  border-radius: 999px;
  cursor: pointer;
  box-shadow: 0 8px 24px rgba(79, 70, 229, 0.5), 0 0 20px rgba(147, 197, 253, 0.4);
  transition: all 0.3s ease;
}

.btn-pinwheel-begin-journey:hover {
  transform: translateY(-2px) scale(1.03);
  box-shadow: 0 12px 32px rgba(79, 70, 229, 0.7), 0 0 28px rgba(147, 197, 253, 0.6);
  border-color: #ffffff;
}

/* ========================================================
   CHAPTER IV: A LETTER FROM LELE — IVORY PARCHMENT
   ======================================================== */
.pinwheel-manuscript-parchment {
