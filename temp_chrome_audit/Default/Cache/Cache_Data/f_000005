/* --------------------------------------------------------------------------
   11. COMPOSITOR-FRIENDLY KEYFRAMES & AMBIENT ANIMATIONS
   -------------------------------------------------------------------------- */
@keyframes shadowAuroraFloat {
  0% {
    opacity: 0.36;
    transform: translate3d(-1.5%, 0, 0) scale(0.98);
  }
  100% {
    opacity: 0.56;
    transform: translate3d(1.5%, 1%, 0) scale(1.04);
  }
}

@keyframes shadowMoonBeamSway {
  0% {
    opacity: 0.32;
    transform: rotate(13deg) scaleY(0.97);
  }
  100% {
    opacity: 0.54;
    transform: rotate(15deg) scaleY(1.03);
  }
}

@keyframes shadowCrystalInternalGlow {
  0% {
    opacity: 0.4;
    transform: scale(0.95);
  }
  100% {
    opacity: 0.82;
    transform: scale(1.05);
  }
}

@keyframes shadowWaterShimmer {
  0% {
    opacity: 0.45;
    transform: scaleX(0.96) translate3d(-2px, 0, 0);
  }
  100% {
    opacity: 0.85;
    transform: scaleX(1.04) translate3d(2px, 0, 0);
  }
}

@keyframes shadowRippleExpand {
  0% {
    opacity: 0.5;
    transform: scale(0.86);
  }
  100% {
    opacity: 0.06;
    transform: scale(1.22);
  }
}

@keyframes shadowWaterfallFlow {
  0% {
    opacity: 0.38;
    transform: translate3d(0, -4px, 0);
  }
  100% {
    opacity: 0.78;
    transform: translate3d(0, 6px, 0);
  }
}

@keyframes shadowStarTwinkleKeyframe {
  0% {
    opacity: 0.3;
    transform: scale(0.85);
  }
  50% {
    opacity: 0.95;
    transform: scale(1.15);
  }
  100% {
    opacity: 0.3;
    transform: scale(0.85);
  }
}

@keyframes shadowLeleBreathe {
  0% {
    transform: translateY(0) scale(1);
  }
  100% {
    transform: translateY(-4px) scale(1.02);
  }
}

@keyframes shadowAuraPulse {
  0% {
    transform: scale(0.92);
    opacity: 0.55;
  }
  100% {
    transform: scale(1.1);
    opacity: 0.95;
  }
}

@keyframes shadowLeleWingL {
  0% {
    transform: rotate(-8deg) scaleX(0.88);
  }
  100% {
    transform: rotate(12deg) scaleX(1.06);
  }
}

@keyframes shadowLeleWingR {
  0% {
    transform: rotate(8deg) scaleX(0.88);
  }
  100% {
    transform: rotate(-12deg) scaleX(1.06);
  }
}

/* Animations active when prefers-reduced-motion is not requested */
@media (prefers-reduced-motion: no-preference) {
  .shadow-aurora {
    animation: shadowAuroraFloat 16s ease-in-out infinite alternate;
  }

  .shadow-aurora.aurora-right {
    animation-delay: -6s;
  }

  .shadow-moon-beam.beam-castle {
    animation: shadowMoonBeamSway 9s ease-in-out infinite alternate;
  }

  .shadow-star-twinkle {
    animation: shadowStarTwinkleKeyframe 3.8s ease-in-out infinite;
  }

  .shadow-crystal-pulse {
    animation: shadowCrystalInternalGlow 4.6s ease-in-out infinite alternate;
  }

  .shadow-crystal-pulse.cr-gallery { animation-delay: 1.1s; }
  .shadow-crystal-pulse.cr-gazebo { animation-delay: 2.2s; }
  .shadow-crystal-pulse.cr-pond-lotus { animation-delay: 0.7s; }

  .shadow-pool-shimmer,
  .shadow-river-shimmer {
    animation: shadowWaterShimmer 5.2s ease-in-out infinite alternate;
  }

  .shadow-pool-ring,
  .shadow-river-ripple {
    animation: shadowRippleExpand 4.8s ease-out infinite;
  }

  .shadow-pool-ring.pr-2,
  .shadow-river-ripple.sr-2 {
    animation-delay: 2.4s;
  }

  .shadow-waterfall-shimmer {
    animation: shadowWaterfallFlow 2.8s ease-in-out infinite alternate;
  }

  .shadow-chibi-actor {
    animation: shadowLeleBreathe 3.8s ease-in-out infinite alternate;
  }

  .shadow-chibi-ring,
  .shadow-lele-aura-ring {
    animation: shadowAuraPulse 2.8s ease-in-out infinite alternate;
  }

  .shadow-lele-wings .wing-left {
    animation: shadowLeleWingL 1.8s ease-in-out infinite alternate;
  }

  .shadow-lele-wings .wing-right {
    animation: shadowLeleWingR 1.8s ease-in-out infinite alternate;
  }
}

@media (prefers-reduced-motion: reduce) {
  .shadow-aurora,
  .shadow-moon-beam,
  .shadow-star-twinkle,
  .shadow-crystal-pulse,
  .shadow-pool-shimmer,
  .shadow-river-shimmer,
  .shadow-pool-ring,
  .shadow-river-ripple,
  .shadow-waterfall-shimmer,
  .shadow-transition-veil,
  .shadow-chibi-actor,
  .shadow-chibi-ring,
  .shadow-lele-aura-ring,
  .shadow-lele-wings .wing-left,
  .shadow-lele-wings .wing-right {
    animation: none !important;
  }
}

/* --------------------------------------------------------------------------
   12. MOBILE & TABLET RESPONSIVENESS
   -------------------------------------------------------------------------- */
@media (max-width: 820px) {
  .shadow-hud-topleft {
    top: 12px;
    left: 12px;
    width: auto;
    max-width: 52vw;
    gap: 0.5rem;
  }

  .shadow-moon-orb {
    width: 38px;
    height: 38px;
  }

  .shadow-char-card {
    padding: 0.45rem 0.7rem 0.45rem 0.5rem;
    gap: 0.55rem;
    border-radius: 16px;
    width: fit-content;
    max-width: 220px;
  }

  .shadow-char-avatar-wrap {
    width: 40px;
    height: 40px;
  }

  .shadow-char-quote {
    display: none;
  }

  .shadow-hud-topright {
    top: 12px;
    right: 12px;
    gap: 0.4rem;
    max-width: 46vw;
  }

  .univ-goto-btn.shadow-return-pill,
  .univ-goto-btn.shadow-story-pill,
  .univ-goto-btn.shadow-behind-pill {
    padding: 0.36rem 0.75rem;
    font-size: 0.72rem;
  }

  .view-shadow-world .universe-hud-state-bar {
    top: auto;
    bottom: 60px;
    right: 12px;
  }

  .shadow-location-panel {
    position: fixed;
    left: 50%;
    bottom: 12px;
    transform: translate(-50%, 14px) scale(0.96);
    width: min(360px, calc(100vw - 1.5rem));
  }

  .shadow-location-panel.open {
    transform: translate(-50%, 0) scale(1);
  }

  .shadow-back-btn {
    bottom: 12px;
    right: 12px;
    height: 40px;
    padding: 0.3rem 0.85rem;
  }
}

@media (max-width: 540px) {
  .shadow-sub-heading {
    display: none;
  }

  .shadow-user-pill {
    display: none; /* Character identity already highlighted in character card */
  }

  .shadow-hud-topleft {
    max-width: 44vw;
  }

  .shadow-hud-topright {
    max-width: 52vw;
    gap: 0.35rem;
  }

  .univ-goto-btn.shadow-return-pill,
  .univ-goto-btn.shadow-story-pill {
    padding: 0.3rem 0.65rem;
    font-size: 0.68rem;
  }

  .univ-goto-btn.shadow-behind-pill {
    padding: 0.3rem 0.7rem;
    gap: 0.4rem;
    max-width: 180px;
  }

  .shadow-behind-main {
    font-size: 0.64rem;
  }

  .univ-goto-btn.shadow-behind-pill .shadow-behind-sub {
    display: none;
  }

  .shadow-char-card {
    background: rgba(14, 18, 44, 0.92);
    max-width: 155px;
    padding: 0.38rem 0.55rem 0.38rem 0.45rem;
    gap: 0.45rem;
  }

  .shadow-char-avatar-wrap {
    width: 36px;
    height: 36px;
  }

  .shadow-char-name {
    font-size: 0.8rem;
  }

  .shadow-char-role {
    font-size: 0.54rem;
  }

  .shadow-loc-pill {
    padding: 0.22rem 0.48rem;
  }

  .shadow-pill-text {
    font-size: 0.52rem;
  }

  .shadow-speech-bubble,
  .shadow-chibi-bubble {
    font-size: 0.64rem;
    padding: 0.28rem 0.65rem;
  }
}
