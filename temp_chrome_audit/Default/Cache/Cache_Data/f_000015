  border-color: #ffffff;
}
.btn-loc-studio { top: 39%; left: 90%; }
.btn-loc-gazebo { top: 54%; left: 41%; }
.btn-loc-fishing { top: 56%; left: 63%; } /* Pengganti Garden */
.btn-loc-catgarden { top: 67%; left: 24%; }
.btn-loc-mailbox { top: 68%; left: 91%; }

/* PINWHEEL MAILBOX & UNREAD BADGE */
.pinwheel-mailbox-badge {
  position: absolute;
  top: -7px;
  right: -7px;
  background: linear-gradient(135deg, #f43f5e 0%, #e11d48 100%);
  color: #ffffff;
  font-size: 0.7rem;
  font-weight: 800;
  min-width: 19px;
  height: 19px;
  line-height: 19px;
  padding: 0 4px;
  border-radius: 999px;
  border: 1.5px solid #ffffff;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 0 12px rgba(244, 63, 94, 0.8), 0 2px 6px rgba(0, 0, 0, 0.4);
  animation: pinwheelBadgePulse 2s infinite ease-in-out;
  pointer-events: none;
}

@keyframes pinwheelBadgePulse {
  0%, 100% {
    transform: scale(1);
    box-shadow: 0 0 8px rgba(244, 63, 94, 0.7);
  }
  50% {
    transform: scale(1.15);
    box-shadow: 0 0 16px rgba(244, 63, 94, 0.95);
  }
}

.pinwheel-loc-btn.btn-loc-mailbox.has-unread {
  border-color: #f43f5e;
  box-shadow: 0 0 20px rgba(244, 63, 94, 0.55), 0 0 8px rgba(147, 197, 253, 0.5);
  animation: pinwheelMailboxGlow 2.5s infinite ease-in-out;
}

@keyframes pinwheelMailboxGlow {
  0%, 100% {
    box-shadow: 0 0 15px rgba(244, 63, 94, 0.4), 0 0 6px rgba(147, 197, 253, 0.4);
  }
  50% {
    box-shadow: 0 0 26px rgba(244, 63, 94, 0.75), 0 0 14px rgba(192, 132, 252, 0.6);
  }
}

/* 6. BOTTOM HUD: MUSIC PLAYER, TAGLINE & ACTION BUTTONS */
.pinwheel-bottom-bar {
  position: absolute;
  bottom: 22px;
  left: 24px;
  right: 24px;
  z-index: 12;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  pointer-events: none;
}

/* A. Bottom-Left: Music Player */
.pinwheel-music-player {
  display: flex;
  align-items: center;
  gap: 14px;
  background: rgba(22, 11, 42, 0.85);
  border: 1px solid rgba(220, 180, 255, 0.45);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  padding: 10px 18px;
  border-radius: 999px;
  box-shadow: 0 10px 30px rgba(11, 5, 24, 0.65), 0 0 18px rgba(168, 85, 247, 0.3);
  pointer-events: auto;
  min-width: 280px;
}

.pinwheel-music-vinyl {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  background: radial-gradient(circle, #2e1065 25%, #090514 30%, #581c87 55%, #180a32 80%, #3b0764 100%);
  border: 1.5px solid rgba(220, 180, 255, 0.7);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.1rem;
  box-shadow: 0 0 12px rgba(192, 132, 252, 0.6);
  flex-shrink: 0;
  transition: transform 0.3s ease;
}

.pinwheel-music-vinyl.is-playing {
  animation: vinylSpin 4s linear infinite;
}

@keyframes vinylSpin {
  100% { transform: rotate(360deg); }
}

.pinwheel-music-info {
  display: flex;
  flex-direction: column;
  gap: 3px;
  flex: 1;
}

.pinwheel-music-title {
  margin: 0;
  font-size: 0.86rem;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 0.02em;
}

.pinwheel-music-sub {
  margin: 0;
  font-size: 0.7rem;
  font-weight: 600;
  color: #d8b4fe;
}

.pinwheel-music-progress-bar {
  width: 100%;
  height: 3px;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 999px;
  overflow: hidden;
  margin-top: 3px;
}

.pinwheel-music-progress-fill {
  height: 100%;
  width: 35%;
  background: linear-gradient(90deg, #c084fc, #f472b6);
  border-radius: 999px;
  box-shadow: 0 0 8px rgba(244, 114, 182, 0.8);
  transition: width 0.3s linear;
}

.pinwheel-music-controls {
  display: flex;
  align-items: center;
  gap: 8px;
}

.pinwheel-music-ctrl-btn {
  background: transparent;
  border: none;
  color: #e9d5ff;
  font-size: 1rem;
  cursor: pointer;
  padding: 4px;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
}

.pinwheel-music-ctrl-btn:hover {
  color: #ffffff;
  transform: scale(1.15);
  text-shadow: 0 0 8px rgba(216, 180, 254, 0.8);
}

.pinwheel-play-btn {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  background: rgba(168, 85, 247, 0.35);
  border: 1px solid rgba(220, 180, 255, 0.5);
  color: #ffffff;
}

.pinwheel-play-btn:hover {
  background: rgba(168, 85, 247, 0.7);
  box-shadow: 0 0 12px rgba(192, 132, 252, 0.8);
}

/* B. Bottom-Center: Tagline Panel */
.pinwheel-tagline-panel {
  display: flex;
  align-items: center;
  gap: 8px;
  background: rgba(22, 11, 42, 0.82);
  border: 1px solid rgba(220, 180, 255, 0.42);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  padding: 8px 24px;
  border-radius: 999px;
  box-shadow: 0 8px 24px rgba(11, 5, 24, 0.65), 0 0 16px rgba(168, 85, 247, 0.25);
  pointer-events: auto;
}

.pinwheel-tagline-text {
  margin: 0;
  font-size: 0.84rem;
  font-weight: 600;
  letter-spacing: 0.05em;
  color: #f5f3ff;
  text-shadow: 0 0 10px rgba(216, 180, 254, 0.5);
}

.pinwheel-tagline-diamond {
  color: #c084fc;
  font-size: 0.8rem;
}

/* C. Bottom-Right: Big Action Buttons (Gallery & Collection) */
.pinwheel-bottom-actions {
  display: flex;
  align-items: center;
  gap: 16px;
  pointer-events: auto;
}

.pinwheel-big-action-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
  background: transparent;
  border: none;
  cursor: pointer;
  outline: none;
  transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
}

.pinwheel-big-action-btn:hover {
  transform: translateY(-4px) scale(1.05);
}

.pinwheel-big-action-circle {
  width: 62px;
  height: 62px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(59, 15, 99, 0.9) 0%, rgba(22, 11, 42, 0.95) 75%);
  border: 2px solid rgba(220, 180, 255, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.8rem;
  color: #ffffff;
  box-shadow: 0 10px 28px rgba(11, 5, 24, 0.75), 0 0 20px rgba(168, 85, 247, 0.45), inset 0 0 12px rgba(216, 180, 254, 0.4);
  transition: all 0.3s ease;
}

.pinwheel-big-action-btn:hover .pinwheel-big-action-circle {
  border-color: #ffffff;
  background: radial-gradient(circle, rgba(88, 28, 135, 0.95) 0%, rgba(45, 18, 80, 0.98) 75%);
  box-shadow: 0 12px 36px rgba(11, 5, 24, 0.85), 0 0 30px rgba(216, 180, 254, 0.85), inset 0 0 16px rgba(255, 255, 255, 0.6);
}

.pinwheel-big-action-label {
  font-size: 0.8rem;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 0.04em;
  text-shadow: 0 0 8px rgba(168, 85, 247, 0.6);
}

/* 7. INTERACTIVE MODALS & PANELS */
.pinwheel-modal-overlay {
  position: fixed;
  inset: 0;
  z-index: 60;
  background: rgba(11, 5, 24, 0.78);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  display: none;
  align-items: center;
  justify-content: center;
  padding: 20px;
}

.pinwheel-modal-overlay.active {
  display: flex;
  animation: pinwheelModalFadeIn 0.35s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

@keyframes pinwheelModalFadeIn {
  from { opacity: 0; transform: scale(0.96); }
  to { opacity: 1; transform: scale(1); }
}

.pinwheel-modal-card {
  width: 540px;
  max-width: 95vw;
  max-height: 88vh;
  overflow-y: auto;
  background: rgba(22, 11, 44, 0.96);
  border: 1.5px solid rgba(220, 180, 255, 0.45);
  border-radius: 24px;
  padding: 26px;
  box-shadow: 0 20px 60px rgba(11, 5, 24, 0.85), 0 0 28px rgba(168, 85, 247, 0.3);
  display: flex;
  flex-direction: column;
  gap: 18px;
  color: #f8fafc;
}

.pinwheel-modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.pinwheel-modal-header-left {
  display: flex;
  align-items: center;
  gap: 12px;
}

.pinwheel-modal-icon-badge {
  width: 48px;
  height: 48px;
  border-radius: 14px;
  background: linear-gradient(135deg, rgba(168, 85, 247, 0.45), rgba(88, 28, 135, 0.75));
  border: 1.5px solid rgba(220, 180, 255, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.6rem;
  box-shadow: 0 4px 16px rgba(168, 85, 247, 0.4);
}

.pinwheel-modal-tag {
  font-size: 0.68rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  color: #c084fc;
  text-transform: uppercase;
}

.pinwheel-modal-title {
  margin: 2px 0 0 0;
  font-size: 1.25rem;
  font-weight: 800;
  color: #ffffff;
}

.pinwheel-modal-close-btn {
  background: transparent;
  border: none;
  color: #cbd5e1;
  font-size: 1.4rem;
  cursor: pointer;
  padding: 6px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
}

.pinwheel-modal-close-btn:hover {
  color: #ffffff;
  background: rgba(255, 255, 255, 0.12);
  transform: scale(1.1);
}

/* 8. FISHING POND INTERACTIVE MINI-GAME */
.pinwheel-fishing-pond-view {
  position: relative;
  width: 100%;
  height: 220px;
  border-radius: 18px;
  overflow: hidden;
  border: 1.5px solid rgba(220, 180, 255, 0.4);
  background: radial-gradient(circle at 50% 60%, #1e1145 0%, #0c0620 90%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.pinwheel-fishing-water-surface {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(147, 51, 234, 0.15) 0%, rgba(30, 17, 69, 0.7) 100%);
  pointer-events: none;
}

.pinwheel-fish-swimmer {
  position: absolute;
  font-size: 1.6rem;
  filter: drop-shadow(0 0 8px rgba(250, 204, 21, 0.7));
  animation: fishSwimAround 12s ease-in-out infinite alternate;
}

@keyframes fishSwimAround {
  0% { transform: translate(-80px, 30px) scaleX(1); }
  50% { transform: translate(60px, -20px) scaleX(1); }
  51% { transform: translate(60px, -20px) scaleX(-1); }
  100% { transform: translate(-100px, -10px) scaleX(-1); }
}

.pinwheel-fishing-bobber {
  font-size: 2.2rem;
  filter: drop-shadow(0 0 10px rgba(239, 68, 68, 0.8));
  display: none;
}

.pinwheel-fishing-bobber.cast {
  display: block;
  animation: bobberFloat 2s ease-in-out infinite alternate;
}

@keyframes bobberFloat {
  0% { transform: translateY(0); }
  100% { transform: translateY(6px); }
}

.pinwheel-fishing-bite-alert {
  position: absolute;
  top: 25px;
  background: rgba(220, 38, 38, 0.9);
  color: #ffffff;
  padding: 6px 16px;
  border-radius: 999px;
  font-size: 0.82rem;
  font-weight: 800;
  display: none;
  animation: bitePulse 0.4s ease infinite alternate;
  box-shadow: 0 0 18px rgba(239, 68, 68, 0.8);
}

@keyframes bitePulse {
  0% { transform: scale(0.95); }
  100% { transform: scale(1.08); }
}

.pinwheel-fishing-action-btn {
  background: linear-gradient(135deg, #a855f7 0%, #7e22ce 100%);
  border: 1px solid rgba(255, 255, 255, 0.4);
  color: #ffffff;
  padding: 12px 24px;
  border-radius: 14px;
  font-size: 0.92rem;
  font-weight: 800;
  letter-spacing: 0.04em;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  box-shadow: 0 6px 20px rgba(168, 85, 247, 0.45);
  transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
}

.pinwheel-fishing-action-btn:hover {
  background: linear-gradient(135deg, #c084fc 0%, #9333ea 100%);
  transform: translateY(-2px);
  box-shadow: 0 8px 26px rgba(192, 132, 252, 0.65);
}

/* 8B. PINWHEEL OBSERVATORY TELESCOPE ACTION BUTTON */
.btn-open-pinwheel-telescope {
  background: linear-gradient(135deg, #0284c7 0%, #38bdf8 55%, #7dd3fc 100%);
  border: 1px solid rgba(255, 255, 255, 0.65);
  color: #0c172e;
  padding: 12px 22px;
  border-radius: 14px;
  font-size: 0.92rem;
  font-weight: 800;
  letter-spacing: 0.03em;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
