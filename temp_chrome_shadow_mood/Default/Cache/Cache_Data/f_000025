}

.pinwheel-behind-close-btn {
  width: 38px;
  height: 38px;
  padding: 0;
  justify-content: center;
  font-size: 1.1rem;
}

.pinwheel-behind-title-badge {
  display: flex;
  align-items: center;
  gap: 12px;
  text-align: center;
}

.pinwheel-badge-icon {
  font-size: 1.8rem;
  filter: drop-shadow(0 0 10px rgba(147, 197, 253, 0.8)) drop-shadow(0 0 16px rgba(192, 132, 252, 0.5));
  animation: gentlePinwheelSpin 6s linear infinite;
}

@keyframes gentlePinwheelSpin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.pinwheel-badge-tag {
  display: block;
  font-size: 0.68rem;
  font-weight: 800;
  letter-spacing: 0.16em;
