}

.btn-pinwheel-song-toggle {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: linear-gradient(135deg, #4f46e5, #7c3aed);
  border: 1px solid #93c5fd;
  color: #ffffff;
  padding: 8px 18px;
  border-radius: 999px;
  font-size: 0.84rem;
  font-weight: 700;
  cursor: pointer;
  transition: all 0.25s ease;
  box-shadow: 0 4px 14px rgba(79, 70, 229, 0.4);
}

.btn-pinwheel-song-toggle:hover {
  transform: scale(1.04);
  box-shadow: 0 6px 18px rgba(79, 70, 229, 0.6);
  border-color: #ffffff;
}

/* YouTube Video Responsive Container */
.pinwheel-video-wrapper {
  position: relative;
  width: 100%;
  padding-bottom: 56.25%; /* 16:9 Aspect Ratio */
  height: 0;
  border-radius: 16px;
  overflow: hidden;
  border: 1.5px solid rgba(147, 197, 253, 0.35);
  margin-top: 18px;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.6);
}

.pinwheel-video-wrapper iframe {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  border: none;
}

/* Footer Navigation Controls */
.pinwheel-behind-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 14px;
  border-top: 1px solid rgba(147, 197, 253, 0.2);
  gap: 16px;
  flex-shrink: 0;
}

.pinwheel-behind-btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: rgba(30, 20, 56, 0.85);
  border: 1px solid rgba(147, 197, 253, 0.35);
  color: #eff6ff;
  padding: 8px 18px;
  border-radius: 999px;
  font-size: 0.84rem;
  font-weight: 700;
  cursor: pointer;
  transition: all 0.25s ease;
}

.pinwheel-behind-btn:hover:not(:disabled) {
  background: rgba(79, 70, 229, 0.85);
  border-color: #93c5fd;
  color: #ffffff;
  box-shadow: 0 0 14px rgba(147, 197, 253, 0.5);
}

.pinwheel-behind-btn:disabled {
  opacity: 0.4;
  cursor: not-allowed;
}

.pinwheel-indicators {
  display: flex;
  align-items: center;
  gap: 8px;
}

.pinwheel-indicator-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: rgba(147, 197, 253, 0.3);
  cursor: pointer;
  transition: all 0.25s ease;
}

.pinwheel-indicator-dot.active {
  width: 24px;
  border-radius: 999px;
  background: #93c5fd;
  box-shadow: 0 0 10px rgba(147, 197, 253, 0.8);
}

/* Universe Top HUD Pill Button (Syma's PINWHEEL World) */
.pinwheel-behind-pill {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: linear-gradient(135deg, rgba(38, 22, 70, 0.92) 0%, rgba(20, 14, 44, 0.92) 100%);
  border: 1.5px solid rgba(147, 197, 253, 0.65);
  box-shadow: 0 6px 18px rgba(6, 4, 18, 0.65), 0 0 14px rgba(147, 197, 253, 0.3);
  border-radius: 999px;
  padding: 6px 16px 6px 14px;
  color: #ffffff;
  cursor: pointer;
  transition: all 0.25s ease;
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  z-index: 50;
}

.pinwheel-behind-pill:hover {
  background: linear-gradient(135deg, rgba(79, 70, 229, 0.95) 0%, rgba(124, 58, 237, 0.95) 100%);
  border-color: #ffffff;
  transform: translateY(-2px) scale(1.02);
  box-shadow: 0 10px 24px rgba(6, 4, 18, 0.8), 0 0 20px rgba(147, 197, 253, 0.6);
}

.pinwheel-behind-icon {
  font-size: 1.25rem;
  display: inline-block;
  animation: gentlePinwheelSpin 5s linear infinite;
}

.pinwheel-behind-label {
  display: flex;
  flex-direction: column;
  text-align: left;
  line-height: 1.15;
}

.pinwheel-behind-main {
  font-size: 0.8rem;
  font-weight: 800;
  letter-spacing: 0.08em;
  color: #ffffff;
  text-transform: uppercase;
}

.pinwheel-behind-sub {
  font-size: 0.65rem;
  color: #93c5fd;
  letter-spacing: 0.02em;
}

.pinwheel-behind-sparkle {
  color: #fde047;
  font-size: 0.85rem;
  text-shadow: 0 0 8px rgba(253, 224, 71, 0.7);
}

/* ========================================================
   RESPONSIVE BREAKPOINTS (TABLET & MOBILE)
   ======================================================== */
@media (max-width: 960px) {
  .pinwheel-chapter-grid {
    grid-template-columns: 1fr;
    gap: 24px;
  }
  .pinwheel-behind-container {
    padding: 14px 18px;
  }
  .pinwheel-behind-chapter-panel {
    padding: 22px 24px;
  }
  .pinwheel-manuscript-parchment {
    padding: 26px 28px;
  }
}

@media (max-width: 640px) {
  .pinwheel-behind-header {
    gap: 8px;
    padding-bottom: 10px;
  }
  .pinwheel-behind-back-btn span:last-child {
    display: none;
  }
  .pinwheel-badge-title {
    font-size: 1.05rem;
  }
  .pinwheel-behind-tab-btn {
    padding: 6px 12px;
    font-size: 0.74rem;
  }
  .pinwheel-behind-tab-btn .tab-title {
    display: none;
  }
  .pinwheel-behind-tab-btn.active .tab-title {
    display: inline;
  }
  .pinwheel-behind-chapter-panel {
    padding: 18px 16px;
    border-radius: 18px;
  }
  .pinwheel-manuscript-parchment {
    padding: 20px 16px;
    border-radius: 14px;
  }
  .pinwheel-chapter-main-title {
    font-size: 1.4rem;
  }
  .pinwheel-paragraph {
    font-size: 0.88rem;
    line-height: 1.7;
  }
  .pinwheel-behind-sub {
    display: none;
  }
  .pinwheel-song-player-card {
    flex-direction: column;
    align-items: stretch;
    gap: 12px;
    text-align: center;
  }
  .pinwheel-song-info {
    text-align: center;
  }
  .btn-pinwheel-song-toggle {
    justify-content: center;
  }
}
