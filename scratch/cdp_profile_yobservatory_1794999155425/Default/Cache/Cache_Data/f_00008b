      if (onShowToast) onShowToast('✨ Royan telah beristirahat dengan damai. Energi & kedamaian batin pulih penuh!');
      if (onTriggerSparkle) onTriggerSparkle();

      setTimeout(() => {
        sleepOverlay.classList.remove('active');
      }, 1400);
    }, 1800);
  }

