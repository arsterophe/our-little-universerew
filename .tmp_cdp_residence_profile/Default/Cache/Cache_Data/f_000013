}

.hot-profile-greeting-pill {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  background: rgba(18, 11, 35, 0.72);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid rgba(192, 132, 252, 0.35);
  padding: 0.3rem 0.95rem 0.3rem 0.35rem;
  border-radius: 9999px;
  box-shadow: 0 6px 24px rgba(11, 7, 23, 0.5);
}

.hot-header-avatar {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  object-fit: cover;
  border: 1.5px solid #c084fc;
}

.hot-header-greeting-text {
  font-size: 0.82rem;
  font-weight: 600;
  color: #f3e8ff;
}

.hot-circle-btn {
  width: 38px;
  height: 38px;
  border-radius: 50%;
  background: rgba(18, 11, 35, 0.72);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  border: 1px solid rgba(192, 132, 252, 0.3);
  color: #e9d5ff;
