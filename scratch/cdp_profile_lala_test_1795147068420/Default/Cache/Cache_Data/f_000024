/* Fullscreen Overlay Dialog */
.pinwheel-behind-overlay {
  position: fixed;
  inset: 0;
  width: 100vw;
  height: 100vh;
  z-index: 9999;
  display: none;
  background: radial-gradient(circle at 50% 15%, rgba(26, 16, 52, 0.98) 0%, rgba(14, 10, 36, 0.98) 50%, rgba(6, 4, 20, 0.99) 100%);
  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);
  color: #f8fafc;
  font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
  overflow: hidden;
  animation: pinwheelBehindFadeIn 0.45s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

.pinwheel-behind-overlay.active {
  display: flex !important;
  flex-direction: column;
}

@keyframes pinwheelBehindFadeIn {
  from {
    opacity: 0;
    transform: scale(0.985);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

/* Floating Magical Ambient Particles: Pinwheels, Sakura, Kitsune Whisps, Wind Chimes */
.pinwheel-behind-particles {
  position: absolute;
  inset: 0;
  pointer-events: none;
  overflow: hidden;
  z-index: 1;
}

.pinwheel-behind-particles .particle {
  position: absolute;
  user-select: none;
  animation: floatPinwheelParticle 10s ease-in-out infinite alternate;
}

.pinwheel-behind-particles .p1 { top: 10%; left: 6%; animation-delay: 0s; font-size: 1.5rem; color: rgba(147, 197, 253, 0.7); text-shadow: 0 0 14px rgba(147, 197, 253, 0.6); }
.pinwheel-behind-particles .p2 { top: 20%; right: 8%; animation-delay: 1.8s; font-size: 1.3rem; color: rgba(192, 132, 252, 0.65); filter: drop-shadow(0 0 10px rgba(192, 132, 252, 0.6)); }
.pinwheel-behind-particles .p3 { bottom: 18%; left: 9%; animation-delay: 3.2s; font-size: 1.6rem; color: rgba(254, 240, 138, 0.6); text-shadow: 0 0 14px rgba(254, 240, 138, 0.5); }
.pinwheel-behind-particles .p4 { bottom: 26%; right: 10%; animation-delay: 4.4s; font-size: 1.4rem; color: rgba(147, 197, 253, 0.75); }
.pinwheel-behind-particles .p5 { top: 52%; left: 4%; animation-delay: 2.5s; font-size: 1.3rem; color: rgba(232, 121, 249, 0.6); }
.pinwheel-behind-particles .p6 { top: 62%; right: 6%; animation-delay: 3.7s; font-size: 1.5rem; color: rgba(254, 240, 138, 0.7); }

@keyframes floatPinwheelParticle {
  0% { transform: translateY(0) rotate(0deg); opacity: 0.35; }
  50% { transform: translateY(-28px) rotate(35deg); opacity: 0.85; }
  100% { transform: translateY(-56px) rotate(70deg); opacity: 0.35; }
}

/* Subtle Meadow Mist and Wind Glow Background Effect */
.pinwheel-behind-wind-glow {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 35%;
  background: radial-gradient(ellipse at 50% 100%, rgba(147, 197, 253, 0.16) 0%, rgba(192, 132, 252, 0.08) 50%, transparent 100%);
  pointer-events: none;
  z-index: 1;
}

/* Main Container */
.pinwheel-behind-container {
  position: relative;
  z-index: 5;
  width: 100%;
  max-width: 1080px;
  height: 100%;
  margin: 0 auto;
  padding: 18px 24px;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

/* Header Bar */
.pinwheel-behind-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 14px;
  border-bottom: 1px solid rgba(147, 197, 253, 0.25);
  gap: 16px;
  flex-shrink: 0;
}

.pinwheel-behind-back-btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: rgba(30, 20, 60, 0.85);
  border: 1px solid rgba(147, 197, 253, 0.45);
  color: #eff6ff;
  padding: 8px 18px;
  border-radius: 999px;
  font-size: 0.85rem;
  font-weight: 700;
  cursor: pointer;
  transition: all 0.25s ease;
  backdrop-filter: blur(10px);
}

.pinwheel-behind-back-btn:hover {
  background: rgba(79, 70, 229, 0.85);
  border-color: #93c5fd;
  color: #ffffff;
  transform: translateX(-3px);
  box-shadow: 0 0 16px rgba(147, 197, 253, 0.55), 0 0 24px rgba(192, 132, 252, 0.35);
}

.pinwheel-behind-title-badge {
  display: flex;
  align-items: center;
  gap: 12px;
  text-align: center;
}

.pinwheel-badge-icon {
  font-size: 1.8rem;
  filter: drop-shadow(0 0 10px rgba(147, 197, 253, 0.8)) drop-shadow(0 0 16px rgba(192, 132, 252, 0.5));
  animation: gentlePinwheelSpin 6s linear infinite;
}

@keyframes gentlePinwheelSpin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.pinwheel-badge-tag {
  display: block;
  font-size: 0.65rem;
  font-weight: 800;
  letter-spacing: 0.16em;
  color: #93c5fd;
  text-transform: uppercase;
}

.pinwheel-badge-title {
  margin: 2px 0 0 0;
  font-family: 'Cinzel', serif, Georgia;
  font-size: 1.35rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  color: #ffffff;
  text-shadow: 0 0 16px rgba(147, 197, 253, 0.7), 0 0 28px rgba(192, 132, 252, 0.5);
}

.pinwheel-behind-close-btn {
  background: transparent;
  border: 1px solid rgba(147, 197, 253, 0.4);
  color: #cbd5e1;
  width: 36px;
  height: 36px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.1rem;
  cursor: pointer;
  transition: all 0.2s ease;
}

.pinwheel-behind-close-btn:hover {
  background: rgba(255, 255, 255, 0.18);
  color: #ffffff;
  transform: scale(1.1);
  border-color: #93c5fd;
}

/* 5-Chapter Stepper Tabs */
.pinwheel-behind-nav {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
  padding: 12px 0;
  flex-shrink: 0;
  flex-wrap: wrap;
}

.pinwheel-behind-tab-btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: rgba(30, 20, 56, 0.7);
  border: 1px solid rgba(147, 197, 253, 0.3);
  color: #cbd5e1;
  padding: 8px 16px;
  border-radius: 999px;
  font-size: 0.82rem;
  cursor: pointer;
  transition: all 0.25s ease;
}

.pinwheel-behind-tab-btn .tab-num {
  font-weight: 800;
  color: #93c5fd;
  font-size: 0.72rem;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.pinwheel-behind-tab-btn .tab-title {
  font-weight: 600;
}

.pinwheel-behind-tab-btn:hover {
  background: rgba(79, 70, 229, 0.85);
  color: #eff6ff;
  border-color: rgba(147, 197, 253, 0.6);
}

.pinwheel-behind-tab-btn.active {
  background: linear-gradient(135deg, rgba(79, 70, 229, 0.95), rgba(124, 58, 237, 0.95));
  border-color: #93c5fd;
  color: #ffffff;
  box-shadow: 0 0 18px rgba(147, 197, 253, 0.55), 0 0 24px rgba(192, 132, 252, 0.35);
}

.pinwheel-behind-tab-btn.active .tab-num {
  color: #dbeafe;
}

/* Reading Progress Bar */
.pinwheel-behind-progress-track {
  width: 100%;
  height: 3px;
  background: rgba(147, 197, 253, 0.15);
  position: relative;
  flex-shrink: 0;
  border-radius: 999px;
  overflow: hidden;
  margin-bottom: 8px;
}

.pinwheel-behind-progress-bar {
  position: absolute;
  top: 0;
  left: 0;
  height: 100%;
  width: 20%;
  background: linear-gradient(90deg, #60a5fa, #a78bfa, #c084fc);
  transition: width 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  box-shadow: 0 0 12px rgba(147, 197, 253, 0.8);
}

/* Scrollable Content Deck */
.pinwheel-behind-deck {
  flex: 1;
  position: relative;
  overflow-y: auto;
  padding: 8px 6px 16px 6px;
  scroll-behavior: smooth;
}

/* Chapter Panel */
.pinwheel-behind-chapter-panel {
  display: none;
  background: linear-gradient(135deg, rgba(28, 16, 52, 0.88) 0%, rgba(18, 12, 38, 0.92) 100%);
  border: 1.5px solid rgba(147, 197, 253, 0.32);
  border-radius: 24px;
  padding: 30px 36px;
  box-shadow: 0 24px 60px rgba(4, 2, 12, 0.75), inset 0 0 35px rgba(147, 197, 253, 0.08);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  animation: pinwheelPanelIn 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

.pinwheel-behind-chapter-panel.active {
  display: block;
}

@keyframes pinwheelPanelIn {
  from {
    opacity: 0;
    transform: translateY(16px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* Chapter Header */
.pinwheel-behind-page-header {
  margin-bottom: 22px;
  border-bottom: 1px dashed rgba(147, 197, 253, 0.3);
  padding-bottom: 16px;
}

.pinwheel-chapter-badge {
  display: inline-block;
  font-size: 0.7rem;
  font-weight: 800;
  letter-spacing: 0.15em;
  color: #93c5fd;
  text-transform: uppercase;
  background: rgba(147, 197, 253, 0.14);
  border: 1px solid rgba(147, 197, 253, 0.35);
  padding: 3px 12px;
