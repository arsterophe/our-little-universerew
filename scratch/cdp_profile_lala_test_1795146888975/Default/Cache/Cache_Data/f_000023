  transition: transform 0.3s ease;
}

.ash-wax-seal:hover {
  transform: scale(1.08) rotate(10deg);
}

.ash-wax-icon {
  font-size: 1.4rem;
}

.ash-wax-label {
  font-size: 0.62rem;
  font-weight: 800;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: #e2e8f0;
}

/* Letter Action Buttons */
.ash-letter-actions {
  display: flex;
  gap: 12px;
  justify-content: center;
  margin-top: 32px;
  flex-wrap: wrap;
}

.btn-ash-letter-action {
  padding: 10px 22px;
  border-radius: 9999px;
  font-size: 0.92rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.25s ease;
  display: inline-flex;
  align-items: center;
  gap: 8px;
}

.btn-ash-letter-action.primary {
  background: linear-gradient(135deg, #7c3aed, #9333ea);
  border: 1px solid #c084fc;
  color: #ffffff;
  box-shadow: 0 4px 15px rgba(147, 51, 234, 0.4);
}

.btn-ash-letter-action.primary:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 20px rgba(147, 51, 234, 0.6);
}

.btn-ash-letter-action.secondary {
  background: rgba(255, 255, 255, 0.08);
  border: 1px solid rgba(196, 181, 253, 0.3);
  color: #e2e8f0;
}

.btn-ash-letter-action.secondary:hover {
  background: rgba(255, 255, 255, 0.16);
  color: #ffffff;
  transform: translateY(-2px);
}

/* =============================================================================
   7. CHAPTER V: EPILOGUE & OFFICIAL SOUNDTRACK PLAYER
   ============================================================================= */
.ash-epilogue-container {
  max-width: 820px;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  gap: 32px;
}

.ash-climax-quote-box {
  background: rgba(24, 15, 42, 0.85);
  backdrop-filter: blur(16px);
  border: 1px solid rgba(196, 181, 253, 0.35);
  border-radius: 20px;
  padding: 36px 32px;
  text-align: center;
  box-shadow: 0 12px 35px rgba(0, 0, 0, 0.5), 0 0 25px rgba(168, 85, 247, 0.25);
}

.ash-climax-quote-icon {
  font-size: 2.4rem;
  margin-bottom: 12px;
  filter: drop-shadow(0 0 12px rgba(196, 181, 253, 0.6));
}

.ash-climax-quote-text {
  font-family: 'Cinzel', serif, Georgia;
  font-size: 1.55rem;
  font-weight: 700;
  line-height: 1.55;
  color: #ffffff;
  margin: 0 0 14px;
  letter-spacing: 0.04em;
  text-shadow: 0 0 16px rgba(196, 181, 253, 0.5);
}

.ash-climax-author {
  font-size: 0.92rem;
  font-style: italic;
  color: #c4b5fd;
}

/* Soundtrack Player Card */
.ash-song-player-card {
  background: rgba(18, 12, 32, 0.9);
  backdrop-filter: blur(16px);
  border: 1px solid rgba(196, 181, 253, 0.3);
  border-radius: 20px;
  padding: 24px;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.45);
}

.ash-track-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 18px;
}

.ash-track-left {
  display: flex;
  align-items: center;
  gap: 14px;
}

.ash-track-disc {
  font-size: 2.2rem;
  display: inline-block;
  transition: transform 0.5s ease;
}

.ash-track-disc.playing {
  animation: spinDisc 3s linear infinite;
}

@keyframes spinDisc {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.ash-track-title {
  display: block;
  font-size: 1.05rem;
  font-weight: 700;
  color: #ffffff;
}

.ash-track-artist {
  display: block;
  font-size: 0.82rem;
  color: #94a3b8;
}

.btn-ash-song-toggle {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 8px 18px;
  border-radius: 9999px;
  background: linear-gradient(135deg, #7c3aed, #db2777);
  border: 1px solid rgba(255, 255, 255, 0.3);
  color: #ffffff;
  font-size: 0.88rem;
  font-weight: 700;
  cursor: pointer;
  box-shadow: 0 4px 15px rgba(124, 58, 237, 0.4);
  transition: all 0.25s ease;
}

.btn-ash-song-toggle:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 20px rgba(219, 39, 119, 0.5);
}

.ash-youtube-box {
  position: relative;
  width: 100%;
  padding-bottom: 56.25%; /* 16:9 ratio */
  height: 0;
  border-radius: 14px;
  overflow: hidden;
  border: 1px solid rgba(196, 181, 253, 0.25);
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.5);
}

.ash-youtube-box iframe {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  border: none;
}

.ash-player-hint {
  font-size: 0.82rem;
  color: #94a3b8;
  margin: 12px 0 0;
  text-align: center;
}

/* =============================================================================
   8. FOOTER NAVIGATION BAR
   ============================================================================= */
.ash-behind-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px 24px;
  background: rgba(15, 10, 26, 0.75);
  backdrop-filter: blur(16px);
  border-top: 1px solid rgba(196, 181, 253, 0.2);
  flex-shrink: 0;
}

.ash-behind-nav-btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 8px 20px;
  border-radius: 9999px;
  background: rgba(46, 26, 71, 0.6);
  border: 1px solid rgba(196, 181, 253, 0.3);
  color: #e2e8f0;
  font-size: 0.88rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.25s ease;
}

.ash-behind-nav-btn:hover:not(:disabled) {
  background: rgba(88, 28, 135, 0.8);
  border-color: #c084fc;
  color: #ffffff;
  transform: translateY(-2px);
  box-shadow: 0 0 15px rgba(168, 85, 247, 0.35);
}

.ash-behind-nav-btn:disabled {
  opacity: 0.35;
  cursor: not-allowed;
}

.ash-chapter-indicators {
  display: flex;
  gap: 10px;
}

.ash-indicator-dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  border: 1px solid rgba(196, 181, 253, 0.4);
  cursor: pointer;
  transition: all 0.25s ease;
  padding: 0;
}

.ash-indicator-dot.active {
  background: #c084fc;
  box-shadow: 0 0 10px #c084fc;
  transform: scale(1.3);
}

/* =============================================================================
   9. UNIVERSE HUD PILL BUTTON FOR RUBEN'S UNIVERSE
   ============================================================================= */
.ash-behind-pill {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 6px 14px;
  border-radius: 9999px;
  background: rgba(30, 18, 48, 0.7);
  border: 1px solid rgba(196, 181, 253, 0.45);
  color: #e2e8f0;
  cursor: pointer;
  backdrop-filter: blur(10px);
  box-shadow: 0 4px 14px rgba(0, 0, 0, 0.35);
  transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  text-decoration: none;
  font-family: inherit;
  margin-right: 8px;
}

.ash-behind-pill:hover {
  background: rgba(88, 28, 135, 0.85);
  border-color: #c084fc;
  color: #ffffff;
  transform: translateY(-2px);
  box-shadow: 0 6px 20px rgba(168, 85, 247, 0.45);
}

.ash-behind-pill .ash-behind-icon {
  font-size: 1.15rem;
  filter: drop-shadow(0 0 6px rgba(196, 181, 253, 0.6));
}

.ash-behind-pill .ash-behind-label {
  display: flex;
  flex-direction: column;
  text-align: left;
}

.ash-behind-pill .ash-behind-main {
  font-family: 'Cinzel', serif;
  font-size: 0.82rem;
  font-weight: 700;
  letter-spacing: 0.05em;
  color: #ffffff;
}

.ash-behind-pill .ash-behind-sub {
  font-size: 0.65rem;
  color: #c4b5fd;
  white-space: nowrap;
}

.ash-behind-pill .ash-behind-sparkle {
  color: #f472b6;
  font-size: 0.8rem;
  animation: floatAshParticle 3s infinite alternate;
}

/* =============================================================================
   10. RESPONSIVE BREAKPOINTS (TABLET & MOBILE)
   ============================================================================= */
@media (max-width: 960px) {
  .ash-chapter-grid {
    grid-template-columns: 1fr;
    gap: 24px;
  }
  .ash-char-profile-card {
    max-width: 440px;
    margin: 0 auto;
  }
}

@media (max-width: 640px) {
  .ash-behind-header {
    padding: 12px 16px;
  }
  .ash-badge-title {
    font-size: 1.1rem;
  }
  .ash-behind-nav {
    justify-content: flex-start;
  }
  .ash-behind-tab-btn {
    min-width: 120px;
    padding: 10px 8px;
  }
  .ash-behind-intro-card {
    padding: 30px 20px;
  }
  .ash-intro-main-title {
    font-size: 2rem;
  }
  .ash-behind-chapter-panel {
    padding: 24px 16px 40px;
  }
  .ash-chapter-main-title {
    font-size: 1.8rem;
  }
  .ash-manuscript-parchment {
    padding: 28px 20px;
  }
  .ash-letter-signoff {
    flex-direction: column;
    align-items: center;
    gap: 20px;
    text-align: center;
  }
  .ash-climax-quote-text {
    font-size: 1.25rem;
  }
  .ash-behind-footer {
    padding: 12px 16px;
  }
}
