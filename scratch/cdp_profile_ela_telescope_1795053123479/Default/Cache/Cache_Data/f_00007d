export function createToyouGazeboAudioEngine() {
  let ctx = null;
  let masterGain = null;
  let activeAmbientSources = [];
  let isPlayingMusic = false;
  let currentAmbient = 'none';
  let melodyTimer = null;

  function initAudioContext() {
