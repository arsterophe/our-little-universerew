  gap: 28px;
  box-sizing: border-box;
}

.pinwheel-epilogue-narrative {
  display: flex;
  flex-direction: column;
}

.pinwheel-epilogue-climax,
.pinwheel-climax-quote-box {
  background: linear-gradient(135deg, rgba(32, 18, 62, 0.85) 0%, rgba(20, 12, 42, 0.9) 100%);
  border: 1.5px solid rgba(147, 197, 253, 0.45);
  border-radius: 22px;
  padding: 34px 38px;
  text-align: center;
  box-shadow: 0 16px 45px rgba(0, 0, 0, 0.55), 0 0 30px rgba(124, 58, 237, 0.22);
  position: relative;
  overflow: hidden;
}

.pinwheel-climax-icon {
  font-size: 2.4rem;
  margin-bottom: 12px;
  filter: drop-shadow(0 0 12px rgba(147, 197, 253, 0.8));
  display: inline-block;
  animation: gentlePinwheelSpin 8s linear infinite;
}

.pinwheel-climax-title,
.pinwheel-epilogue-climax h3 {
  margin: 0 0 12px 0;
  font-family: 'Cinzel', serif, Georgia;
  font-size: 1.65rem;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 0.05em;
  text-shadow: 0 0 18px rgba(147, 197, 253, 0.8), 0 0 28px rgba(192, 132, 252, 0.5);
}

.pinwheel-climax-sub,
.pinwheel-epilogue-climax p {
  margin: 0 0 14px 0;
  font-size: 1.08rem;
  line-height: 1.8;
  color: #eff6ff;
  font-style: italic;
}

.pinwheel-climax-author {
  display: block;
  font-size: 0.78rem;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: #93c5fd;
}

/* Official Universe Soundtrack Player Card */
.pinwheel-soundtrack-card {
  background: rgba(22, 13, 44, 0.85);
  border: 1.5px solid rgba(147, 197, 253, 0.35);
  border-radius: 20px;
  padding: 24px 28px;
  box-shadow: 0 14px 40px rgba(0, 0, 0, 0.55);
  box-sizing: border-box;
}

.pinwheel-soundtrack-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18px;
  gap: 16px;
  flex-wrap: wrap;
}

.pinwheel-soundtrack-info {
  display: flex;
  align-items: center;
  gap: 16px;
}

.pinwheel-song-disc {
  width: 54px;
  height: 54px;
  border-radius: 50%;
  background: radial-gradient(circle, #0f172a 30%, #1e1b4b 60%, #312e81 100%);
  border: 2px solid #93c5fd;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.5rem;
  box-shadow: 0 0 16px rgba(147, 197, 253, 0.45);
  flex-shrink: 0;
  user-select: none;
}

.pinwheel-song-disc.playing {
  animation: spinVinyl 3.5s linear infinite;
}

@keyframes spinVinyl {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.pinwheel-song-titles h4 {
  margin: 0;
  font-size: 1.1rem;
  font-weight: 700;
  color: #ffffff;
}

.pinwheel-song-titles p {
  margin: 2px 0 0 0;
  font-size: 0.82rem;
  color: #93c5fd;
  font-style: italic;
}

.btn-pinwheel-song-toggle {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 8px 22px;
  border-radius: 999px;
  background: linear-gradient(135deg, #4f46e5, #7c3aed);
  border: 1.5px solid rgba(147, 197, 253, 0.6);
  color: #ffffff;
  font-size: 0.86rem;
  font-weight: 700;
  cursor: pointer;
  transition: all 0.25s ease;
  box-shadow: 0 4px 16px rgba(79, 70, 229, 0.4);
  white-space: nowrap;
}

.btn-pinwheel-song-toggle:hover {
  transform: translateY(-1px);
  box-shadow: 0 6px 22px rgba(79, 70, 229, 0.6);
  border-color: #ffffff;
}

/* 16:9 YouTube Video Embed */
.pinwheel-youtube-wrapper,
.pinwheel-video-wrapper {
  position: relative;
  width: 100%;
  padding-bottom: 56.25%; /* 16:9 Aspect Ratio */
  height: 0;
  border-radius: 14px;
  overflow: hidden;
  border: 1px solid rgba(147, 197, 253, 0.35);
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.55);
  background: #000;
  margin-bottom: 14px;
}

.pinwheel-youtube-wrapper iframe,
.pinwheel-video-wrapper iframe {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  border: none;
}

.pinwheel-soundtrack-note {
  margin: 0;
  font-size: 0.8rem;
  color: #94a3b8;
  font-style: italic;
  text-align: center;
}

/* --- 10. FOOTER NAVIGATION (PREVIOUS / NEXT BUTTONS - PROFESSIONAL DESIGN) --- */
.pinwheel-behind-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14px 28px;
  background: linear-gradient(90deg, rgba(16, 8, 34, 0.95), rgba(28, 16, 54, 0.9), rgba(16, 8, 34, 0.95));
  border-top: 1px solid rgba(147, 197, 253, 0.22);
  flex-shrink: 0;
  gap: 16px;
  z-index: 20;
}

.pinwheel-behind-nav-btn,
.pinwheel-behind-btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 8px 20px;
  border-radius: 9999px;
  background: rgba(36, 20, 68, 0.75);
  border: 1px solid rgba(147, 197, 253, 0.4);
  color: #eff6ff;
  font-size: 0.88rem;
  font-weight: 700;
  cursor: pointer;
  transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  box-shadow: 0 4px 14px rgba(0, 0, 0, 0.3);
  user-select: none;
}

.pinwheel-behind-nav-btn:hover:not(:disabled),
.pinwheel-behind-btn:hover:not(:disabled) {
  background: linear-gradient(135deg, rgba(79, 70, 229, 0.9), rgba(124, 58, 237, 0.9));
  border-color: #ffffff;
  color: #ffffff;
  transform: translateY(-2px);
  box-shadow: 0 6px 20px rgba(79, 70, 229, 0.5), 0 0 16px rgba(147, 197, 253, 0.4);
}

.pinwheel-behind-nav-btn:disabled,
.pinwheel-behind-btn:disabled {
  opacity: 0.35;
  cursor: not-allowed;
  transform: none !important;
  box-shadow: none;
}

.pinwheel-behind-footer-indicator,
.pinwheel-indicators {
  display: flex;
  align-items: center;
  gap: 10px;
}

.pinwheel-indicator-dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  border: 1px solid rgba(147, 197, 253, 0.4);
  cursor: pointer;
  transition: all 0.25s ease;
  padding: 0;
}

.pinwheel-indicator-dot:hover {
  background: rgba(147, 197, 253, 0.6);
  transform: scale(1.2);
}

.pinwheel-indicator-dot.active {
  width: 26px;
  border-radius: 999px;
  background: linear-gradient(90deg, #60a5fa, #c084fc);
  box-shadow: 0 0 12px rgba(147, 197, 253, 0.85);
  border-color: #ffffff;
}

/* --- 11. UNIVERSE HUD PILL BUTTON IN SYMA'S UNIVERSE --- */
.pinwheel-behind-pill {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: linear-gradient(135deg, rgba(38, 22, 70, 0.92) 0%, rgba(20, 14, 44, 0.92) 100%);
  border: 1.5px solid rgba(147, 197, 253, 0.65);
  box-shadow: 0 6px 18px rgba(6, 4, 18, 0.65), 0 0 14px rgba(147, 197, 253, 0.3);
  border-radius: 999px;
  padding: 6px 16px 6px 14px;
  color: #ffffff;
  cursor: pointer;
  transition: all 0.25s ease;
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  z-index: 50;
  text-decoration: none;
  font-family: inherit;
}

.pinwheel-behind-pill:hover {
  background: linear-gradient(135deg, rgba(79, 70, 229, 0.95) 0%, rgba(124, 58, 237, 0.95) 100%);
  border-color: #ffffff;
  transform: translateY(-2px) scale(1.02);
  box-shadow: 0 10px 24px rgba(6, 4, 18, 0.8), 0 0 20px rgba(147, 197, 253, 0.6);
}

.pinwheel-behind-icon {
  font-size: 1.25rem;
  display: inline-block;
  animation: gentlePinwheelSpin 5s linear infinite;
}

.pinwheel-behind-label {
  display: flex;
  flex-direction: column;
  text-align: left;
  line-height: 1.15;
}

.pinwheel-behind-main {
  font-size: 0.8rem;
  font-weight: 800;
  letter-spacing: 0.08em;
  color: #ffffff;
  text-transform: uppercase;
}

.pinwheel-behind-sub {
  font-size: 0.65rem;
  color: #93c5fd;
  letter-spacing: 0.02em;
}

.pinwheel-behind-sparkle {
  color: #fde047;
  font-size: 0.85rem;
  text-shadow: 0 0 8px rgba(253, 224, 71, 0.7);
}

/* --- 12. RESPONSIVE BREAKPOINTS (TABLET & MOBILE) --- */
@media (max-width: 960px) {
  .pinwheel-chapter-grid {
    grid-template-columns: 1fr;
    gap: 28px;
  }
  .pinwheel-char-profile-card,
  .pinwheel-feature-card {
    max-width: 100%;
  }
  .pinwheel-portrait-frame,
  .pinwheel-card-portrait {
    height: 320px;
    max-height: 320px;
  }
  .pinwheel-behind-container {
    height: 96vh;
    border-radius: 20px;
  }
  .pinwheel-behind-deck {
    padding: 24px 20px;
  }
  .pinwheel-manuscript-parchment {
    padding: 28px 24px;
  }
}

@media (max-width: 640px) {
  .pinwheel-behind-header {
    gap: 8px;
    padding: 12px 16px;
  }
  .pinwheel-behind-back-btn span:last-child {
    display: none;
  }
  .pinwheel-badge-title {
    font-size: 1.05rem;
  }
  .pinwheel-behind-tab-btn {
    padding: 6px 12px;
    font-size: 0.74rem;
  }
  .pinwheel-behind-tab-btn .tab-title {
    display: none;
  }
  .pinwheel-behind-tab-btn.active .tab-title {
    display: inline;
  }
  .pinwheel-behind-deck {
    padding: 18px 14px 28px;
  }
  .pinwheel-chapter-main-title {
    font-size: 1.5rem;
  }
  .pinwheel-journal-p,
  .pinwheel-paragraph {
    font-size: 0.92rem;
    line-height: 1.75;
  }
  .pinwheel-behind-footer {
    padding: 12px 16px;
  }
  .pinwheel-behind-nav-btn,
  .pinwheel-behind-btn {
    padding: 6px 14px;
    font-size: 0.78rem;
  }
  .pinwheel-behind-nav-btn span:last-child,
  .pinwheel-behind-btn span:last-child {
    font-size: 0.78rem;
  }
  .pinwheel-soundtrack-card {
    padding: 18px 16px;
  }
  .pinwheel-soundtrack-header {
    flex-direction: column;
    align-items: stretch;
    text-align: center;
  }
  .pinwheel-soundtrack-info {
    justify-content: center;
  }
  .btn-pinwheel-song-toggle {
    justify-content: center;
  }
}
