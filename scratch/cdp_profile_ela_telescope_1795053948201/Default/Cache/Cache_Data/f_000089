  function addStickerElement(symbol, x = canvasWidth / 2, y = canvasHeight / 2, size = 52) {
    const id = `el_${Date.now()}_${Math.random().toString(36).substring(2, 6)}`;
    const elData = {
      id,
      type: 'sticker',
      symbol,
      x: x - size / 2,
