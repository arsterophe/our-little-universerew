        shadowStage.style.setProperty('--shadow-px', `${(nx * 7).toFixed(2)}px`);
        shadowStage.style.setProperty('--shadow-py', `${(ny * 5).toFixed(2)}px`);
        shadowParallaxRaf = null;
      });
    });

