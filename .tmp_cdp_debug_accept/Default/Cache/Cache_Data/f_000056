      if (meetingDateInput) meetingDateInput.value = selDate;
      const currentViewer = normalizeCharacterKey(getActiveUserCharacter());
      if (selectedMeetingParticipants.size === 0) {
        ALL_ORBIT_CHARACTERS.forEach(c => {
