/* ==========================================================================
   SHADOW — THE ETHEREAL CRYSTAL PALACE (LELE'S UNIVERSE)
   Dedicated Grand Redesign Stylesheet
   Design Direction: Ethereal Gothic Fantasy · Crystal Palace Architecture ·
                     Celestial Night Garden · Elegant Dark Luxury · Magical Sanctuary
   Palette: Midnight Navy, Deep Indigo, Royal Violet, Amethyst Purple,
            Moonlight Silver, Soft Lavender, Crystal Sapphire Blue Accents
   ========================================================================== */

/* --------------------------------------------------------------------------
   1. VIEWPORT & MAIN STAGE CONTAINER
   -------------------------------------------------------------------------- */
.view-shadow-world {
  width: 100vw;
  width: 100dvw;
  height: 100vh;
  height: 100dvh;
  background-color: #060814;
  overflow: hidden;
  position: relative;
  user-select: none;
}

.shadow-2d-stage {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
  --shadow-px: 0px;
  --shadow-py: 0px;
  background: radial-gradient(circle at 52% 10%, #1c1544 0%, #0c0e28 50%, #050714 100%);
}

/* Multi-Layer Parallax Layers with Safe Initial Fallbacks */
.shadow-parallax-layer {
  position: absolute;
  inset: 0;
  pointer-events: none;
  will-change: transform;
  transition: transform 0.22s cubic-bezier(0.22, 1, 0.36, 1);
}

.layer-shadow-base {
  z-index: 1;
  inset: 0;
  transform: translate3d(calc(var(--shadow-px, 0px) * -0.18), calc(var(--shadow-py, 0px) * -0.18), 0) scale(1.02);
}

.layer-shadow-sky {
  z-index: 2;
  transform: translate3d(calc(var(--shadow-px, 0px) * 0.45), calc(var(--shadow-py, 0px) * 0.35), 0);
}

.layer-shadow-ambient {
  z-index: 3;
  transform: translate3d(calc(var(--shadow-px, 0px) * -0.25), calc(var(--shadow-py, 0px) * -0.22), 0);
}

.layer-shadow-flora {
  z-index: 4;
  transform: translate3d(calc(var(--shadow-px, 0px) * 0.8), calc(var(--shadow-py, 0px) * 0.65), 0);
}

/* Base Scene Artwork */
.shadow-scene-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center center;
  display: block;
  filter: contrast(1.05) saturate(1.08) brightness(0.98);
  transform: scale(1.002);
  transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
}

/* Atmospheric Moonlight Color Grading & Vignette */
.shadow-color-grade {
  position: absolute;
  inset: 0;
  background:
    radial-gradient(circle at 52% 9%, rgba(248, 250, 252, 0.16) 0%, rgba(196, 181, 253, 0.08) 28%, transparent 48%),
    radial-gradient(circle at 35% 28%, rgba(147, 197, 253, 0.12) 0%, transparent 42%),
    radial-gradient(circle at 75% 32%, rgba(167, 139, 250, 0.12) 0%, transparent 44%),
    radial-gradient(circle at 50% 86%, rgba(59, 130, 246, 0.08) 0%, transparent 42%),
    radial-gradient(ellipse at center, transparent 55%, rgba(4, 6, 16, 0.58) 100%);
  pointer-events: none;
}

/* --------------------------------------------------------------------------
   2. CELESTIAL SKY, AURORA & MOONLIGHT SHAFTS
   -------------------------------------------------------------------------- */
.shadow-aurora {
  position: absolute;
  top: -10%;
  height: 42%;
  border-radius: 50%;
  filter: blur(34px);
  mix-blend-mode: screen;
  pointer-events: none;
  opacity: 0.48;
}

.shadow-aurora.aurora-left {
  left: 2%;
  width: 52%;
  background: linear-gradient(
    120deg,
    rgba(59, 130, 246, 0) 0%,
    rgba(96, 165, 250, 0.24) 25%,
    rgba(167, 139, 250, 0.32) 55%,
    rgba(221, 214, 254, 0.16) 78%,
    transparent 100%
  );
  transform: rotate(-6deg);
}

.shadow-aurora.aurora-right {
  right: 1%;
  width: 50%;
  background: linear-gradient(
    240deg,
    rgba(59, 130, 246, 0) 0%,
    rgba(147, 51, 234, 0.22) 28%,
    rgba(129, 140, 248, 0.26) 60%,
    rgba(248, 250, 252, 0.14) 82%,
    transparent 100%
  );
  transform: rotate(5deg);
}

.shadow-moon-halo {
  position: absolute;
  left: 48%;
  top: 0.5%;
  width: 15%;
  height: 22%;
  border-radius: 50%;
  background: radial-gradient(
    circle,
    rgba(255, 255, 255, 0.45) 0%,
    rgba(224, 231, 255, 0.28) 32%,
    rgba(196, 181, 253, 0.18) 55%,
    rgba(96, 165, 250, 0.08) 72%,
    transparent 84%
  );
  filter: blur(14px);
  mix-blend-mode: screen;
  pointer-events: none;
}

.shadow-moon-beams {
  position: absolute;
  inset: 0;
  pointer-events: none;
}

.shadow-moon-beam {
  position: absolute;
  top: 6%;
  background: linear-gradient(
    180deg,
    rgba(248, 250, 252, 0.26) 0%,
    rgba(196, 181, 253, 0.14) 42%,
    rgba(147, 197, 253, 0.05) 75%,
    transparent 100%
  );
  filter: blur(20px);
  mix-blend-mode: screen;
  transform-origin: top center;
  pointer-events: none;
}

.shadow-moon-beam.beam-castle {
  left: 39%;
  width: 16%;
  height: 52%;
  transform: rotate(14deg);
  opacity: 0.52;
}

.shadow-moon-beam.beam-garden {
  left: 56%;
  width: 17%;
  height: 58%;
  transform: rotate(-16deg);
  opacity: 0.44;
}

/* Sparkling Celestial Stars in Sky */
.shadow-stars-field {
  position: absolute;
  inset: 0;
  pointer-events: none;
}

.shadow-star-twinkle {
  position: absolute;
  color: #f8fafc;
  font-size: 0.85rem;
  line-height: 1;
  text-shadow:
    0 0 8px rgba(255, 255, 255, 0.9),
    0 0 16px rgba(196, 181, 253, 0.75),
    0 0 24px rgba(147, 197, 253, 0.5);
  pointer-events: none;
  opacity: 0.65;
  transition: opacity 0.3s ease;
}

.shadow-star-twinkle.st-1 { left: 14%; top: 8%; font-size: 0.95rem; animation-delay: 0s; }
.shadow-star-twinkle.st-2 { left: 24%; top: 14%; font-size: 0.72rem; animation-delay: 1.2s; }
.shadow-star-twinkle.st-3 { left: 38%; top: 6%; font-size: 0.8rem; animation-delay: 0.6s; }
.shadow-star-twinkle.st-4 { left: 63%; top: 9%; font-size: 0.88rem; animation-delay: 1.8s; }
.shadow-star-twinkle.st-5 { left: 74%; top: 12%; font-size: 0.75rem; animation-delay: 0.4s; }
.shadow-star-twinkle.st-6 { left: 86%; top: 7%; font-size: 0.92rem; animation-delay: 1.5s; }
.shadow-star-twinkle.st-7 { left: 47%; top: 18%; font-size: 0.7rem; animation-delay: 2.2s; }
.shadow-star-twinkle.st-8 { left: 81%; top: 22%; font-size: 0.82rem; animation-delay: 0.9s; }

/* Thin Gossamer Mist Wisps */
.shadow-mist-wisp {
  position: absolute;
  background: radial-gradient(ellipse at center, rgba(196, 181, 253, 0.16) 0%, rgba(147, 197, 253, 0.08) 50%, transparent 75%);
  filter: blur(24px);
  mix-blend-mode: screen;
  pointer-events: none;
  opacity: 0.38;
}

.shadow-mist-wisp.mist-1 { left: 2%; top: 20%; width: 26%; height: 12%; }
.shadow-mist-wisp.mist-2 { left: 68%; top: 22%; width: 28%; height: 13%; }
.shadow-mist-wisp.mist-3 { left: 4%; top: 72%; width: 30%; height: 14%; }
.shadow-mist-wisp.mist-4 { left: 64%; top: 80%; width: 28%; height: 12%; }

/* --------------------------------------------------------------------------
   3. CRYSTAL GLOWS & WATER EFFECTS (REFLECTIONS & SHIMMERS)
   -------------------------------------------------------------------------- */
.shadow-crystal-glows {
  position: absolute;
  inset: 0;
  pointer-events: none;
}

.shadow-crystal-pulse {
  position: absolute;
  border-radius: 50%;
  mix-blend-mode: screen;
  filter: blur(16px);
  pointer-events: none;
}

.shadow-crystal-pulse.cr-tower {
  left: 30%;
  top: 9%;
  width: 18%;
  height: 24%;
  background: radial-gradient(circle, rgba(233, 213, 255, 0.45) 0%, rgba(167, 139, 250, 0.22) 50%, rgba(99, 102, 241, 0.1) 70%, transparent 85%);
}

.shadow-crystal-pulse.cr-gallery {
  left: 55%;
  top: 23%;
  width: 16%;
  height: 18%;
  background: radial-gradient(circle, rgba(147, 197, 253, 0.4) 0%, rgba(196, 181, 253, 0.2) 52%, transparent 78%);
}

.shadow-crystal-pulse.cr-observatory {
  left: 7%;
  top: 36%;
  width: 12%;
  height: 16%;
  background: radial-gradient(circle, rgba(253, 230, 138, 0.32) 0%, rgba(196, 181, 253, 0.16) 55%, transparent 78%);
}

.shadow-crystal-pulse.cr-gazebo {
  left: 76%;
  top: 62%;
  width: 16%;
  height: 22%;
  background: radial-gradient(circle, rgba(248, 250, 252, 0.36) 0%, rgba(167, 139, 250, 0.22) 55%, transparent 80%);
}

.shadow-crystal-pulse.cr-left-cluster {
  left: 18%;
  top: 70%;
  width: 12%;
  height: 18%;
  background: radial-gradient(circle, rgba(192, 132, 252, 0.38) 0%, rgba(96, 165, 250, 0.16) 55%, transparent 78%);
}

.shadow-crystal-pulse.cr-right-cluster {
  left: 89%;
  top: 70%;
  width: 10%;
  height: 22%;
  background: radial-gradient(circle, rgba(167, 139, 250, 0.36) 0%, rgba(147, 197, 253, 0.18) 55%, transparent 78%);
}

.shadow-crystal-pulse.cr-pond-lotus {
  left: 27%;
  top: 59%;
  width: 8%;
  height: 10%;
  background: radial-gradient(circle, rgba(243, 232, 255, 0.48) 0%, rgba(253, 230, 138, 0.2) 55%, transparent 78%);
}

/* Water Reflections & Ripples */
.shadow-pool-shimmer {
  position: absolute;
  left: 18%;
  top: 56%;
  width: 26%;
  height: 18%;
  border-radius: 50%;
  background: radial-gradient(
    ellipse at center,
    rgba(248, 250, 252, 0.32) 0%,
    rgba(147, 197, 253, 0.22) 42%,
    rgba(167, 139, 250, 0.12) 65%,
    transparent 80%
  );
  mix-blend-mode: screen;
  filter: blur(10px);
  pointer-events: none;
}

.shadow-river-shimmer {
  position: absolute;
  left: 40%;
  top: 78%;
  width: 28%;
  height: 22%;
  border-radius: 50%;
  background: radial-gradient(
    ellipse at center,
    rgba(224, 231, 255, 0.3) 0%,
    rgba(167, 139, 250, 0.24) 45%,
    rgba(59, 130, 246, 0.16) 68%,
    transparent 82%
  );
  mix-blend-mode: screen;
  filter: blur(10px);
  pointer-events: none;
}

.shadow-water-effects {
  position: absolute;
  inset: 0;
  pointer-events: none;
}

.shadow-pool-ring,
.shadow-river-ripple {
  position: absolute;
  border-radius: 50%;
  border: 1px solid rgba(226, 232, 240, 0.38);
  box-shadow: 0 0 10px rgba(147, 197, 253, 0.35);
  pointer-events: none;
}

.shadow-pool-ring.pr-1 { left: 26.5%; top: 62.5%; width: 8.5%; height: 5%; }
.shadow-pool-ring.pr-2 { left: 24.5%; top: 61.5%; width: 12.5%; height: 7%; }
.shadow-river-ripple.sr-1 { left: 49.5%; top: 85.5%; width: 9.5%; height: 5%; }
.shadow-river-ripple.sr-2 { left: 52.5%; top: 89.5%; width: 11.5%; height: 5.5%; }

.shadow-waterfall-shimmer {
  position: absolute;
  border-radius: 999px;
  background: linear-gradient(
    180deg,
    rgba(255, 255, 255, 0.38) 0%,
    rgba(147, 197, 253, 0.25) 50%,
    rgba(196, 181, 253, 0) 100%
  );
  filter: blur(6px);
  mix-blend-mode: screen;
}

.shadow-waterfall-shimmer.swf-left { left: 11.2%; top: 55%; width: 2.4%; height: 24%; }
.shadow-waterfall-shimmer.swf-right { left: 88.8%; top: 22%; width: 4.8%; height: 24%; }
.shadow-waterfall-shimmer.swf-center { left: 43.5%; top: 73%; width: 2.8%; height: 11%; }

/* Canvas Magical FX & Location Transition Veil */
.shadow-magic-canvas {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  display: block;
  pointer-events: none;
  z-index: 12;
}

.shadow-transition-veil {
  position: fixed;
  inset: 0;
  z-index: 95;
  pointer-events: none;
  opacity: 0;
  background: radial-gradient(
    circle at center,
    rgba(196, 181, 253, 0.28) 0%,
    rgba(24, 18, 56, 0.85) 60%,
    rgba(5, 7, 18, 0.96) 100%
  );
  transition: opacity 0.28s cubic-bezier(0.22, 1, 0.36, 1);
}

.shadow-transition-veil.is-entering {
  opacity: 1;
}

/* --------------------------------------------------------------------------
   4. TOP-LEFT HUD — CELESTIAL TITLE & LELE CHARACTER IDENTITY CARD
   -------------------------------------------------------------------------- */
.shadow-hud-topleft {
  position: absolute;
  top: 20px;
  left: 20px;
  width: min(340px, 28vw);
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  z-index: 24;
  pointer-events: auto;
}

.shadow-title-bar {
  display: flex;
  align-items: center;
  gap: 0.75rem;
}

/* Crescent Moon Emblem Orb */
.shadow-moon-orb {
  width: 44px;
  height: 44px;
  border-radius: 50%;
  background: linear-gradient(135deg, rgba(30, 27, 75, 0.9) 0%, rgba(49, 46, 129, 0.85) 60%, rgba(76, 29, 149, 0.85) 100%);
  border: 1.5px solid rgba(221, 214, 254, 0.65);
  box-shadow:
    0 8px 22px rgba(5, 7, 20, 0.65),
    0 0 16px rgba(167, 139, 250, 0.4),
    inset 0 1px 1px rgba(255, 255, 255, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: all 0.28s cubic-bezier(0.16, 1, 0.3, 1);
  flex-shrink: 0;
  outline: none;
}

.shadow-moon-orb:hover {
  transform: translateY(-2px) scale(1.06) rotate(-8deg);
  border-color: #f3e8ff;
  box-shadow:
    0 12px 28px rgba(5, 7, 20, 0.8),
    0 0 24px rgba(192, 132, 252, 0.7),
    inset 0 1px 2px rgba(255, 255, 255, 0.5);
}

.shadow-moon-orb:focus-visible {
  outline: 2px solid #ddd6fe;
  outline-offset: 3px;
}

.moon-orb-icon {
  font-size: 1.35rem;
  line-height: 1;
  color: #f8fafc;
  filter: drop-shadow(0 0 6px rgba(221, 214, 254, 0.8));
}

.shadow-title-text {
  display: flex;
  flex-direction: column;
}

.shadow-main-heading {
  font-family: 'Cinzel', Georgia, serif;
  font-size: clamp(1.15rem, 1.45vw, 1.45rem);
  font-weight: 700;
  letter-spacing: 0.14em;
  margin: 0;
  line-height: 1.1;
  background: linear-gradient(135deg, #ffffff 0%, #e2e8f0 40%, #c4b5fd 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  filter: drop-shadow(0 2px 8px rgba(0, 0, 0, 0.8));
}

.shadow-sub-heading {
  font-family: 'Plus Jakarta Sans', sans-serif;
  font-size: clamp(0.58rem, 0.72vw, 0.68rem);
  font-weight: 700;
  letter-spacing: 0.24em;
  color: #ddd6fe;
  margin: 0.15rem 0 0;
  text-transform: uppercase;
  text-shadow: 0 1px 6px rgba(5, 7, 20, 0.85);
}

/* Lele Character Identity Card — Ethereal Gothic Luxury */
.shadow-char-card {
  display: flex;
  align-items: center;
  gap: 0.85rem;
  padding: 0.75rem 1.05rem 0.75rem 0.75rem;
  width: 100%;
  box-sizing: border-box;
  border-radius: 20px;
  background: linear-gradient(135deg, rgba(14, 18, 44, 0.84) 0%, rgba(28, 22, 64, 0.86) 60%, rgba(48, 28, 88, 0.84) 100%);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid rgba(221, 214, 254, 0.45);
  box-shadow:
    0 16px 40px rgba(3, 5, 18, 0.75),
    0 0 20px rgba(167, 139, 250, 0.18),
    inset 0 1px 1px rgba(255, 255, 255, 0.22);
  cursor: pointer;
  transition: transform 0.28s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.28s ease, border-color 0.28s ease;
}

.shadow-char-card:hover {
  transform: translateY(-2px);
  border-color: rgba(253, 230, 138, 0.75);
  box-shadow:
    0 20px 48px rgba(3, 5, 18, 0.85),
    0 0 26px rgba(192, 132, 252, 0.45),
    inset 0 1px 2px rgba(255, 255, 255, 0.35);
}

.shadow-char-avatar-wrap {
  width: clamp(52px, 5.2vw, 68px);
  height: clamp(52px, 5.2vw, 68px);
  border-radius: 50%;
  padding: 2px;
  background: linear-gradient(135deg, #f8fafc 0%, #c4b5fd 40%, #7c3aed 100%);
  box-shadow:
    0 4px 16px rgba(0, 0, 0, 0.6),
    0 0 14px rgba(167, 139, 250, 0.5);
  flex-shrink: 0;
  transition: transform 0.28s ease;
}

.shadow-char-card:hover .shadow-char-avatar-wrap {
  transform: scale(1.04) rotate(2deg);
}

.shadow-char-avatar {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  object-fit: cover;
  display: block;
}

.shadow-char-info {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.shadow-char-name {
  font-family: 'Cinzel', Georgia, serif;
  font-size: clamp(0.96rem, 1.2vw, 1.15rem);
  font-weight: 700;
  color: #ffffff;
  margin: 0;
  line-height: 1.15;
  display: flex;
  align-items: center;
  gap: 0.35rem;
  letter-spacing: 0.04em;
  text-shadow: 0 0 10px rgba(196, 181, 253, 0.6);
}

.shadow-moon-symbol {
  color: #e9d5ff;
  font-size: 0.88rem;
  text-shadow: 0 0 8px rgba(221, 214, 254, 0.9);
}

.shadow-char-role {
  font-family: 'Plus Jakarta Sans', sans-serif;
  font-size: clamp(0.64rem, 0.78vw, 0.76rem);
  font-weight: 600;
  letter-spacing: 0.08em;
  color: #ddd6fe;
  margin: 0.15rem 0 0;
  text-transform: uppercase;
}

.shadow-char-quote {
  font-family: 'Cormorant Garamond', Georgia, serif;
  font-style: italic;
  font-size: clamp(0.72rem, 0.88vw, 0.86rem);
  color: #f1f5f9;
  margin: 0.3rem 0 0;
  opacity: 0.92;
  line-height: 1.25;
}

/* --------------------------------------------------------------------------
   5. TOP-RIGHT HUD — LUXURY NAVIGATION PILLS & GREETING
   -------------------------------------------------------------------------- */
.shadow-hud-topright {
  position: absolute;
  top: 20px;
  right: 20px;
  z-index: 24;
  display: flex;
  align-items: center;
  gap: 0.65rem;
  flex-wrap: wrap;
  justify-content: flex-end;
  pointer-events: auto;
}

/* Base Pill Button Styling */
.univ-goto-btn.shadow-return-pill,
.univ-goto-btn.shadow-story-pill,
.univ-goto-btn.shadow-behind-pill {
  display: inline-flex;
  align-items: center;
  gap: 0.45rem;
  padding: 0.45rem 1rem;
  border-radius: 999px;
  font-family: 'Plus Jakarta Sans', sans-serif;
  font-size: clamp(0.72rem, 0.86vw, 0.84rem);
  font-weight: 600;
  cursor: pointer;
  box-sizing: border-box;
  text-decoration: none;
  transition: all 0.24s cubic-bezier(0.16, 1, 0.3, 1);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  outline: none;
}

/* 1. Return Button ("Pergi ke Universe") */
.univ-goto-btn.shadow-return-pill {
  background: linear-gradient(135deg, rgba(20, 24, 60, 0.85) 0%, rgba(38, 28, 80, 0.88) 100%);
  border: 1px solid rgba(221, 214, 254, 0.55);
  box-shadow:
    0 8px 24px rgba(4, 6, 18, 0.65),
    inset 0 1px 1px rgba(255, 255, 255, 0.18);
  color: #ffffff;
}

.univ-goto-btn.shadow-return-pill:hover {
  transform: translateY(-2px);
  border-color: #f3e8ff;
  background: linear-gradient(135deg, rgba(32, 38, 92, 0.95) 0%, rgba(58, 38, 120, 0.95) 100%);
  box-shadow:
    0 12px 30px rgba(4, 6, 18, 0.8),
    0 0 18px rgba(167, 139, 250, 0.5);
}

/* 2. Story Pill ("Story (Karya)") */
.univ-goto-btn.shadow-story-pill {
  background: linear-gradient(135deg, rgba(28, 20, 68, 0.85) 0%, rgba(68, 28, 120, 0.88) 100%);
  border: 1px solid rgba(196, 181, 253, 0.6);
  box-shadow:
    0 8px 24px rgba(4, 6, 18, 0.65),
    inset 0 1px 1px rgba(255, 255, 255, 0.2);
  color: #ffffff;
}

.univ-goto-btn.shadow-story-pill:hover {
  transform: translateY(-2px);
  border-color: rgba(253, 230, 138, 0.8);
  background: linear-gradient(135deg, rgba(48, 30, 110, 0.95) 0%, rgba(98, 38, 170, 0.95) 100%);
  box-shadow:
    0 12px 30px rgba(4, 6, 18, 0.8),
    0 0 20px rgba(192, 132, 252, 0.6);
}

/* 3. BEHIND THE SHADOW — Masterpiece Feature Pill */
.univ-goto-btn.shadow-behind-pill {
  padding: 0.42rem 1.05rem;
  background: linear-gradient(135deg, rgba(18, 20, 52, 0.92) 0%, rgba(42, 24, 88, 0.94) 55%, rgba(68, 28, 110, 0.92) 100%);
  border: 1.25px solid rgba(221, 214, 254, 0.65);
  box-shadow:
    0 10px 28px rgba(4, 6, 18, 0.75),
    0 0 18px rgba(167, 139, 250, 0.35),
    inset 0 1px 1px rgba(255, 255, 255, 0.28);
  color: #ffffff;
  gap: 0.65rem;
}

.univ-goto-btn.shadow-behind-pill:hover {
  transform: translateY(-2px);
  border-color: rgba(253, 230, 138, 0.9);
  background: linear-gradient(135deg, rgba(32, 34, 88, 0.98) 0%, rgba(64, 32, 130, 0.98) 55%, rgba(98, 42, 160, 0.98) 100%);
  box-shadow:
    0 14px 34px rgba(4, 6, 18, 0.85),
    0 0 26px rgba(192, 132, 252, 0.65),
    0 0 10px rgba(253, 230, 138, 0.4);
}

.shadow-behind-label {
  display: flex;
  flex-direction: column;
  text-align: left;
}

.shadow-behind-main {
  font-family: 'Cinzel', Georgia, serif;
