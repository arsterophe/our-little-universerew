}

.ash-parchment-date {
  font-size: 0.82rem;
  color: #94a3b8;
}

.ash-letter-body {
  font-size: 1.05rem;
  line-height: 1.9;
  color: #e2e8f0;
}

.ash-letter-body p {
  margin: 0 0 18px;
}

.ash-letter-body p.salutation {
  font-size: 1.25rem;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 8px;
}

.ash-letter-body p.nickname {
  font-size: 1.15rem;
  font-weight: 600;
  color: #c084fc;
  margin-bottom: 20px;
}

.ash-letter-signoff {
  margin-top: 36px;
  padding-top: 24px;
  border-top: 1px solid rgba(196, 181, 253, 0.2);
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
}

.ash-signoff-text {
  font-size: 0.98rem;
  line-height: 1.6;
  color: #cbd5e1;
}

.ash-signoff-author {
  font-family: 'Cinzel', serif;
  font-size: 1.35rem;
  font-weight: 700;
  color: #ffffff;
  margin-top: 4px;
  text-shadow: 0 0 10px rgba(196, 181, 253, 0.5);
}

.ash-wax-seal {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 90px;
  height: 90px;
  border-radius: 50%;
  background: radial-gradient(circle, #581c87 0%, #3b0764 70%, #1e0338 100%);
  border: 2px solid #c084fc;
  box-shadow: 0 6px 18px rgba(0, 0, 0, 0.6), 0 0 16px rgba(168, 85, 247, 0.5);
  color: #ffffff;
