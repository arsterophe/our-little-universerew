  text-shadow: 0 0 18px rgba(147, 197, 253, 0.65), 0 0 28px rgba(192, 132, 252, 0.4);
}

.pinwheel-chapter-sub-title {
  margin: 6px 0 0 0;
  font-size: 1rem;
  font-style: italic;
  color: #cbd5e1;
  font-family: 'Cormorant Garamond', Georgia, serif;
}

/* 2-Column Chapter Layout */
.pinwheel-chapter-grid {
  display: grid;
  grid-template-columns: 1.25fr 0.95fr;
  gap: 32px;
  align-items: start;
}

.pinwheel-text-col {
