  let yawnMailboxUnsub = null;

  function updateYawnMailboxBadge(unreadCount) {
    const badge = document.getElementById('yawn-mailbox-unread-badge');
    const btn = document.getElementById('btn-loc-yawn-mailbox') || document.querySelector('.btn-loc-yawn-mailbox');
    if (badge) {
      if (unreadCount > 0) {
        badge.textContent = unreadCount > 99 ? '99+' : unreadCount;
        badge.style.display = 'inline-block';
      } else {
        badge.style.display = 'none';
      }
    }
    if (btn) {
      btn.classList.toggle('has-unread', unreadCount > 0);
    }
  }

  function subscribeYawnMailboxUnread(uid) {
    if (typeof yawnMailboxUnsub === 'function') {
      try { yawnMailboxUnsub(); } catch (_) { }
      yawnMailboxUnsub = null;
    }
    const targetUid = uid || AKHIRA_UID;
    try {
      yawnMailboxUnsub = dbSubscribeLetters({ uid: targetUid }, (letters) => {
        const incoming = (letters || []).filter(l => l.recipientUid === targetUid);
        const unread = incoming.filter(l => !l.read).length;
        updateYawnMailboxBadge(unread);
      }, (err) => {
        console.warn('Notice subscribing YAWN mailbox unread:', err);
        dbFetchLetters({ uid: targetUid }).then(letters => {
          const incoming = (letters || []).filter(l => l.recipientUid === targetUid);
          const unread = incoming.filter(l => !l.read).length;
          updateYawnMailboxBadge(unread);
        }).catch(() => { });
      });
    } catch (e) {
      console.warn('Notice setting up YAWN mailbox unread listener:', e);
    }
  }

