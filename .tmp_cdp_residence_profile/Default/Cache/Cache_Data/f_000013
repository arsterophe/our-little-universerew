}

/* --- 5. Interactive Location Hotspots --- */
.hot-hotspots-container {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  z-index: 5;
  pointer-events: none;
}

.hot-loc-btn {
  position: absolute;
  pointer-events: auto;
  display: inline-flex;
  align-items: center;
  gap: 0.45rem;
  padding: 0.5rem 1rem;
  border-radius: 9999px;
  background: rgba(18, 11, 35, 0.72);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  border: 1px solid rgba(192, 132, 252, 0.4);
  color: #f3e8ff;
  font-size: 0.82rem;
  font-weight: 600;
  letter-spacing: 0.02em;
  cursor: pointer;
  transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  box-shadow: 0 6px 20px rgba(11, 7, 23, 0.7), 0 0 16px rgba(192, 132, 252, 0.25);
  transform: translate(-50%, -50%);
  outline: none;
}

.hot-loc-btn::before {
  content: '';
  position: absolute;
  inset: -4px;
  border-radius: 9999px;
  border: 1px dashed rgba(192, 132, 252, 0.3);
  opacity: 0.6;
  animation: rotateHotspotDashed 12s linear infinite;
  pointer-events: none;
}

@keyframes rotateHotspotDashed {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.hot-loc-btn:hover,
.hot-loc-btn:focus-visible {
  background: rgba(56, 26, 92, 0.92);
  border-color: #c084fc;
  color: #ffffff;
  box-shadow: 0 8px 28px rgba(11, 7, 23, 0.8), 0 0 28px rgba(192, 132, 252, 0.6);
  transform: translate(-50%, -50%) scale(1.08);
}

.hot-loc-icon {
  font-size: 1.05rem;
  filter: drop-shadow(0 0 6px rgba(192, 132, 252, 0.6));
}

.hot-loc-pulse {
  position: absolute;
  width: 100%;
  height: 100%;
  top: 0;
  left: 0;
  border-radius: 9999px;
  box-shadow: 0 0 14px rgba(192, 132, 252, 0.6);
  opacity: 0.7;
  animation: hotspotPulse 2.8s infinite ease-out;
  pointer-events: none;
}

@keyframes hotspotPulse {
  0% { transform: scale(0.96); opacity: 0.8; }
  50% { transform: scale(1.16); opacity: 0; }
  100% { transform: scale(0.96); opacity: 0; }
}

/* Individual Hotspot Coords (matched to artwork features) */
.btn-loc-hot-residence   { top: 46%; left: 18%; }
