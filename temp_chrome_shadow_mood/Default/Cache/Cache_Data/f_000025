  overflow-y: auto;
  overflow-x: hidden;
  padding: 32px 36px 40px;
  box-sizing: border-box;
  scrollbar-width: thin;
  scrollbar-color: rgba(147, 197, 253, 0.35) rgba(15, 8, 30, 0.5);
}

.pinwheel-behind-deck::-webkit-scrollbar {
  width: 6px;
}
.pinwheel-behind-deck::-webkit-scrollbar-track {
  background: rgba(15, 8, 30, 0.5);
}
.pinwheel-behind-deck::-webkit-scrollbar-thumb {
  background: rgba(147, 197, 253, 0.35);
  border-radius: 999px;
}

