  getOrbitEvents,
  getCurrentDate,
  getSelectedDateStr,
  getActiveViewMode,
  getActiveCategoryFilter,
  getActiveUserCharacter,
  setActiveUserCharacter,
  setViewMode,
  setCategoryFilter,
  setSelectedDate,
  navigateCalendar,
  getFilteredEvents,
