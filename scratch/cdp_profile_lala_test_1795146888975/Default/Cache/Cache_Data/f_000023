}

.ash-parchment-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1px solid rgba(196, 181, 253, 0.2);
  padding-bottom: 16px;
  margin-bottom: 28px;
}

.ash-parchment-from {
  font-size: 0.85rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: #c4b5fd;
