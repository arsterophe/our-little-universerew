        switchBehindFairyChapter(currentFairyBehindChapter - 1);
      } else if (e.key === 'ArrowRight' && currentFairyBehindChapter < 4) {
        switchBehindFairyChapter(currentFairyBehindChapter + 1);
      }
    }
  });

