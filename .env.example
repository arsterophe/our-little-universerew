# ==============================================================================
# OUR LITTLE UNIVERSE — FIREBASE CONFIGURATION TEMPLATE
# ==============================================================================
# Salin file ini menjadi .env lalu isi dengan nilai konfigurasi proyek Firebase Anda.
# Jangan pernah membagikan atau mengunggah file .env dengan kredensial rahasia ke repositori publik.

# 1. Kredensial Firebase Web App (Dapatkan dari Firebase Console > Project Settings > General)
VITE_FIREBASE_API_KEY=AIzaSyBTosMnFtFuP0nEjcarnoPEIZshrp6K0Ns
VITE_FIREBASE_AUTH_DOMAIN=our-little-universe.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=our-little-universe-dcd75
VITE_FIREBASE_STORAGE_BUCKET=our-little-universe.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# 2. Pemetaan Email Karakter Tiga Sahabat
# Isi dengan email akun resmi yang dibuat di Firebase Authentication
VITE_NYANYA_EMAIL=nyanya@ourlittleuniverse.com
VITE_LALA_EMAIL=lala@ourlittleuniverse.com
VITE_LELE_EMAIL=lele@ourlittleuniverse.com

# 3. Pemetaan UID Karakter Tiga Sahabat (Ketat)
# Isi dengan UID unik dari Firebase Authentication Console > Users
VITE_NYANYA_UID=
VITE_LALA_UID=
VITE_LELE_UID=
