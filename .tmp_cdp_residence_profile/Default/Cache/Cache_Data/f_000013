  margin-left: 0.35rem;
}

.hot-world-title {
  font-family: 'Cinzel', 'Playfair Display', serif;
  font-size: 0.95rem;
  font-weight: 700;
  letter-spacing: 0.12em;
  color: #f3e8ff;
  text-shadow: 0 0 12px rgba(192, 132, 252, 0.7);
  text-transform: uppercase;
}

.hot-world-subtitle {
  font-size: 0.7rem;
  color: #d8b4fe;
  font-style: italic;
  letter-spacing: 0.04em;
}

/* Center Global Navigation Bar */
.hot-top-center-nav {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  background: rgba(18, 11, 35, 0.65);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  border: 1px solid rgba(192, 132, 252, 0.25);
  padding: 0.35rem 0.6rem;
  border-radius: 9999px;
  box-shadow: 0 6px 24px rgba(11, 7, 23, 0.5);
}

.hot-nav-pill-btn {
  display: inline-flex;
  align-items: center;
  gap: 0.35rem;
  padding: 0.42rem 0.85rem;
  border-radius: 9999px;
  background: transparent;
  border: 1px solid transparent;
  color: #e9d5ff;
  font-size: 0.8rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.22s ease;
}

.hot-nav-pill-btn:hover {
  background: rgba(192, 132, 252, 0.22);
  border-color: rgba(192, 132, 252, 0.5);
  color: #ffffff;
  box-shadow: 0 0 14px rgba(192, 132, 252, 0.3);
  transform: translateY(-1px);
}

/* Right Header Controls */
.hot-top-right-nav {
  display: flex;
  align-items: center;
  gap: 0.65rem;
}

.hot-back-universes-btn {
  display: inline-flex;
  align-items: center;
  gap: 0.45rem;
  padding: 0.42rem 0.95rem;
  background: rgba(18, 11, 35, 0.65);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  border: 1px solid rgba(192, 132, 252, 0.4);
  border-radius: 9999px;
