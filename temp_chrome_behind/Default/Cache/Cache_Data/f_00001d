/* ==========================================================================
   PINWHEEL — MOONLIT BLOSSOM GAZEBO (SYMA'S UNIVERSE)
   Visual Theme: Japanese Fantasy, Cherry Blossom, Lavender Moonlight, Kitsune Sanctuary
   Main Background: /assets/pinwheel_gazebo_bg.jpg
   ========================================================================== */

.view-pinwheel-gazebo {
  position: fixed;
  inset: 0;
  width: 100vw;
  height: 100vh;
  height: 100dvh;
  max-height: 100vh;
  max-height: 100dvh;
  display: none;
  overflow: hidden;
  user-select: none;
  z-index: 95;
  color: #f8fafc;
  font-family: 'Plus Jakarta Sans', 'Outfit', system-ui, -apple-system, sans-serif;
  background: #090a1a url('/assets/pinwheel_gazebo_bg.jpg') center center / cover no-repeat;
  transition: opacity 0.5s ease;
}

.view-pinwheel-gazebo.active {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

/* ==========================================================================
   1. ATMOSPHERIC OVERLAYS & ANIMATED EFFECTS
   ========================================================================== */

.pinwheel-gazebo-ambient-vignette {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 1;
  background: radial-gradient(circle at 50% 45%, rgba(20, 15, 45, 0.05) 0%, rgba(30, 12, 55, 0.35) 75%, rgba(10, 5, 22, 0.78) 100%);
}

/* Falling Sakura Petals */
.pinwheel-gazebo-petals-layer {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 2;
  overflow: hidden;
}

.pinwheel-gazebo-petal {
  position: absolute;
  font-size: 1.15rem;
  color: #f472b6;
  opacity: 0.75;
  pointer-events: none;
  filter: drop-shadow(0 0 6px rgba(244, 114, 182, 0.6));
  animation: gazeboPetalDrift 11s infinite linear;
}

.pinwheel-gazebo-petal.p1 { top: -20px; left: 12%; animation-duration: 9.5s; animation-delay: 0s; }
.pinwheel-gazebo-petal.p2 { top: -20px; left: 28%; animation-duration: 13s; animation-delay: 2s; font-size: 1.3rem; }
.pinwheel-gazebo-petal.p3 { top: -20px; left: 45%; animation-duration: 10.5s; animation-delay: 4.5s; }
.pinwheel-gazebo-petal.p4 { top: -20px; left: 62%; animation-duration: 12s; animation-delay: 1.2s; font-size: 1.4rem; }
.pinwheel-gazebo-petal.p5 { top: -20px; left: 78%; animation-duration: 14s; animation-delay: 3s; }
.pinwheel-gazebo-petal.p6 { top: -20px; left: 90%; animation-duration: 11s; animation-delay: 6s; }
.pinwheel-gazebo-petal.p7 { top: -20px; left: 35%; animation-duration: 12.5s; animation-delay: 5s; font-size: 0.95rem; }
.pinwheel-gazebo-petal.p8 { top: -20px; left: 70%; animation-duration: 10s; animation-delay: 7s; }

@keyframes gazeboPetalDrift {
  0% {
    transform: translateY(0) rotate(0deg) translateX(0);
    opacity: 0;
  }
  15% {
    opacity: 0.85;
  }
  50% {
    transform: translateY(50vh) rotate(180deg) translateX(-45px);
    opacity: 0.9;
  }
  85% {
    opacity: 0.7;
  }
  100% {
    transform: translateY(105vh) rotate(360deg) translateX(30px);
    opacity: 0;
  }
}

/* Glowing Butterflies */
.pinwheel-gazebo-butterflies-layer {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 3;
  overflow: hidden;
}

.pinwheel-gazebo-butterfly {
  position: absolute;
  font-size: 1.35rem;
  pointer-events: none;
  filter: drop-shadow(0 0 10px #f472b6) drop-shadow(0 0 18px #c084fc);
  animation: gazeboButterflyFlutter 12s infinite ease-in-out;
}

.pinwheel-gazebo-butterfly.b1 { top: 38%; left: 16%; animation-duration: 11s; animation-delay: 0s; }
.pinwheel-gazebo-butterfly.b2 { top: 22%; left: 42%; animation-duration: 14s; animation-delay: 3s; font-size: 1.1rem; }
.pinwheel-gazebo-butterfly.b3 { top: 48%; left: 82%; animation-duration: 13s; animation-delay: 1.5s; }
.pinwheel-gazebo-butterfly.b4 { top: 65%; left: 26%; animation-duration: 15s; animation-delay: 5s; font-size: 1.25rem; }

@keyframes gazeboButterflyFlutter {
  0% {
    transform: translate(0, 0) scale(0.9) rotate(-10deg);
    opacity: 0.35;
  }
  25% {
    transform: translate(35px, -25px) scale(1.15) rotate(15deg);
    opacity: 0.95;
  }
  50% {
    transform: translate(70px, 15px) scale(0.95) rotate(-5deg);
    opacity: 0.65;
  }
  75% {
    transform: translate(40px, 45px) scale(1.1) rotate(10deg);
    opacity: 0.9;
  }
  100% {
    transform: translate(0, 0) scale(0.9) rotate(-10deg);
    opacity: 0.35;
  }
}

/* Subtle Water Shimmer & Floating Lantern Glow */
.pinwheel-gazebo-water-shimmer {
  position: absolute;
  bottom: 12%;
  left: 30%;
  right: 25%;
  height: 120px;
  pointer-events: none;
  z-index: 2;
  background: radial-gradient(ellipse at 50% 60%, rgba(244, 114, 182, 0.22) 0%, rgba(192, 132, 252, 0.15) 45%, transparent 75%);
  filter: blur(12px);
  animation: gazeboWaterPulse 6s infinite alternate ease-in-out;
}

@keyframes gazeboWaterPulse {
  0% { opacity: 0.5; transform: scaleX(0.95) translateY(0); }
  100% { opacity: 0.9; transform: scaleX(1.08) translateY(-4px); }
}

/* ==========================================================================
   2. TOP BAR & BRANDING
   ========================================================================== */

.pinwheel-gazebo-top-bar {
  position: relative;
  z-index: 10;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 1.25rem 2rem;
  pointer-events: auto;
}

.pinwheel-gazebo-brand {
  display: flex;
  flex-direction: column;
  gap: 0.45rem;
}

.btn-pinwheel-gazebo-back {
  display: inline-flex;
  align-items: center;
  gap: 0.45rem;
  padding: 0.45rem 1.15rem;
  background: rgba(30, 16, 52, 0.6);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border: 1px solid rgba(244, 114, 182, 0.35);
  border-radius: 999px;
  color: #fce7f3;
  font-size: 0.84rem;
  font-weight: 700;
  cursor: pointer;
  transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  box-shadow: 0 4px 14px rgba(0, 0, 0, 0.35);
  width: fit-content;
}

.btn-pinwheel-gazebo-back:hover {
  background: rgba(244, 114, 182, 0.35);
  border-color: #f472b6;
  color: #ffffff;
  transform: translateX(-3px);
  box-shadow: 0 0 20px rgba(244, 114, 182, 0.4);
}

.pinwheel-gazebo-title-group {
  display: flex;
  align-items: center;
  gap: 0.65rem;
}

.pinwheel-gazebo-crescent {
  font-size: 1.5rem;
  color: #fbcfe8;
  filter: drop-shadow(0 0 10px rgba(244, 114, 182, 0.8));
}

.pinwheel-gazebo-title-texts h1 {
  margin: 0;
  font-size: 1.35rem;
  font-weight: 900;
  letter-spacing: 0.08em;
  color: #ffffff;
  text-shadow: 0 2px 14px rgba(244, 114, 182, 0.65);
}

.pinwheel-gazebo-title-texts p {
  margin: 0;
  font-size: 0.78rem;
  color: #e9d5ff;
  font-weight: 600;
  letter-spacing: 0.04em;
}

.pinwheel-gazebo-subquote {
  margin: 0;
  font-size: 0.76rem;
  font-style: italic;
  color: #cbd5e1;
  text-shadow: 0 2px 8px rgba(0, 0, 0, 0.6);
}

/* Top Right: Music Player Pill (PINWHEEL MELODY) */
.pinwheel-gazebo-music-pill {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  padding: 0.5rem 1.15rem;
  background: rgba(26, 14, 46, 0.75);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  border: 1px solid rgba(244, 114, 182, 0.38);
  border-radius: 999px;
  box-shadow: 0 6px 20px rgba(0, 0, 0, 0.45), 0 0 16px rgba(244, 114, 182, 0.2);
  transition: all 0.3s ease;
}

.pinwheel-gazebo-music-pill:hover {
  border-color: #f472b6;
  box-shadow: 0 6px 24px rgba(244, 114, 182, 0.3);
}

.music-title-wrap {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  font-size: 0.82rem;
  font-weight: 700;
  color: #fdf2f8;
}

.music-note-icon {
  font-size: 1rem;
  display: inline-block;
  animation: noteRotate 4s infinite linear paused;
}

@keyframes noteRotate {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.btn-pinwheel-music-play {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  border: none;
  background: linear-gradient(135deg, #f472b6, #a855f7);
  color: #ffffff;
  font-size: 0.85rem;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  box-shadow: 0 2px 10px rgba(244, 114, 182, 0.5);
  transition: all 0.2s ease;
}

.btn-pinwheel-music-play:hover {
  transform: scale(1.08);
  box-shadow: 0 0 16px rgba(244, 114, 182, 0.7);
}

.music-vol-group {
  display: flex;
  align-items: center;
  gap: 0.4rem;
}

.btn-pinwheel-music-mute {
  background: transparent;
  border: none;
  color: #fbcfe8;
  font-size: 0.95rem;
  cursor: pointer;
  padding: 0 2px;
  transition: transform 0.2s ease;
}

.btn-pinwheel-music-mute:hover {
  transform: scale(1.15);
}

.gazebo-vol-slider {
  width: 65px;
  height: 4px;
  accent-color: #f472b6;
  cursor: pointer;
}

/* ==========================================================================
   3. FOUR CENTRAL ACTIVITY CARDS (GLASSMORPHISM)
   ========================================================================== */

.pinwheel-gazebo-center-stage {
  position: relative;
  z-index: 10;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 1rem 2rem;
  pointer-events: auto;
}

.pinwheel-gazebo-cards-grid {
  display: grid;
  grid-template-columns: repeat(4, 230px);
  gap: 1.5rem;
  max-width: 1040px;
  margin: 0 auto;
}

.pinwheel-gazebo-card {
  position: relative;
  background: rgba(26, 14, 48, 0.65);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  border: 1.5px solid rgba(244, 114, 182, 0.35);
  border-radius: 20px;
  padding: 1.5rem 1.15rem;
  text-align: center;
  cursor: pointer;
  transition: all 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.45), inset 0 1px 0 rgba(255, 255, 255, 0.1);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.pinwheel-gazebo-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 45%;
  background: linear-gradient(180deg, rgba(244, 114, 182, 0.15) 0%, transparent 100%);
  pointer-events: none;
  border-radius: 20px 20px 0 0;
}

.pinwheel-gazebo-card:hover,
.pinwheel-gazebo-card:focus-visible {
  transform: translateY(-8px) scale(1.03);
  border-color: #f472b6;
  background: rgba(38, 20, 68, 0.75);
  box-shadow: 0 16px 40px rgba(244, 114, 182, 0.35), 0 0 24px rgba(192, 132, 252, 0.3);
  outline: none;
}

.card-icon-halo {
  width: 58px;
  height: 58px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.85rem;
  margin-bottom: 0.9rem;
  background: radial-gradient(circle, rgba(244, 114, 182, 0.28) 0%, rgba(168, 85, 247, 0.12) 70%, transparent 100%);
  border: 1px solid rgba(244, 114, 182, 0.45);
  box-shadow: 0 0 18px rgba(244, 114, 182, 0.35);
  transition: all 0.3s ease;
}

.pinwheel-gazebo-card:hover .card-icon-halo {
  transform: scale(1.12);
  box-shadow: 0 0 25px rgba(244, 114, 182, 0.6);
  border-color: #f472b6;
}

.pinwheel-gazebo-card h3 {
  margin: 0 0 0.45rem 0;
  font-size: 1.08rem;
  font-weight: 800;
  color: #ffffff;
  letter-spacing: 0.02em;
  text-shadow: 0 2px 10px rgba(0, 0, 0, 0.5);
}

.pinwheel-gazebo-card p {
  margin: 0;
  font-size: 0.76rem;
  line-height: 1.45;
  color: #fce7f3;
  opacity: 0.9;
}

/* ==========================================================================
   4. BOTTOM BAR & BADGES
   ========================================================================== */

.pinwheel-gazebo-bottom-bar {
  position: relative;
  z-index: 10;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 1.25rem 2rem;
  pointer-events: auto;
}

/* Personal Quote Panel (Bottom Left) */
.pinwheel-gazebo-quote-card {
  max-width: 480px;
  padding: 0.65rem 1.15rem;
  background: rgba(26, 14, 46, 0.65);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border: 1px solid rgba(244, 114, 182, 0.3);
  border-radius: 14px;
  box-shadow: 0 6px 20px rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  gap: 0.75rem;
}

.quote-star-icon {
  font-size: 1.15rem;
  color: #f472b6;
  filter: drop-shadow(0 0 8px rgba(244, 114, 182, 0.8));
}

.quote-text-wrap {
  display: flex;
  flex-direction: column;
}

.quote-phrase {
  font-size: 0.78rem;
  font-style: italic;
  color: #ffffff;
  margin: 0;
  line-height: 1.4;
}

.quote-author {
  font-size: 0.68rem;
  font-weight: 700;
  color: #e9d5ff;
  letter-spacing: 0.04em;
  margin-top: 2px;
}

/* Table Tea Indicator (Bottom Right) */
.pinwheel-gazebo-table-tea-indicator {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  padding: 0.55rem 1.15rem;
  background: rgba(26, 14, 46, 0.65);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border: 1px solid rgba(244, 114, 182, 0.3);
  border-radius: 999px;
  color: #fce7f3;
  font-size: 0.8rem;
  font-weight: 700;
  box-shadow: 0 6px 20px rgba(0, 0, 0, 0.45);
  cursor: pointer;
  transition: all 0.25s ease;
}

.pinwheel-gazebo-table-tea-indicator:hover {
  border-color: #f472b6;
  background: rgba(48, 22, 85, 0.75);
  transform: translateY(-2px);
  box-shadow: 0 0 16px rgba(244, 114, 182, 0.35);
}

/* ==========================================================================
   5. GAZEBO MODAL DIALOG CONTAINER
   ========================================================================== */

.pinwheel-gazebo-modal-backdrop {
  position: fixed;
  inset: 0;
  z-index: 100;
  background: rgba(10, 5, 20, 0.75);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  display: none;
  align-items: center;
  justify-content: center;
  padding: 1.5rem;
  box-sizing: border-box;
}

.pinwheel-gazebo-modal-backdrop.active {
  display: flex;
}

.pinwheel-gazebo-modal-dialog {
  width: 100%;
  max-width: 680px;
  max-height: 85vh;
  background: linear-gradient(135deg, rgba(32, 16, 58, 0.95), rgba(18, 10, 34, 0.95));
  border: 1.5px solid rgba(244, 114, 182, 0.45);
  border-radius: 24px;
  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.65), 0 0 30px rgba(244, 114, 182, 0.25);
  display: flex;
  flex-direction: column;
  overflow: hidden;
  animation: gazeboModalPop 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
}

@keyframes gazeboModalPop {
  0% { transform: scale(0.92); opacity: 0; }
  100% { transform: scale(1); opacity: 1; }
}

.pinwheel-gazebo-modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 1.25rem 1.6rem;
  border-bottom: 1px solid rgba(244, 114, 182, 0.25);
  background: rgba(244, 114, 182, 0.08);
}

.modal-header-meta {
  display: flex;
  align-items: center;
  gap: 0.85rem;
}

.modal-header-icon {
  font-size: 1.85rem;
  filter: drop-shadow(0 0 10px rgba(244, 114, 182, 0.6));
}

.pinwheel-gazebo-modal-header h2 {
  margin: 0;
  font-size: 1.18rem;
  font-weight: 800;
  color: #ffffff;
}

.pinwheel-gazebo-modal-header p {
  margin: 0;
  font-size: 0.78rem;
  color: #fbcfe8;
}

.btn-pinwheel-gazebo-modal-close {
  width: 34px;
  height: 34px;
  border-radius: 50%;
  border: 1px solid rgba(244, 114, 182, 0.4);
  background: rgba(255, 255, 255, 0.08);
  color: #ffffff;
  font-size: 1rem;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
}

.btn-pinwheel-gazebo-modal-close:hover {
  background: rgba(239, 68, 68, 0.3);
  border-color: #ef4444;
  transform: rotate(90deg);
}

.pinwheel-gazebo-modal-body {
  padding: 1.5rem 1.6rem;
  overflow-y: auto;
  flex: 1;
}

/* ==========================================================================
   6. TEA TIME MODAL VIEW
   ========================================================================== */

.tea-time-view {
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
}

.tea-cup-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 1.5rem 1rem;
  background: rgba(18, 10, 34, 0.6);
  border-radius: 18px;
  border: 1px solid rgba(244, 114, 182, 0.25);
  position: relative;
}

.tea-steam-anim {
  font-size: 1.5rem;
  animation: steamRise 2s infinite ease-out;
  margin-bottom: -5px;
}

@keyframes steamRise {
  0% { transform: translateY(6px); opacity: 0.2; }
  50% { opacity: 0.9; }
  100% { transform: translateY(-12px); opacity: 0; }
}

.tea-cup-visual {
  font-size: 3.5rem;
  filter: drop-shadow(0 0 16px rgba(244, 114, 182, 0.5));
}

.tea-hero-title {
  font-size: 1.15rem;
  font-weight: 800;
  color: #ffffff;
  margin: 0.5rem 0 0.2rem 0;
}

.tea-hero-desc {
  font-size: 0.82rem;
  color: #fce7f3;
  text-align: center;
  max-width: 480px;
  line-height: 1.45;
  margin: 0;
}

.tea-selection-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1rem;
}

.tea-option-card {
  background: rgba(26, 14, 48, 0.65);
  border: 1.5px solid rgba(244, 114, 182, 0.25);
  border-radius: 14px;
  padding: 1rem 0.85rem;
  text-align: center;
  cursor: pointer;
  transition: all 0.25s ease;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.tea-option-card:hover {
  border-color: #f472b6;
  background: rgba(48, 22, 85, 0.7);
  transform: translateY(-3px);
}

.tea-option-card.selected {
  border-color: #f472b6;
  background: rgba(244, 114, 182, 0.2);
  box-shadow: 0 0 18px rgba(244, 114, 182, 0.35);
}

.tea-opt-icon {
  font-size: 2rem;
  margin-bottom: 0.45rem;
}

.tea-opt-name {
  font-size: 0.86rem;
  font-weight: 800;
  color: #ffffff;
  margin-bottom: 0.35rem;
}

.tea-opt-desc {
  font-size: 0.72rem;
  color: #cbd5e1;
  line-height: 1.35;
  margin-bottom: 0.65rem;
}

.tea-serving-badge {
  font-size: 0.68rem;
  font-weight: 700;
  color: #f472b6;
  background: rgba(244, 114, 182, 0.15);
  padding: 2px 8px;
  border-radius: 999px;
  border: 1px solid rgba(244, 114, 182, 0.4);
}

/* ==========================================================================
   7. LITTLE LIBRARY MODAL VIEW & READER
   ========================================================================== */

.library-view {
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
}

.library-stories-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
  gap: 1rem;
}

.library-story-card {
  background: rgba(26, 14, 48, 0.65);
  border: 1px solid rgba(244, 114, 182, 0.25);
  border-radius: 14px;
  padding: 1.15rem;
  cursor: pointer;
  transition: all 0.25s ease;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.library-story-card:hover {
  border-color: #f472b6;
  background: rgba(48, 22, 85, 0.7);
  transform: translateY(-3px);
  box-shadow: 0 6px 20px rgba(0, 0, 0, 0.35);
}

.story-card-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 0.5rem;
}

.story-char-badge {
  font-size: 0.68rem;
  font-weight: 800;
  padding: 2px 8px;
  border-radius: 999px;
  background: rgba(244, 114, 182, 0.2);
  color: #fbcfe8;
  border: 1px solid rgba(244, 114, 182, 0.4);
}

.story-prog-badge {
  font-size: 0.68rem;
  color: #a7f3d0;
  font-weight: 700;
}

.story-card-title {
  font-size: 0.98rem;
  font-weight: 800;
  color: #ffffff;
  margin: 0 0 0.35rem 0;
}

.story-card-summary {
  font-size: 0.76rem;
  color: #cbd5e1;
  line-height: 1.4;
  margin: 0 0 0.85rem 0;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.btn-read-story {
  width: 100%;
  padding: 0.55rem;
  background: linear-gradient(135deg, #f472b6, #a855f7);
  color: #ffffff;
  border: none;
  border-radius: 10px;
  font-weight: 800;
  font-size: 0.8rem;
  cursor: pointer;
  transition: all 0.2s ease;
}

.btn-read-story:hover {
  box-shadow: 0 0 16px rgba(244, 114, 182, 0.5);
}

/* Reader Container */
.gazebo-reader-container {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.reader-nav-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 0.75rem;
  border-bottom: 1px solid rgba(244, 114, 182, 0.2);
}

.btn-reader-back {
  background: rgba(255, 255, 255, 0.08);
  border: 1px solid rgba(244, 114, 182, 0.35);
  color: #fce7f3;
  padding: 0.4rem 0.85rem;
  border-radius: 8px;
  font-size: 0.78rem;
  font-weight: 700;
  cursor: pointer;
  transition: all 0.2s ease;
}

.btn-reader-back:hover {
  background: rgba(244, 114, 182, 0.3);
  color: #ffffff;
}

.reader-content-sheet {
  background: rgba(18, 10, 34, 0.65);
  border: 1px solid rgba(244, 114, 182, 0.25);
  border-radius: 16px;
  padding: 1.5rem;
  color: #f8fafc;
  line-height: 1.75;
  min-height: 240px;
  white-space: pre-wrap;
  font-family: 'Plus Jakarta Sans', Georgia, serif;
}

.reader-pager-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 0.75rem;
  border-top: 1px solid rgba(244, 114, 182, 0.2);
}

.btn-reader-page {
  background: rgba(244, 114, 182, 0.2);
  border: 1px solid #f472b6;
  color: #ffffff;
  padding: 0.5rem 1.15rem;
  border-radius: 10px;
  font-weight: 700;
  font-size: 0.8rem;
  cursor: pointer;
  transition: all 0.2s ease;
}

.btn-reader-page:disabled {
  opacity: 0.4;
  cursor: not-allowed;
  border-color: rgba(255, 255, 255, 0.2);
}

.btn-reader-page:hover:not(:disabled) {
  background: #f472b6;
  box-shadow: 0 0 16px rgba(244, 114, 182, 0.4);
}

/* ==========================================================================
   8. MEMORY JOURNAL MODAL VIEW
   ========================================================================== */

.journal-view {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.journal-subnav {
  display: flex;
  gap: 0.75rem;
  margin-bottom: 0.5rem;
}

.btn-journal-tab {
  flex: 1;
  padding: 0.55rem;
  border-radius: 10px;
  background: rgba(255, 255, 255, 0.08);
  border: 1px solid rgba(244, 114, 182, 0.3);
  color: #fce7f3;
  font-weight: 700;
  font-size: 0.82rem;
  cursor: pointer;
  transition: all 0.2s ease;
}

.btn-journal-tab.active {
  background: linear-gradient(135deg, #f472b6, #a855f7);
  color: #ffffff;
  border-color: #f472b6;
  box-shadow: 0 4px 14px rgba(244, 114, 182, 0.35);
}

.journal-entries-list {
  display: flex;
  flex-direction: column;
  gap: 0.85rem;
}

.journal-entry-card {
  background: rgba(26, 14, 48, 0.65);
  border: 1px solid rgba(244, 114, 182, 0.25);
  border-radius: 14px;
  padding: 1rem 1.25rem;
  cursor: pointer;
  transition: all 0.25s ease;
}

.journal-entry-card:hover {
  border-color: #f472b6;
  background: rgba(48, 22, 85, 0.7);
  transform: translateY(-2px);
}

.entry-header-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 0.45rem;
}

.entry-title {
  font-size: 0.96rem;
  font-weight: 800;
  color: #ffffff;
  margin: 0;
}

.entry-mood-pill {
  font-size: 0.72rem;
  font-weight: 700;
  color: #f472b6;
  background: rgba(244, 114, 182, 0.15);
  padding: 2px 8px;
  border-radius: 999px;
  border: 1px solid rgba(244, 114, 182, 0.35);
}

.entry-snippet {
  font-size: 0.78rem;
  color: #cbd5e1;
  line-height: 1.45;
  margin: 0 0 0.5rem 0;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.entry-date {
  font-size: 0.7rem;
  color: #a855f7;
  font-weight: 600;
}

/* Journal Composer Form */
.journal-form-group {
  display: flex;
  flex-direction: column;
  gap: 0.4rem;
  margin-bottom: 0.85rem;
}

.journal-form-group label {
  font-size: 0.78rem;
  font-weight: 700;
  color: #fce7f3;
}

.journal-input-text {
  background: rgba(18, 10, 34, 0.7);
  border: 1px solid rgba(244, 114, 182, 0.35);
  border-radius: 10px;
  padding: 0.65rem 0.85rem;
  color: #ffffff;
  font-size: 0.86rem;
  outline: none;
  font-family: inherit;
}

.journal-input-text:focus {
  border-color: #f472b6;
  box-shadow: 0 0 12px rgba(244, 114, 182, 0.3);
}

.journal-mood-select {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
}

.mood-chip-btn {
  background: rgba(255, 255, 255, 0.08);
  border: 1px solid rgba(244, 114, 182, 0.3);
  color: #fce7f3;
  padding: 0.35rem 0.75rem;
  border-radius: 999px;
  font-size: 0.74rem;
  cursor: pointer;
  transition: all 0.2s ease;
}

.mood-chip-btn.active {
  background: #f472b6;
  color: #ffffff;
  border-color: #f472b6;
}

.journal-textarea {
  background: rgba(18, 10, 34, 0.7);
  border: 1px solid rgba(244, 114, 182, 0.35);
  border-radius: 12px;
  padding: 0.85rem;
  color: #ffffff;
  font-size: 0.86rem;
  line-height: 1.5;
  min-height: 130px;
  resize: vertical;
  outline: none;
  font-family: inherit;
}

.journal-textarea:focus {
  border-color: #f472b6;
  box-shadow: 0 0 12px rgba(244, 114, 182, 0.3);
}

.journal-form-actions {
  display: flex;
  gap: 0.75rem;
  margin-top: 0.75rem;
}

.btn-journal-action {
  flex: 1;
  padding: 0.65rem;
  border-radius: 10px;
  font-weight: 800;
  font-size: 0.85rem;
  cursor: pointer;
  transition: all 0.2s ease;
  border: none;
}

.btn-journal-action.save {
  background: linear-gradient(135deg, #f472b6, #a855f7);
  color: #ffffff;
}

.btn-journal-action.cancel {
  background: rgba(255, 255, 255, 0.1);
  color: #fce7f3;
}

/* ==========================================================================
   9. QUIET MOMENT MODAL VIEW
   ========================================================================== */

.quiet-moment-view {
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
}

.quiet-ambient-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1rem;
}

.quiet-ambient-card {
  background: rgba(26, 14, 48, 0.65);
  border: 1.5px solid rgba(244, 114, 182, 0.25);
  border-radius: 16px;
  padding: 1.25rem;
  display: flex;
  flex-direction: column;
  gap: 0.65rem;
  transition: all 0.25s ease;
}

.quiet-ambient-card.active {
  border-color: #f472b6;
  background: rgba(48, 22, 85, 0.8);
  box-shadow: 0 0 20px rgba(244, 114, 182, 0.35);
}

.ambient-card-header {
  display: flex;
  align-items: center;
  gap: 0.75rem;
}

.ambient-icon {
  font-size: 2rem;
}

.ambient-meta h4 {
  margin: 0;
  font-size: 0.96rem;
  font-weight: 800;
  color: #ffffff;
}

.ambient-meta p {
  margin: 0;
  font-size: 0.74rem;
  color: #cbd5e1;
  line-height: 1.35;
}

.ambient-controls-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 0.25rem;
}

.btn-ambient-toggle {
  padding: 0.45rem 1.15rem;
  border-radius: 8px;
  font-weight: 800;
  font-size: 0.78rem;
  cursor: pointer;
  border: 1px solid #f472b6;
  background: rgba(244, 114, 182, 0.2);
  color: #ffffff;
  transition: all 0.2s ease;
}

.btn-ambient-toggle.playing {
  background: #f472b6;
  box-shadow: 0 0 14px rgba(244, 114, 182, 0.5);
}

.quiet-master-vol-card {
  background: rgba(18, 10, 34, 0.65);
  border: 1px solid rgba(244, 114, 182, 0.25);
  border-radius: 14px;
  padding: 1rem 1.25rem;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

/* ==========================================================================
   10. RESPONSIVE DESIGN (TABLET & MOBILE)
   ========================================================================== */

@media (max-width: 1040px) {
  .pinwheel-gazebo-cards-grid {
    grid-template-columns: repeat(2, 220px);
  }
}

@media (max-width: 768px) {
  .pinwheel-gazebo-top-bar {
    padding: 1rem;
    flex-direction: column;
    gap: 0.75rem;
  }
  .pinwheel-gazebo-music-pill {
    width: 100%;
    justify-content: space-between;
    box-sizing: border-box;
  }
  .pinwheel-gazebo-cards-grid {
    grid-template-columns: repeat(2, 1fr);
    max-width: 100%;
    gap: 0.85rem;
  }
  .pinwheel-gazebo-card {
    padding: 1rem 0.65rem;
  }
  .pinwheel-gazebo-bottom-bar {
    padding: 1rem;
    flex-direction: column;
    gap: 0.75rem;
    align-items: stretch;
  }
  .pinwheel-gazebo-quote-card {
    max-width: 100%;
  }
  .tea-selection-grid {
    grid-template-columns: 1fr;
  }
  .quiet-ambient-grid {
    grid-template-columns: 1fr;
  }
}

