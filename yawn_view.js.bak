export function initYawnWorld(options = {}) {
  const { onShowToast, onTriggerSparkle } = options;

  const AKHIRA_UID = 'MT14ZHATNqe90frAeQ74QFk4iXs2';
  const STORAGE_KEY_ASTRONOMY = `olu_astronomy_log_${AKHIRA_UID}`;
  const STORAGE_KEY_LETTERS = `olu_yawn_mailbox_${AKHIRA_UID}`;

  const viewWorld = document.getElementById('view-yawn-world');
  const canvas = document.getElementById('yawn-magic-canvas');
  let ctx = canvas ? canvas.getContext('2d') : null;
  let animFrameId = null;
  let isViewActive = false;

  // Particle Pools
  let bubbles = [];
  let plankton = [];
  let jellyfishList = [];
  let astralWhale = null;

  // Audio Engine
  let audioCtx = null;
  let isPlaying = false;
  let currentTrackIdx = 0;
  let synthInterval = null;

  // Mood Today Controller State & Elements
  let currentYawnMoodKey = 'tenang';
  let isYawnMoodMusicActive = false;

  const yawnMoodContainer = document.getElementById('yawn-mood-container');
  const yawnMoodCard = document.getElementById('yawn-mood-card');
  const yawnMoodIcon = document.getElementById('yawn-mood-icon');
  const yawnMoodText = document.getElementById('yawn-mood-text');
  const yawnMoodSong = document.getElementById('yawn-mood-song');
  const btnToggleYawnMoodPicker = document.getElementById('btn-toggle-yawn-mood-picker');
  const yawnPickerCaret = document.getElementById('yawn-picker-caret');
  const yawnMoodOptionsBar = document.getElementById('yawn-mood-options-bar');
  const yawnMoodOptionPills = document.querySelectorAll('.yawn-mood-option-pill');
  const btnYawnMoodPlay = document.getElementById('btn-yawn-mood-play');
  const yawnMoodMusicIcon = document.getElementById('yawn-mood-music-icon');
  const btnYawnMoodHistory = document.getElementById('btn-yawn-mood-history');
  const yawnMoodHistoryModal = document.getElementById('yawn-mood-history-modal');
  const btnCloseYawnMoodHistory = document.getElementById('btn-close-yawn-mood-history');
  const yawnMoodHistoryList = document.getElementById('yawn-mood-history-list');

  const PLAYLIST = [
    { title: 'Astral Ocean Waves', sub: 'Bioluminescent Ambient • 72 BPM', roots: [261.63, 329.63, 392.0, 523.25] }, // C major 7th / Astral
    { title: 'Starlight Deep Abyss', sub: 'Deep Sea Harmonics • 64 BPM', roots: [220.0, 277.18, 329.63, 440.0] },    // A minor / Celestial
    { title: 'Bioluminescent Dream', sub: 'Crystal Tide Melody • 80 BPM', roots: [293.66, 369.99, 440.0, 587.33] }   // D major / Ethereal
  ];

  /* ==========================================================================
     1. WEB AUDIO API SYNTHESIZER (Underwater Astral Ambience)
     ========================================================================== */
  function getAudioContext() {
    if (!audioCtx) {
      const AudioContext = window.AudioContext || window.webkitAudioContext;
      if (AudioContext) {
        audioCtx = new AudioContext();
      }
    }
    if (audioCtx && audioCtx.state === 'suspended') {
      audioCtx.resume();
    }
    return audioCtx;
  }

  function playTone(freq, duration = 1.6, type = 'sine', gainLevel = 0.08) {
    const actx = getAudioContext();
    if (!actx) return;

    try {
      const osc = actx.createOscillator();
      const gain = actx.createGain();
      const filter = actx.createBiquadFilter();

      osc.type = type;
      osc.frequency.setValueAtTime(freq, actx.currentTime);

      // Lowpass filter for underwater warmth
      filter.type = 'lowpass';
      filter.frequency.setValueAtTime(1400, actx.currentTime);

      gain.gain.setValueAtTime(0.0001, actx.currentTime);
      gain.gain.exponentialRampToValueAtTime(gainLevel, actx.currentTime + 0.15);
      gain.gain.exponentialRampToValueAtTime(0.0001, actx.currentTime + duration);

      osc.connect(filter);
      filter.connect(gain);
      gain.connect(actx.destination);

      osc.start();
      osc.stop(actx.currentTime + duration);
    } catch {
      // Audio autoplay policy fail-safe
    }
  }

  function playUnderwaterChord() {
    const track = PLAYLIST[currentTrackIdx];
    if (!track) return;
    const notes = track.roots;
    notes.forEach((freq, idx) => {
      setTimeout(() => {
        if (isPlaying) {
          playTone(freq, 2.2 + idx * 0.4, 'sine', 0.05);
          // Harmonic overtone bell
          if (idx === 3) {
            playTone(freq * 1.5, 1.2, 'triangle', 0.02);
          }
        }
      }, idx * 320);
    });
  }

  function updateMusicUI() {
    const track = PLAYLIST[currentTrackIdx];
    const titleEl = document.getElementById('yawn-music-title');
    const subEl = document.getElementById('yawn-music-sub');
    const vinylEl = document.getElementById('yawn-music-vinyl');
    const playIconEl = document.getElementById('yawn-play-icon');

    if (titleEl) titleEl.textContent = track.title;
    if (subEl) subEl.textContent = track.sub;

    if (vinylEl) {
      if (isPlaying) vinylEl.classList.add('is-playing');
      else vinylEl.classList.remove('is-playing');
    }

    if (playIconEl) {
      playIconEl.textContent = isPlaying ? '⏸' : '▶';
    }
  }

  function toggleMusic() {
    isPlaying = !isPlaying;
    getAudioContext();

    if (isPlaying) {
      playUnderwaterChord();
      if (synthInterval) clearInterval(synthInterval);
      synthInterval = setInterval(() => {
        if (isPlaying) playUnderwaterChord();
      }, 3400);
    } else {
      if (synthInterval) clearInterval(synthInterval);
    }
    updateMusicUI();
  }

  function nextTrack() {
    currentTrackIdx = (currentTrackIdx + 1) % PLAYLIST.length;
    updateMusicUI();
    if (isPlaying) {
      playUnderwaterChord();
    }
  }

  function prevTrack() {
    currentTrackIdx = (currentTrackIdx - 1 + PLAYLIST.length) % PLAYLIST.length;
    updateMusicUI();
    if (isPlaying) {
      playUnderwaterChord();
    }
  }

  /* ==========================================================================
     2. CANVAS PARTICLE SYSTEM (Bubbles, Plankton, Jellyfish, Astral Whale)
     ========================================================================== */
  function resizeCanvas() {
    if (!canvas) return;
    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;
    initParticles();
  }

  function initParticles() {
    if (!canvas) return;
    const w = canvas.width;
    const h = canvas.height;

    // Bubbles
    bubbles = [];
    const bubbleCount = Math.floor(w / 45);
    for (let i = 0; i < bubbleCount; i++) {
      bubbles.push({
        x: Math.random() * w,
        y: Math.random() * h,
        radius: Math.random() * 4 + 1.5,
        speedY: Math.random() * 0.9 + 0.4,
        wobble: Math.random() * Math.PI * 2,
        wobbleSpeed: Math.random() * 0.03 + 0.015,
        alpha: Math.random() * 0.5 + 0.25
      });
    }

    // Plankton (Stardust)
    plankton = [];
    const planktonCount = Math.floor(w / 25);
    for (let i = 0; i < planktonCount; i++) {
      plankton.push({
        x: Math.random() * w,
        y: Math.random() * h,
        radius: Math.random() * 1.8 + 0.6,
        speedY: -(Math.random() * 0.3 + 0.1),
        speedX: (Math.random() - 0.5) * 0.3,
        pulse: Math.random() * Math.PI,
        pulseSpeed: Math.random() * 0.04 + 0.02,
        color: Math.random() > 0.5 ? '125, 211, 252' : '192, 132, 252'
      });
    }

    // Jellyfish
    jellyfishList = [];
    for (let i = 0; i < 4; i++) {
      jellyfishList.push({
        x: (w * (i + 1)) / 5 + (Math.random() - 0.5) * 80,
        y: h * 0.4 + Math.random() * (h * 0.5),
        size: Math.random() * 14 + 18,
        pulse: Math.random() * Math.PI * 2,
        speedY: -(Math.random() * 0.4 + 0.25)
      });
    }

    // Astral Whale
    astralWhale = {
      x: -300,
      y: h * 0.16,
      speedX: 0.8,
      opacity: 0,
      active: false
    };
  }

  function drawParticles() {
    if (!ctx || !canvas || !isViewActive) return;

    ctx.clearRect(0, 0, canvas.width, canvas.height);
    const w = canvas.width;
    const h = canvas.height;

    // A. Draw Astral Whale Silhouette
    if (astralWhale) {
      if (!astralWhale.active && Math.random() < 0.002) {
        astralWhale.active = true;
        astralWhale.x = -240;
        astralWhale.y = h * (0.08 + Math.random() * 0.14);
      }
      if (astralWhale.active) {
        astralWhale.x += astralWhale.speedX;
        if (astralWhale.x > w + 260) {
          astralWhale.active = false;
        }

        // Draw luminous whale body
        ctx.save();
        ctx.beginPath();
        const wx = astralWhale.x;
        const wy = astralWhale.y;
        ctx.ellipse(wx, wy, 80, 24, -0.05, 0, Math.PI * 2);
        ctx.fillStyle = 'rgba(186, 230, 253, 0.15)';
        ctx.shadowColor = 'rgba(56, 189, 248, 0.8)';
        ctx.shadowBlur = 18;
        ctx.fill();

        // Tail fluke
        ctx.beginPath();
        ctx.moveTo(wx - 75, wy);
        ctx.lineTo(wx - 105, wy - 18);
        ctx.lineTo(wx - 95, wy);
        ctx.lineTo(wx - 105, wy + 18);
        ctx.closePath();
        ctx.fillStyle = 'rgba(186, 230, 253, 0.2)';
        ctx.fill();
        ctx.restore();
      }
    }

    // B. Draw Plankton
    for (const p of plankton) {
      p.x += p.speedX;
      p.y += p.speedY;
      p.pulse += p.pulseSpeed;

      if (p.y < 0) p.y = h;
      if (p.x < 0) p.x = w;
      if (p.x > w) p.x = 0;

      const alpha = (Math.sin(p.pulse) + 1) * 0.4 + 0.2;
      ctx.beginPath();
      ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
      ctx.fillStyle = `rgba(${p.color}, ${alpha})`;
      ctx.shadowColor = `rgba(${p.color}, 0.8)`;
      ctx.shadowBlur = 6;
      ctx.fill();
    }

    // C. Draw Jellyfish
    for (const j of jellyfishList) {
      j.pulse += 0.035;
      j.y += j.speedY;
      j.x += Math.sin(j.pulse * 0.5) * 0.35;

      if (j.y < -50) {
        j.y = h + 40;
        j.x = Math.random() * w;
      }

      ctx.save();
      const expand = 1 + Math.sin(j.pulse) * 0.15;
      const jw = j.size * expand;
      const jh = j.size * 0.75;

      // Bell cap
      ctx.beginPath();
      ctx.ellipse(j.x, j.y, jw, jh, 0, Math.PI, 0);
      ctx.fillStyle = 'rgba(192, 132, 252, 0.22)';
      ctx.shadowColor = 'rgba(56, 189, 248, 0.6)';
      ctx.shadowBlur = 12;
      ctx.fill();
      ctx.strokeStyle = 'rgba(224, 242, 254, 0.45)';
      ctx.lineWidth = 1;
      ctx.stroke();

      // Tentacles
      for (let t = -2; t <= 2; t++) {
        ctx.beginPath();
        ctx.moveTo(j.x + t * (jw * 0.35), j.y);
        const wave = Math.sin(j.pulse + t) * 6;
        ctx.quadraticCurveTo(j.x + t * (jw * 0.35) + wave, j.y + jh * 1.5, j.x + t * (jw * 0.35) - wave, j.y + jh * 2.8);
        ctx.strokeStyle = 'rgba(125, 211, 252, 0.3)';
        ctx.lineWidth = 1.2;
        ctx.stroke();
      }
      ctx.restore();
    }

    // D. Draw Bubbles
    for (const b of bubbles) {
      b.wobble += b.wobbleSpeed;
      b.x += Math.sin(b.wobble) * 0.5;
      b.y -= b.speedY;

      if (b.y < -20) {
        b.y = h + 20;
        b.x = Math.random() * w;
      }

      ctx.save();
      ctx.beginPath();
      ctx.arc(b.x, b.y, b.radius, 0, Math.PI * 2);
      ctx.strokeStyle = `rgba(186, 230, 253, ${b.alpha})`;
      ctx.lineWidth = 1.2;
      ctx.stroke();

      // Bubble highlight glint
      ctx.beginPath();
      ctx.arc(b.x - b.radius * 0.3, b.y - b.radius * 0.3, b.radius * 0.25, 0, Math.PI * 2);
      ctx.fillStyle = 'rgba(255, 255, 255, 0.7)';
      ctx.fill();
      ctx.restore();
    }

    animFrameId = requestAnimationFrame(drawParticles);
  }

  /* ==========================================================================
     3. MODAL MANAGEMENT & HOTSPOT WIRING
     ========================================================================== */
  function closeAllYawnModals() {
    document.querySelectorAll('.yawn-modal-overlay').forEach((m) => {
      m.classList.remove('active');
      m.setAttribute('aria-hidden', 'true');
    });
  }

  function openYawnModal(modalId) {
    closeAllYawnModals();
    const modal = document.getElementById(modalId);
    if (modal) {
      modal.classList.add('active');
      modal.setAttribute('aria-hidden', 'false');
    }
  }

  /* ==========================================================================
     4. ASTRONOMY OBSERVATORY INTERACTION (UID-Bound Log)
     ========================================================================== */
  const CONSTELLATIONS = [
    { name: 'Aquarius Astral', symbol: '♒', desc: 'Rasi pembawa aliran air kosmik abadi.' },
    { name: 'Whale of Cetus', symbol: '🐋', desc: 'Rasi sang paus bintang penjaga kedalaman laut.' },
    { name: 'Star Jellyfish', symbol: '🪼', desc: 'Rasi ubur-ubur bercahaya pembimbing pelaut mimpi.' },
    { name: 'Nebula Coralia', symbol: '🪸', desc: 'Awan nebula merah muda berbentuk terumbu karang kosmik.' }
  ];
  let currentConstellationIdx = 0;

  function updateConstellationUI() {
    const c = CONSTELLATIONS[currentConstellationIdx];
    const nameEl = document.getElementById('yawn-constellation-name');
    const symbolEl = document.getElementById('yawn-constellation-symbol');
    const descEl = document.getElementById('yawn-constellation-desc');

    if (nameEl) nameEl.textContent = c.name;
    if (symbolEl) symbolEl.textContent = c.symbol;
    if (descEl) descEl.textContent = c.desc;
  }

  function logAstronomyObservation() {
    const c = CONSTELLATIONS[currentConstellationIdx];
    try {
      const existing = JSON.parse(localStorage.getItem(STORAGE_KEY_ASTRONOMY) || '[]');
      const entry = {
        name: c.name,
        symbol: c.symbol,
        timestamp: Date.now(),
        dateStr: new Date().toLocaleDateString('id-ID', { hour: '2-digit', minute: '2-digit' })
      };
      existing.unshift(entry);
      localStorage.setItem(STORAGE_KEY_ASTRONOMY, JSON.stringify(existing));
      if (onShowToast) onShowToast(`✨ Pengamatan tercatat: ${c.name} telah disimpan ke Jurnal Astronomi!`);
      renderAstronomyCollection();
    } catch {
      // Storage fallback
    }
  }

  function renderAstronomyCollection() {
    const grid = document.getElementById('yawn-collection-astronomy-grid');
    if (!grid) return;
    try {
      const logs = JSON.parse(localStorage.getItem(STORAGE_KEY_ASTRONOMY) || '[]');
      if (logs.length === 0) {
        grid.innerHTML = '<p style="color:#94a3b8; font-size:0.8rem; font-style:italic;">Belum ada catatan astronomi. Gunakan teleskop di Observatory untuk mengamati rasi bintang!</p>';
        return;
      }
      grid.innerHTML = logs.slice(0, 6).map((item) => `
        <div class="yawn-artifact-item">
          <span class="yawn-artifact-icon">${item.symbol}</span>
          <div class="yawn-artifact-info">
            <h4>${item.name}</h4>
            <p>Diamati pada ${item.dateStr}</p>
          </div>
        </div>
      `).join('');
    } catch {
      grid.innerHTML = '';
    }
  }

  /* ==========================================================================
     5. MAILBOX INTERACTION (Shared Multi-Universe Kotak Pos)
     ========================================================================== */
  let yawnMailboxUnsub = null;

  function updateYawnMailboxBadge(unreadCount) {
    const badge = document.getElementById('yawn-mailbox-unread-badge');
    const btn = document.getElementById('btn-loc-yawn-mailbox') || document.querySelector('.btn-loc-yawn-mailbox');
    if (badge) {
      if (unreadCount > 0) {
        badge.textContent = unreadCount > 99 ? '99+' : unreadCount;
        badge.style.display = 'inline-block';
      } else {
        badge.style.display = 'none';
      }
    }
    if (btn) {
      btn.classList.toggle('has-unread', unreadCount > 0);
    }
  }

  function subscribeYawnMailboxUnread(uid) {
    if (typeof yawnMailboxUnsub === 'function') {
      try { yawnMailboxUnsub(); } catch (_) { }
      yawnMailboxUnsub = null;
    }
    const targetUid = uid || AKHIRA_UID;
    try {
      yawnMailboxUnsub = dbSubscribeLetters({ uid: targetUid }, (letters) => {
        const incoming = (letters || []).filter(l => l.recipientUid === targetUid);
        const unread = incoming.filter(l => !l.read).length;
        updateYawnMailboxBadge(unread);
      }, (err) => {
        console.warn('Notice subscribing YAWN mailbox unread:', err);
        dbFetchLetters({ uid: targetUid }).then(letters => {
          const incoming = (letters || []).filter(l => l.recipientUid === targetUid);
          const unread = incoming.filter(l => !l.read).length;
          updateYawnMailboxBadge(unread);
        }).catch(() => { });
      });
    } catch (e) {
      console.warn('Notice setting up YAWN mailbox unread listener:', e);
    }
  }

  function openSharedKotakPos() {
    closeAllYawnModals();
    if (typeof options.onOpenKotakPos === 'function') {
      options.onOpenKotakPos();
    } else if (window.ensureKotakPosController) {
      window.ensureKotakPosController().then(ctrl => {
        ctrl?.openKotakPos('yawn', 'akhira');
      });
    } else {
      import('./mailbox_view.js').then(({ initKotakPosView }) => {
        const ctrl = window.kotakPosController || initKotakPosView();
        ctrl?.openKotakPos('yawn', 'akhira');
      });
    }
  }

  let yawnStarMessagesUnsub = null;

  function updateYawnObservatoryBadge(unreadCount) {
    const badge = document.getElementById('yawn-observatory-unread-badge');
    const modalTag = document.getElementById('yawn-observatory-modal-unread-count');
    const btn = document.getElementById('btn-loc-yawn-observatory') || document.querySelector('.btn-loc-yawn-observatory');
    if (badge) {
      if (unreadCount > 0) {
        badge.textContent = unreadCount > 99 ? '99+' : unreadCount;
        badge.style.display = 'inline-block';
      } else {
        badge.style.display = 'none';
      }
    }
    if (modalTag) {
      modalTag.textContent = unreadCount > 0 ? `${unreadCount} Pesan Belum Dibaca` : '0 Pesan Belum Dibaca';
    }
    if (btn) {
      btn.classList.toggle('has-unread', unreadCount > 0);
    }
  }

  function subscribeYawnStarMessagesUnread(uid) {
    if (typeof yawnStarMessagesUnsub === 'function') {
      try { yawnStarMessagesUnsub(); } catch (_) { }
      yawnStarMessagesUnsub = null;
    }
    const targetUid = uid || AKHIRA_UID;
    try {
      yawnStarMessagesUnsub = dbSubscribeStarMessages({ uid: targetUid }, (stars) => {
        const incoming = (stars || []).filter(s => s.recipientUid === targetUid || s.recipientCharacter === 'akhira');
        const unread = incoming.filter(s => !s.read).length;
        updateYawnObservatoryBadge(unread);
      }, (err) => {
        console.warn('Notice subscribing YAWN star messages unread:', err);
        try {
          const cached = JSON.parse(localStorage.getItem(`olu_star_messages_${targetUid}`) || '[]');
          const incoming = (cached || []).filter(s => s.recipientUid === targetUid || s.recipientCharacter === 'akhira');
          const unread = incoming.filter(s => !s.read).length;
          updateYawnObservatoryBadge(unread);
        } catch (_) { }
      });
    } catch (e) {
      console.warn('Notice setting up YAWN star messages unread listener:', e);
    }
  }

  function openSharedStarMessages() {
    playTone(523.25, 0.6, 'sine', 0.15);
    closeAllYawnModals();
    if (viewWorld) {
      viewWorld.classList.remove('active');
      viewWorld.setAttribute('aria-hidden', 'true');
    }
    if (typeof options.onNavigateStarMessages === 'function') {
      options.onNavigateStarMessages('yawn');
    } else if (typeof window.starMessagesController?.openStarMessages === 'function') {
      window.starMessagesController.openStarMessages('yawn', 'akhira');
    } else if (typeof window.ensureStarMessagesController === 'function') {
      window.ensureStarMessagesController().then(ctrl => {
        if (ctrl && typeof ctrl.openStarMessages === 'function') {
          ctrl.openStarMessages('yawn', 'akhira');
        }
      });
    }
  }

  function renderMailboxLetters() {
    const listEl = document.getElementById('yawn-mailbox-letters-list');
    if (!listEl) return;
    try {
      const letters = JSON.parse(localStorage.getItem(STORAGE_KEY_LETTERS) || '[]');
      if (letters.length === 0) {
        listEl.innerHTML = `
          <div style="padding:14px; background:rgba(8,24,62,0.6); border-radius:12px; border:1px dashed rgba(125,211,252,0.3);">
            <h4 style="margin:0; font-size:0.86rem; color:#bae6fd;">✉ Sambutan Hangat dari Seluruh Universe</h4>
            <p style="margin:4px 0 0 0; font-size:0.75rem; color:#cbd5e1; line-height:1.4;">
              "Halo Akhira! Selamat datang di kota bawah laut astral YAWN. Bintang-bintang bawah laut bersinar menyambutmu."
            </p>
            <span style="font-size:0.68rem; color:#38bdf8; display:block; margin-top:6px;">Dari: Penduduk Our Little Universe</span>
          </div>
        `;
        return;
      }
      listEl.innerHTML = letters.map((l) => `
        <div style="padding:12px; background:rgba(8,24,62,0.6); border-radius:12px; border:1px solid rgba(125,211,252,0.3); margin-bottom:8px;">
          <h4 style="margin:0; font-size:0.85rem; color:#ffffff;">${l.title || 'Surat Astral'}</h4>
          <p style="margin:4px 0 0 0; font-size:0.75rem; color:#cbd5e1;">${l.body}</p>
          <span style="font-size:0.68rem; color:#38bdf8; display:block; margin-top:4px;">${l.dateStr}</span>
        </div>
      `).join('');
    } catch {
      // Ignored
    }
  }

  function sendAstralLetter() {
    const input = document.getElementById('yawn-input-letter-body');
    if (!input || !input.value.trim()) {
      if (onShowToast) onShowToast('⚠️ Tuliskan pesanmu sebelum mengirim!');
      return;
    }
    try {
      const existing = JSON.parse(localStorage.getItem(STORAGE_KEY_LETTERS) || '[]');
      existing.unshift({
        title: 'Surat Terkirim ke Samudra',
        body: input.value.trim(),
        dateStr: new Date().toLocaleDateString('id-ID', { hour: '2-digit', minute: '2-digit' })
      });
      localStorage.setItem(STORAGE_KEY_LETTERS, JSON.stringify(existing));
      input.value = '';
      if (onShowToast) onShowToast('💌 Surat astral berhasil dikirim dan dihanyutkan ke arus bintang!');
      renderMailboxLetters();
    } catch {
      // Storage fallback
    }
  }

  /* ==========================================================================
     5.5. MOOD TODAY CONTROLLER (AKHIRA — YAWN ⚡)
     ========================================================================== */
  function applyYawnMood(moodKey, saveToState = true, activeUser = null) {
    const moodData = YAWN_MOODS[moodKey] || YAWN_MOODS.tenang;
    currentYawnMoodKey = moodData.id;

    if (yawnMoodIcon) yawnMoodIcon.textContent = moodData.icon;
    if (yawnMoodText) yawnMoodText.textContent = moodData.label;
    if (yawnMoodSong) yawnMoodSong.textContent = moodData.songTitle;

    // Update active pill
    if (yawnMoodOptionPills && yawnMoodOptionPills.length > 0) {
      yawnMoodOptionPills.forEach((pill) => {
        const isCurrent = pill.getAttribute('data-mood') === moodData.id;
        pill.classList.toggle('active', isCurrent);
      });
    }

    // Sync with bottom music player info
    const bottomTitleEl = document.getElementById('yawn-music-title');
    const bottomSubEl = document.getElementById('yawn-music-sub');
    if (bottomTitleEl) bottomTitleEl.textContent = moodData.songTitle.replace(/♫/g, '').trim();
    if (bottomSubEl) bottomSubEl.textContent = `Mood: ${moodData.label} • ${moodData.songDesc.split('•')[0] || 'Astral Ocean'}`;

    if (saveToState) {
      const userUid = activeUser?.uid || AKHIRA_UID;
      try {
        localStorage.setItem(`olu_yawn_mood_${userUid}`, moodData.id);
      } catch (_) {}

      try {
        const todayStr = new Date().toISOString().split('T')[0];
        const timeStr = new Date().toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' });
        const rawHist = localStorage.getItem(`olu_yawn_mood_history_${userUid}`);
        let history = rawHist ? JSON.parse(rawHist) : [];
        if (!Array.isArray(history)) history = [];
        const entry = {
          date: todayStr,
          time: timeStr,
          mood: moodData.id,
          label: moodData.label,
          icon: moodData.icon,
          songTitle: moodData.songTitle,
          timestamp: Date.now()
        };
        // Update today's entry or add as newest
        history = [entry, ...history.filter((h) => h.date !== todayStr)];
        localStorage.setItem(`olu_yawn_mood_history_${userUid}`, JSON.stringify(history));
      } catch (err) {
        console.warn('Error saving YAWN mood history:', err);
      }

      if (onTriggerSparkle) {
        onTriggerSparkle(160, window.innerHeight - 80);
      }

      if (onShowToast) {
        onShowToast(
          isYawnMoodMusicActive
            ? `⚡ Mood hari ini: ${moodData.icon} ${moodData.label} · Memutar: ${moodData.songTitle} ♫`
            : `⚡ Mood hari ini: ${moodData.icon} ${moodData.label} · Rekomendasi lagu: ${moodData.songTitle} ♫`
        );
      }

      if (isYawnMoodMusicActive) {
        // Play mood track chord immediately
        playTone(moodData.roots[0], 1.8, 'sine', 0.08);
      }
    }
  }

  function restoreYawnMood(userUid = AKHIRA_UID) {
    let savedMood = null;
    try {
      savedMood = localStorage.getItem(`olu_yawn_mood_${userUid}`);
    } catch (_) {}
    applyYawnMood(savedMood || 'tenang', false);
  }

  function toggleYawnMoodPicker(forceOpen = null) {
    if (!yawnMoodOptionsBar) return;
    const isOpen = forceOpen !== null ? forceOpen : !yawnMoodOptionsBar.classList.contains('is-open');
    yawnMoodOptionsBar.classList.toggle('is-open', isOpen);
    if (btnToggleYawnMoodPicker) {
      btnToggleYawnMoodPicker.classList.toggle('is-active', isOpen);
    }
    if (isOpen && onTriggerSparkle) {
      onTriggerSparkle(180, window.innerHeight - 80);
    }
  }

  function renderYawnMoodHistory(userUid = AKHIRA_UID) {
    if (!yawnMoodHistoryList) return;
    let history = [];
    try {
      const raw = localStorage.getItem(`olu_yawn_mood_history_${userUid}`);
      if (raw) history = JSON.parse(raw);
    } catch (_) {}

    if (!Array.isArray(history) || history.length === 0) {
      yawnMoodHistoryList.innerHTML = `
        <div class="yawn-mood-history-empty">
          <span>🌊 Belum ada riwayat mood tercatat.<br>Pilih suasana hati hari ini di kartu Mood Today untuk menyimpannya.</span>
        </div>
      `;
      return;
    }

    yawnMoodHistoryList.innerHTML = history.map((item) => `
      <div class="yawn-mood-history-item">
        <div class="yawn-mood-history-left">
          <div class="yawn-mood-history-icon">${item.icon || '🌸'}</div>
          <div class="yawn-mood-history-info">
            <span class="yawn-mood-history-title">${item.label || item.mood}</span>
            <span class="yawn-mood-history-song">${item.songTitle || ''}</span>
          </div>
        </div>
        <span class="yawn-mood-history-date">${item.date || ''}</span>
      </div>
    `).join('');
  }

  function openYawnMoodHistory() {
    renderYawnMoodHistory(AKHIRA_UID);
    openYawnModal('yawn-mood-history-modal');
  }

  /* ==========================================================================
     6. WIRE ALL EVENT LISTENERS
     ========================================================================== */
  function wireEvents() {
    // 6 Hotspots on Artwork
    document.querySelector('.btn-loc-yawn-residence')?.addEventListener('click', () => {
      if (typeof options.onOpenResidence === 'function') {
        options.onOpenResidence();
      } else {
        openYawnModal('yawn-residence-modal');
      }
    });

    document.getElementById('btn-yawn-enter-palace')?.addEventListener('click', () => {
      closeAllYawnModals();
      if (typeof options.onOpenResidence === 'function') {
        options.onOpenResidence();
      }
    });

    document.querySelector('.btn-loc-yawn-observatory')?.addEventListener('click', () => {
      updateConstellationUI();
      openYawnModal('yawn-observatory-modal');
    });

    document.querySelector('.btn-loc-yawn-gazebo')?.addEventListener('click', () => {
      if (typeof options.onOpenGazebo === 'function') {
        options.onOpenGazebo();
      } else {
        openYawnModal('yawn-gazebo-modal');
      }
    });
    document.getElementById('btn-loc-yawn-gazebo')?.addEventListener('click', () => {
      if (typeof options.onOpenGazebo === 'function') {
        options.onOpenGazebo();
      } else {
        openYawnModal('yawn-gazebo-modal');
      }
    });

    document.querySelector('.btn-loc-yawn-cinema')?.addEventListener('click', () => {
      if (typeof options.onOpenCinema === 'function') {
        options.onOpenCinema();
      } else {
        openYawnModal('yawn-cinema-modal');
      }
    });
    document.getElementById('btn-loc-yawn-cinema')?.addEventListener('click', () => {
      if (typeof options.onOpenCinema === 'function') {
        options.onOpenCinema();
      } else {
        openYawnModal('yawn-cinema-modal');
      }
    });

    document.querySelector('.btn-loc-yawn-mailbox')?.addEventListener('click', () => {
      openSharedKotakPos();
    });

    // Observatory interactions
    document.getElementById('btn-yawn-cycle-constellation')?.addEventListener('click', () => {
      currentConstellationIdx = (currentConstellationIdx + 1) % CONSTELLATIONS.length;
      updateConstellationUI();
      playTone(659.25, 0.4, 'sine', 0.04);
    });

    document.getElementById('btn-yawn-log-constellation')?.addEventListener('click', () => {
      logAstronomyObservation();
      playTone(880.0, 0.6, 'triangle', 0.05);
    });

    document.getElementById('btn-yawn-open-starmessages')?.addEventListener('click', () => {
      openSharedStarMessages();
    });

    // Mailbox send button
    document.getElementById('btn-yawn-send-letter')?.addEventListener('click', () => {
      sendAstralLetter();
    });

    // Cinema seat reservation interaction
    document.getElementById('btn-yawn-cinema-reserve')?.addEventListener('click', () => {
      if (onShowToast) onShowToast('🎟 Kursi VIP Pearl Lounger berhasil dipesan untuk Akhira!');
      playTone(523.25, 0.5, 'sine', 0.04);
    });

    // Gazebo tea moment
    document.getElementById('btn-yawn-gazebo-tea')?.addEventListener('click', () => {
      if (onShowToast) onShowToast('🍵 Secangkir teh karang aromatik disajikan. Nikmati keheningan.');
      playTone(392.0, 0.6, 'sine', 0.04);
    });

    // Gallery & Collection
    document.getElementById('btn-yawn-gallery')?.addEventListener('click', () => {
      openYawnModal('yawn-gallery-modal');
    });

    document.getElementById('btn-yawn-collection')?.addEventListener('click', () => {
      renderAstronomyCollection();
      openYawnModal('yawn-collection-modal');
    });

    // Settings
    document.getElementById('btn-yawn-settings')?.addEventListener('click', () => {
      openYawnModal('yawn-settings-modal');
    });

    // Close buttons on all modals
    document.querySelectorAll('.yawn-modal-close-btn').forEach((btn) => {
      btn.addEventListener('click', closeAllYawnModals);
    });

    // Close on overlay backdrop click
    document.querySelectorAll('.yawn-modal-overlay').forEach((overlay) => {
      overlay.addEventListener('click', (e) => {
        if (e.target === overlay) closeAllYawnModals();
      });
    });

    // Music Player controls
    document.getElementById('btn-yawn-music-play')?.addEventListener('click', toggleMusic);
    document.getElementById('btn-yawn-music-next')?.addEventListener('click', nextTrack);
    document.getElementById('btn-yawn-music-prev')?.addEventListener('click', prevTrack);

    // Settings action buttons
    document.getElementById('btn-yawn-toggle-bgm')?.addEventListener('click', toggleMusic);

    document.getElementById('btn-yawn-reset-data')?.addEventListener('click', () => {
      localStorage.removeItem(STORAGE_KEY_ASTRONOMY);
      localStorage.removeItem(STORAGE_KEY_LETTERS);
      renderAstronomyCollection();
      renderMailboxLetters();
      if (onShowToast) onShowToast('🧹 Data pengamatan dan surat astral Akhira telah direset.');
    });

    // Top Navigation: Explore Universe & Story
    document.getElementById('btn-yawn-top-explore')?.addEventListener('click', () => {
      closeYawnWorld();
      if (typeof window.showUniversesView === 'function') {
        window.showUniversesView();
      } else {
        const univSection = document.getElementById('view-universes');
        if (univSection) {
          document.querySelectorAll('.view-section').forEach((v) => v.classList.remove('active'));
          univSection.classList.add('active');
        }
      }
    });

    document.getElementById('btn-yawn-top-story')?.addEventListener('click', () => {
      if (onShowToast) onShowToast('📖 Membuka lembaran kisah YAWN: Underwater Astral City...');
      closeYawnWorld();
      if (window.storiesController && typeof window.storiesController.openOurStories === 'function') {
        window.storiesController.openOurStories('view-yawn-world');
      } else {
        document.querySelectorAll('.view-section').forEach((v) => v.classList.remove('active'));
        const storiesSection = document.getElementById('view-our-stories');
        if (storiesSection) storiesSection.classList.add('active');
      }
    });

    // ==========================================================
    // MOOD TODAY EVENT LISTENERS (AKHIRA — YAWN ⚡)
    // ==========================================================
    if (btnToggleYawnMoodPicker) {
      btnToggleYawnMoodPicker.addEventListener('click', (e) => {
        e.stopPropagation();
        toggleYawnMoodPicker();
      });
    }

    if (yawnMoodText) {
      yawnMoodText.addEventListener('click', (e) => {
        e.stopPropagation();
        toggleYawnMoodPicker();
      });
    }

    if (yawnMoodOptionPills && yawnMoodOptionPills.length > 0) {
      yawnMoodOptionPills.forEach((pill) => {
        pill.addEventListener('click', (e) => {
          e.stopPropagation();
          const chosen = pill.getAttribute('data-mood');
          applyYawnMood(chosen, true);
          toggleYawnMoodPicker(false);
        });
      });
    }

    // Close mood options bar on outside click
    document.addEventListener('click', (e) => {
      if (yawnMoodContainer && !yawnMoodContainer.contains(e.target)) {
        toggleYawnMoodPicker(false);
      }
    });

    if (btnYawnMoodPlay) {
      btnYawnMoodPlay.addEventListener('click', (e) => {
        e.stopPropagation();
        isYawnMoodMusicActive = !isYawnMoodMusicActive;
        const moodData = YAWN_MOODS[currentYawnMoodKey] || YAWN_MOODS.tenang;
        if (yawnMoodMusicIcon) {
          yawnMoodMusicIcon.textContent = isYawnMoodMusicActive ? '⏸' : '▶';
        }
        const vinylEl = document.getElementById('yawn-music-vinyl');
        if (vinylEl) {
          vinylEl.classList.toggle('is-playing', isYawnMoodMusicActive);
        }
        if (onTriggerSparkle) {
          onTriggerSparkle(e.clientX || 120, e.clientY || window.innerHeight - 80);
        }
        if (isYawnMoodMusicActive) {
          getAudioContext();
          playTone(moodData.roots[0], 2.2, 'sine', 0.08);
        }
        if (onShowToast) {
          onShowToast(
            isYawnMoodMusicActive
              ? `♫ Memutar ${moodData.songTitle}: ${moodData.songDesc} ⚡`
              : '⏸ Alunan musik suasana YAWN dijeda ⚡'
          );
        }
      });
    }

    if (btnYawnMoodHistory) {
      btnYawnMoodHistory.addEventListener('click', (e) => {
        e.stopPropagation();
        openYawnMoodHistory();
      });
    }

    if (btnCloseYawnMoodHistory) {
      btnCloseYawnMoodHistory.addEventListener('click', closeAllYawnModals);
    }

    window.addEventListener('resize', resizeCanvas);
  }

  /* ==========================================================================
     7. LIFECYCLE (Open / Close)
     ========================================================================== */
  function openYawnWorld(user = null) {
    isViewActive = true;
    if (viewWorld) {
      viewWorld.classList.add('active');
      viewWorld.setAttribute('aria-hidden', 'false');
    }

    subscribeYawnMailboxUnread(user?.uid || AKHIRA_UID);
    subscribeYawnStarMessagesUnread(user?.uid || AKHIRA_UID);

    // Restore saved mood today for Akhira
    restoreYawnMood(user?.uid || AKHIRA_UID);
    toggleYawnMoodPicker(false);

    // Ensure Akhira avatar matches login card
    const avatarEl = document.getElementById('yawn-profile-avatar');
    if (avatarEl) {
      avatarEl.src = '/assets/card_akhira_hd.jpg';
    }

    resizeCanvas();
    updateMusicUI();
    if (!animFrameId) {
      animFrameId = requestAnimationFrame(drawParticles);
    }

    if (onShowToast) {
      onShowToast("Selamat datang di Akhira's Universe — YAWN ⚡ Underwater Astral City");
    }
  }

  function closeYawnWorld() {
    closeAllYawnModals();
    toggleYawnMoodPicker(false);
    if (typeof yawnMailboxUnsub === 'function') {
      try { yawnMailboxUnsub(); } catch (_) { }
      yawnMailboxUnsub = null;
    }
    if (typeof yawnStarMessagesUnsub === 'function') {
      try { yawnStarMessagesUnsub(); } catch (_) { }
      yawnStarMessagesUnsub = null;
    }
    isViewActive = false;
    if (viewWorld) {
      viewWorld.classList.remove('active');
      viewWorld.setAttribute('aria-hidden', 'true');
    }

    if (animFrameId) {
      cancelAnimationFrame(animFrameId);
      animFrameId = null;
    }

    if (isPlaying) {
      isPlaying = false;
      if (synthInterval) clearInterval(synthInterval);
      updateMusicUI();
    }
  }

  // Initialize events on instantiation
  wireEvents();

  return {
    openYawnWorld,
    closeYawnWorld,
    updateYawnMailboxBadge,
    subscribeYawnMailboxUnread,
    openSharedKotakPos
    openSharedKotakPos,
    updateYawnObservatoryBadge,
    subscribeYawnStarMessagesUnread,
    openSharedStarMessages,
    applyYawnMood,
    getCurrentYawnMood: () => currentYawnMoodKey,
    restoreYawnMood,
    toggleYawnMoodPicker,
    openYawnMoodHistory
  };
}

