.hot-profile-race-title {
  font-size: 0.75rem;
  color: #34d399;
  font-weight: 600;
  letter-spacing: 0.04em;
  margin: 0.15rem 0 0.25rem;
  text-shadow: 0 0 8px rgba(52, 211, 153, 0.6), 0 1px 3px rgba(0, 0, 0, 0.8);
}

.hot-profile-status-row {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  font-size: 0.68rem;
  color: #e2d4f8;
  text-shadow: 0 1px 3px rgba(0, 0, 0, 0.8);
