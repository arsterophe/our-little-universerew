}

.hot-back-universes-btn:hover {
  background: rgba(45, 20, 75, 0.85);
  border-color: rgba(192, 132, 252, 0.8);
  box-shadow: 0 6px 20px rgba(11, 7, 23, 0.7), 0 0 16px rgba(192, 132, 252, 0.45);
  transform: translateY(-1px);
  color: #ffffff;
}

.hot-back-arrow {
  font-size: 0.95rem;
  line-height: 1;
