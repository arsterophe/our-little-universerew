        ${meeting.description ? `<p style="font-size: 0.78rem; color: #cbd5e1; background: rgba(0,0,0,0.25); padding: 0.5rem 0.7rem; border-radius: 8px; line-height: 1.4;">${escapeHtml(meeting.description)}</p>` : ''}

