  function applyYawnMood(moodKey, saveToState = true, activeUser = null) {
    const moodData = YAWN_MOODS[moodKey] || YAWN_MOODS.tenang;
    currentYawnMoodKey = moodData.id;

    if (yawnMoodIcon) yawnMoodIcon.textContent = moodData.icon;
    if (yawnMoodText) yawnMoodText.textContent = moodData.label;
    if (yawnMoodSong) yawnMoodSong.textContent = moodData.songTitle;

    // Update active pill
    if (yawnMoodOptionPills && yawnMoodOptionPills.length > 0) {
      yawnMoodOptionPills.forEach((pill) => {
        const isCurrent = pill.getAttribute('data-mood') === moodData.id;
        pill.classList.toggle('active', isCurrent);
      });
    }

    // Sync with bottom music player info
    const bottomTitleEl = document.getElementById('yawn-music-title');
    const bottomSubEl = document.getElementById('yawn-music-sub');
    if (bottomTitleEl) bottomTitleEl.textContent = moodData.songTitle.replace(/♫/g, '').trim();
    if (bottomSubEl) bottomSubEl.textContent = `Mood: ${moodData.label} • ${moodData.songDesc.split('•')[0] || 'Astral Ocean'}`;

    if (saveToState) {
      const userUid = activeUser?.uid || AKHIRA_UID;
      try {
        localStorage.setItem(`olu_yawn_mood_${userUid}`, moodData.id);
      } catch (_) { }

      try {
        const todayStr = new Date().toISOString().split('T')[0];
        const timeStr = new Date().toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' });
        const rawHist = localStorage.getItem(`olu_yawn_mood_history_${userUid}`);
        let history = rawHist ? JSON.parse(rawHist) : [];
        if (!Array.isArray(history)) history = [];
        const entry = {
          date: todayStr,
          time: timeStr,
          mood: moodData.id,
          label: moodData.label,
          icon: moodData.icon,
          songTitle: moodData.songTitle,
          timestamp: Date.now()
        };
        // Update today's entry or add as newest
        history = [entry, ...history.filter((h) => h.date !== todayStr)];
        localStorage.setItem(`olu_yawn_mood_history_${userUid}`, JSON.stringify(history));
      } catch (err) {
        console.warn('Error saving YAWN mood history:', err);
      }

      if (onTriggerSparkle) {
        onTriggerSparkle(160, window.innerHeight - 80);
      }

      if (onShowToast) {
        onShowToast(
          isYawnMoodMusicActive
            ? `⚡ Mood hari ini: ${moodData.icon} ${moodData.label} · Memutar: ${moodData.songTitle} ♫`
            : `⚡ Mood hari ini: ${moodData.icon} ${moodData.label} · Rekomendasi lagu: ${moodData.songTitle} ♫`
        );
      }

      if (isYawnMoodMusicActive) {
        // Play mood track chord immediately
        playTone(moodData.roots[0], 1.8, 'sine', 0.08);
      }
    }
  }

