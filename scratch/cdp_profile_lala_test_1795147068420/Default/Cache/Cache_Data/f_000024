  padding: 4px 12px;
  border-radius: 999px;
  font-size: 0.78rem;
  font-weight: 700;
  color: #bfdbfe;
}

.pinwheel-specs-list {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.pinwheel-spec-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  font-size: 0.85rem;
  padding-bottom: 8px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
