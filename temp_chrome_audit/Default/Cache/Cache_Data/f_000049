  updateDatabaseStatus('syncing', 'Menyimpan kegiatan ke Cloud Firestore...', null, {
    category: 'WRITE_FIRESTORE',
    operation: 'setDoc',
    targetPath: `orbit_events/${eventData?.id || 'new'}`
