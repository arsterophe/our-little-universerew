/* ========================================================
   OUR LITTLE UNIVERSE — BEHIND THE WITCH
   A Secret Grimoire & Storybook for Nyanya (KIDULT)
   "The story behind the girl who learned to stand alone."
   ======================================================== */

/* Fullscreen Overlay Dialog */
.kidult-behind-overlay {
  position: fixed;
  inset: 0;
  width: 100vw;
  height: 100vh;
  z-index: 9999;
  display: none;
  background: radial-gradient(circle at 50% 15%, rgba(26, 16, 48, 0.98) 0%, rgba(15, 10, 32, 0.98) 50%, rgba(8, 4, 18, 0.99) 100%);
  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);
  color: #f8fafc;
  font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
  overflow: hidden;
  animation: witchBehindFadeIn 0.45s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

.kidult-behind-overlay.active {
  display: flex !important;
  flex-direction: column;
}

@keyframes witchBehindFadeIn {
  from {
    opacity: 0;
    transform: scale(0.985);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

/* Floating Magical Ambient Particles (Lavender, Herb Leaves, Candle Sparks, Starlight) */
.kidult-behind-particles {
  position: absolute;
  inset: 0;
  pointer-events: none;
  overflow: hidden;
  z-index: 1;
}

.kidult-behind-particles .particle {
  position: absolute;
  color: rgba(192, 132, 252, 0.45);
  font-size: 1.2rem;
  animation: floatWitchParticle 9s ease-in-out infinite alternate;
  user-select: none;
}

.kidult-behind-particles .p1 { top: 12%; left: 8%; animation-delay: 0s; font-size: 1.5rem; color: rgba(251, 191, 36, 0.65); text-shadow: 0 0 10px rgba(251, 191, 36, 0.5); }
.kidult-behind-particles .p2 { top: 25%; right: 9%; animation-delay: 1.8s; font-size: 1.1rem; color: rgba(244, 114, 182, 0.55); }
.kidult-behind-particles .p3 { bottom: 15%; left: 10%; animation-delay: 3.2s; font-size: 1.7rem; color: rgba(216, 180, 254, 0.5); }
.kidult-behind-particles .p4 { bottom: 22%; right: 14%; animation-delay: 4.8s; font-size: 1.3rem; color: rgba(253, 224, 71, 0.55); }
.kidult-behind-particles .p5 { top: 52%; left: 5%; animation-delay: 2.4s; font-size: 1.4rem; color: rgba(192, 132, 252, 0.5); }
.kidult-behind-particles .p6 { top: 62%; right: 7%; animation-delay: 3.9s; font-size: 1.2rem; color: rgba(251, 191, 36, 0.5); }

@keyframes floatWitchParticle {
  0% { transform: translateY(0) rotate(0deg); opacity: 0.35; }
  50% { transform: translateY(-24px) rotate(35deg); opacity: 0.85; }
  100% { transform: translateY(-48px) rotate(70deg); opacity: 0.35; }
}

/* Main Container */
.kidult-behind-container {
  position: relative;
  z-index: 5;
  width: 100%;
  max-width: 1080px;
  height: 100%;
  margin: 0 auto;
  padding: 18px 24px;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

/* Header Bar */
.kidult-behind-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 14px;
  border-bottom: 1px solid rgba(192, 132, 252, 0.24);
  gap: 16px;
  flex-shrink: 0;
}

.kidult-behind-back-btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: rgba(36, 20, 60, 0.85);
  border: 1px solid rgba(192, 132, 252, 0.4);
  color: #f1f5f9;
  padding: 8px 18px;
  border-radius: 999px;
  font-size: 0.85rem;
  font-weight: 700;
  cursor: pointer;
  transition: all 0.25s ease;
  backdrop-filter: blur(10px);
}

.kidult-behind-back-btn:hover {
  background: rgba(107, 33, 168, 0.9);
  border-color: #fde047;
  color: #ffffff;
  transform: translateX(-3px);
  box-shadow: 0 0 16px rgba(192, 132, 252, 0.55), 0 0 24px rgba(251, 191, 36, 0.3);
}

.kidult-behind-title-badge {
  display: flex;
  align-items: center;
  gap: 12px;
  text-align: center;
}

.witch-badge-icon {
  font-size: 1.8rem;
  filter: drop-shadow(0 0 10px rgba(192, 132, 252, 0.8)) drop-shadow(0 0 16px rgba(251, 191, 36, 0.5));
  animation: gentleBreathe 3s ease-in-out infinite alternate;
}

@keyframes gentleBreathe {
  0% { transform: scale(1); filter: drop-shadow(0 0 8px rgba(192, 132, 252, 0.7)); }
  100% { transform: scale(1.08); filter: drop-shadow(0 0 18px rgba(251, 191, 36, 0.85)); }
}

.witch-badge-tag {
  display: block;
  font-size: 0.65rem;
  font-weight: 800;
  letter-spacing: 0.16em;
  color: #facc15;
  text-transform: uppercase;
}

.witch-badge-title {
  margin: 2px 0 0 0;
  font-family: 'Cinzel', serif, Georgia;
  font-size: 1.35rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  color: #ffffff;
  text-shadow: 0 0 16px rgba(192, 132, 252, 0.7), 0 0 28px rgba(251, 191, 36, 0.4);
}

.kidult-behind-close-btn {
  background: transparent;
  border: 1px solid rgba(192, 132, 252, 0.35);
  color: #cbd5e1;
  width: 36px;
  height: 36px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.1rem;
  cursor: pointer;
  transition: all 0.2s ease;
}

.kidult-behind-close-btn:hover {
  background: rgba(255, 255, 255, 0.18);
  color: #ffffff;
  transform: scale(1.1);
  border-color: #fde047;
}

/* Chapter Stepper Tabs */
.kidult-behind-nav {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
  padding: 12px 0;
  flex-shrink: 0;
  flex-wrap: wrap;
}

.witch-behind-tab-btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: rgba(26, 16, 48, 0.65);
  border: 1px solid rgba(192, 132, 252, 0.28);
  color: #94a3b8;
  padding: 8px 16px;
  border-radius: 999px;
  font-size: 0.82rem;
  cursor: pointer;
  transition: all 0.25s ease;
}

.witch-behind-tab-btn .tab-num {
  font-weight: 800;
  color: #facc15;
  font-size: 0.72rem;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.witch-behind-tab-btn .tab-title {
  font-weight: 600;
}

.witch-behind-tab-btn:hover {
  background: rgba(58, 28, 98, 0.8);
  color: #f1f5f9;
  border-color: rgba(251, 191, 36, 0.6);
}

.witch-behind-tab-btn.active {
  background: linear-gradient(135deg, rgba(88, 28, 135, 0.95), rgba(46, 16, 101, 0.95));
  border-color: #facc15;
  color: #ffffff;
  box-shadow: 0 0 18px rgba(192, 132, 252, 0.5), 0 0 24px rgba(251, 191, 36, 0.35);
}

.witch-behind-tab-btn.active .tab-num {
  color: #fef08a;
}

/* Book Deck & Chapter Panels */
.kidult-behind-book-deck {
  flex: 1;
  position: relative;
  overflow: hidden;
  margin: 6px 0 12px 0;
  border-radius: 18px;
  background: rgba(18, 12, 32, 0.7);
  border: 1px solid rgba(192, 132, 252, 0.25);
  box-shadow: inset 0 0 35px rgba(0, 0, 0, 0.7), 0 12px 36px rgba(0, 0, 0, 0.5);
}

.witch-behind-chapter-panel {
  display: none;
  width: 100%;
  height: 100%;
  padding: 28px 32px;
  box-sizing: border-box;
  overflow-y: auto;
  scrollbar-width: thin;
  scrollbar-color: rgba(192, 132, 252, 0.4) transparent;
}

.witch-behind-chapter-panel.active {
  display: block;
  animation: witchPanelIn 0.35s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

@keyframes witchPanelIn {
  from {
    opacity: 0;
    transform: translateY(12px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* Page Header */
.kidult-behind-page-header {
  text-align: center;
  margin-bottom: 24px;
}

.witch-chapter-badge {
  display: inline-block;
  padding: 3px 12px;
  border-radius: 999px;
  background: rgba(147, 51, 234, 0.25);
  border: 1px solid rgba(251, 191, 36, 0.45);
  font-size: 0.68rem;
  font-weight: 800;
  letter-spacing: 0.15em;
  color: #facc15;
  text-transform: uppercase;
  margin-bottom: 8px;
}

.witch-chapter-main-title {
  margin: 0;
  font-family: 'Cinzel', serif, Georgia;
  font-size: 1.75rem;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 0.04em;
  text-shadow: 0 0 16px rgba(192, 132, 252, 0.65), 0 0 24px rgba(251, 191, 36, 0.4);
}

.witch-chapter-sub-title {
  margin: 6px 0 0 0;
  font-size: 0.95rem;
  font-style: italic;
  color: #cbd5e1;
  letter-spacing: 0.02em;
}

/* Two-column Content Grid */
.witch-chapter-grid {
  display: grid;
  grid-template-columns: 1.25fr 0.95fr;
  gap: 28px;
  align-items: start;
}

.witch-text-column {
  font-size: 0.95rem;
  line-height: 1.75;
  color: #e2e8f0;
}

.witch-journal-p {
  margin: 0 0 16px 0;
  text-align: justify;
}

.witch-journal-p.drop-cap::first-letter {
  float: left;
  font-family: 'Cinzel', serif, Georgia;
  font-size: 2.8rem;
  line-height: 0.85;
  padding-top: 4px;
  padding-right: 10px;
  padding-bottom: 2px;
  color: #facc15;
  text-shadow: 0 0 12px rgba(251, 191, 36, 0.6);
  font-weight: 700;
}

.witch-journal-highlight {
  margin: 18px 0;
  padding: 12px 18px;
  border-left: 3px solid #facc15;
  background: rgba(126, 34, 206, 0.22);
  border-radius: 0 10px 10px 0;
  font-weight: 600;
  color: #fef08a;
  font-style: italic;
}

.witch-journal-quote {
  margin: 20px 0 10px 0;
  padding: 14px 20px;
  background: linear-gradient(135deg, rgba(59, 7, 100, 0.4), rgba(30, 16, 58, 0.6));
  border: 1px solid rgba(251, 191, 36, 0.35);
  border-radius: 12px;
  font-style: italic;
  color: #fef9c3;
  text-align: center;
  font-size: 1rem;
  line-height: 1.6;
  box-shadow: 0 4px 18px rgba(0, 0, 0, 0.3);
}

/* Character Profile Card (Chapter I) */
.witch-char-profile-card {
  background: linear-gradient(145deg, rgba(30, 18, 56, 0.85), rgba(14, 8, 28, 0.95));
  border: 1px solid rgba(192, 132, 252, 0.4);
  border-radius: 16px;
  padding: 20px;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.5), inset 0 0 20px rgba(147, 51, 234, 0.15);
}

.witch-portrait-frame {
  position: relative;
  width: 100%;
  aspect-ratio: 4 / 4.5;
  max-height: 230px;
  border-radius: 12px;
  overflow: hidden;
  border: 1px solid rgba(251, 191, 36, 0.4);
  box-shadow: 0 6px 18px rgba(0, 0, 0, 0.6);
  margin-bottom: 14px;
}

.witch-portrait-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center 20%;
  transition: transform 0.4s ease;
}

.witch-char-profile-card:hover .witch-portrait-img {
  transform: scale(1.04);
}

.witch-moonlit-badge {
  position: absolute;
  bottom: 8px;
  left: 50%;
  transform: translateX(-50%);
  background: rgba(20, 12, 38, 0.92);
  border: 1px solid rgba(251, 191, 36, 0.6);
  color: #fef08a;
  padding: 4px 12px;
  border-radius: 999px;
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.05em;
  white-space: nowrap;
  backdrop-filter: blur(8px);
}

.witch-specs-list {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.witch-spec-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 0.82rem;
  padding: 5px 0;
  border-bottom: 1px solid rgba(192, 132, 252, 0.16);
}

.witch-spec-row:last-child {
  border-bottom: none;
}

.witch-spec-row .spec-label {
  color: #c084fc;
  font-weight: 600;
}

.witch-spec-row .spec-val {
  color: #f1f5f9;
  font-weight: 700;
  text-align: right;
  max-width: 65%;
}

/* Symbolic Stage Card (Chapter II) */
.witch-symbols-card {
  background: linear-gradient(145deg, rgba(28, 16, 52, 0.85), rgba(12, 7, 26, 0.95));
  border: 1px solid rgba(192, 132, 252, 0.35);
  border-radius: 16px;
  padding: 20px;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.5);
}

.witch-symbols-visual {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-bottom: 16px;
}

.witch-symbols-svg {
  filter: drop-shadow(0 0 14px rgba(192, 132, 252, 0.6)) drop-shadow(0 0 20px rgba(251, 191, 36, 0.4));
  animation: witchGlowPulse 4s ease-in-out infinite alternate;
}

@keyframes witchGlowPulse {
  0% { transform: scale(1); filter: drop-shadow(0 0 10px rgba(192, 132, 252, 0.5)); }
  100% { transform: scale(1.03); filter: drop-shadow(0 0 22px rgba(251, 191, 36, 0.8)); }
}

.witch-symbols-title {
  margin: 0 0 12px 0;
  font-size: 0.92rem;
  font-weight: 700;
  color: #facc15;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  text-align: center;
}

.witch-symbol-item {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  padding: 8px 0;
  border-bottom: 1px solid rgba(192, 132, 252, 0.14);
}

.witch-symbol-item:last-child {
  border-bottom: none;
}

.witch-symbol-icon {
  font-size: 1.3rem;
  line-height: 1;
  filter: drop-shadow(0 0 6px rgba(251, 191, 36, 0.6));
}

.witch-symbol-info strong {
  display: block;
  font-size: 0.82rem;
  color: #ffffff;
  margin-bottom: 2px;
}

.witch-symbol-info p {
  margin: 0;
  font-size: 0.76rem;
  color: #cbd5e1;
  line-height: 1.4;
}

/* Grimoire/Witch Parchment Letter (Chapter III) */
.behind-witch-parchment {
  max-width: 820px;
  margin: 0 auto;
  position: relative;
  background: linear-gradient(145deg, rgba(32, 22, 54, 0.92), rgba(18, 12, 34, 0.96));
  border: 1px solid rgba(251, 191, 36, 0.4);
  border-radius: 18px;
  padding: 36px 42px 42px 42px;
  box-shadow: 0 12px 32px rgba(0, 0, 0, 0.65), inset 0 0 32px rgba(107, 33, 168, 0.22);
}

.witch-wax-seal {
  position: absolute;
  top: -18px;
  right: 42px;
  width: 46px;
  height: 46px;
  background: radial-gradient(circle, #e11d48 0%, #9f1239 60%, #4c0519 100%);
  border: 2px solid #fef08a;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4px 16px rgba(225, 29, 72, 0.7), 0 0 12px rgba(251, 191, 36, 0.5);
  font-size: 1.35rem;
}

.witch-date-stamp {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 0.78rem;
  color: #facc15;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  margin-bottom: 22px;
  border-bottom: 1px solid rgba(251, 191, 36, 0.25);
  padding-bottom: 8px;
}

.witch-letter-salutation {
  font-family: 'Cinzel', serif, Georgia;
  font-size: 1.2rem;
  color: #fef08a;
  font-weight: 700;
  margin-bottom: 16px;
  text-shadow: 0 0 12px rgba(251, 191, 36, 0.4);
}

.witch-letter-body {
  font-size: 0.96rem;
  line-height: 1.85;
  color: #e2e8f0;
}

.witch-letter-body p {
  margin: 0 0 14px 0;
  text-align: justify;
}

.witch-letter-emphasis {
  font-style: italic;
  font-weight: 700;
  color: #fef08a;
  font-size: 1.05rem;
  margin: 16px 0;
  text-shadow: 0 0 10px rgba(251, 191, 36, 0.35);
}

.witch-letter-signoff {
  margin-top: 24px;
  text-align: right;
  font-style: italic;
  color: #cbd5e1;
  font-size: 0.95rem;
}

/* Epilogue (Chapter IV) */
.witch-epilogue-container {
  display: flex;
  flex-direction: column;
  gap: 28px;
  max-width: 920px;
  margin: 0 auto;
}

/* YouTube Player Card */
.witch-song-player-card {
  background: linear-gradient(145deg, rgba(28, 18, 54, 0.88), rgba(14, 8, 30, 0.96));
  border: 1px solid rgba(251, 191, 36, 0.4);
  border-radius: 18px;
  padding: 20px;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.65), 0 0 20px rgba(192, 132, 252, 0.2);
}

.witch-track-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14px;
  flex-wrap: wrap;
  gap: 10px;
}

.witch-track-left {
  display: flex;
  align-items: center;
  gap: 12px;
}

.witch-track-disc {
  font-size: 1.6rem;
  filter: drop-shadow(0 0 8px rgba(251, 191, 36, 0.7));
  animation: rotateWitchDisc 12s linear infinite;
}

@keyframes rotateWitchDisc {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.witch-track-title {
  display: block;
  font-weight: 800;
  font-size: 1rem;
  color: #ffffff;
  letter-spacing: 0.04em;
}

.witch-track-artist {
  display: block;
  font-size: 0.8rem;
  color: #facc15;
}

.witch-track-badge {
  background: rgba(147, 51, 234, 0.28);
  border: 1px solid rgba(251, 191, 36, 0.45);
  padding: 4px 12px;
  border-radius: 999px;
  font-size: 0.72rem;
  font-weight: 700;
  color: #fef08a;
}

.witch-youtube-box {
  position: relative;
  width: 100%;
  padding-bottom: 56.25%; /* 16:9 aspect ratio */
  height: 0;
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.75);
  background: #000000;
}

.witch-youtube-box iframe {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  border: none;
}

.witch-player-hint {
  margin: 12px 0 0 0;
  font-size: 0.8rem;
  color: #94a3b8;
  text-align: center;
  font-style: italic;
}

/* Song Meaning Card */
.witch-meaning-card {
  background: linear-gradient(145deg, rgba(26, 16, 50, 0.88), rgba(12, 8, 26, 0.96));
  border: 1px solid rgba(192, 132, 252, 0.35);
  border-radius: 18px;
  padding: 24px 28px;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.55);
}

.witch-meaning-header {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 16px;
  border-bottom: 1px solid rgba(192, 132, 252, 0.2);
  padding-bottom: 12px;
}

.witch-meaning-icon {
  font-size: 1.6rem;
  filter: drop-shadow(0 0 8px rgba(251, 191, 36, 0.7));
}

.witch-meaning-title {
  margin: 0;
  font-family: 'Cinzel', serif, Georgia;
  font-size: 1.2rem;
  font-weight: 700;
  color: #ffffff;
}

.witch-meaning-sub {
  margin: 2px 0 0 0;
  font-size: 0.76rem;
  color: #facc15;
}

.witch-meaning-body {
  font-size: 0.94rem;
  line-height: 1.75;
  color: #e2e8f0;
}

.witch-meaning-body p {
  margin: 0 0 14px 0;
  text-align: justify;
}

.witch-external-link {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  margin-top: 10px;
  padding: 8px 18px;
  background: rgba(88, 28, 135, 0.4);
  border: 1px solid rgba(251, 191, 36, 0.45);
  color: #fef08a;
  border-radius: 999px;
  font-size: 0.82rem;
  font-weight: 600;
  text-decoration: none;
  transition: all 0.2s ease;
}

.witch-external-link:hover {
  background: rgba(147, 51, 234, 0.65);
  border-color: #ffffff;
  color: #ffffff;
  transform: translateY(-2px);
  box-shadow: 0 4px 16px rgba(251, 191, 36, 0.5);
}

/* Closing Atmosphere & Quote */
.witch-closing-atmosphere {
  text-align: center;
  padding: 24px 20px 10px 20px;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.witch-closing-halo {
  margin-bottom: 16px;
  filter: drop-shadow(0 0 18px rgba(251, 191, 36, 0.8));
}

.witch-closing-quote-wrap {
  position: relative;
  max-width: 680px;
  margin: 0 auto;
}

.witch-quote-symbol-top,
.witch-quote-symbol-bottom {
  font-family: 'Cinzel', serif, Georgia;
  font-size: 2.2rem;
  color: rgba(251, 191, 36, 0.45);
  line-height: 1;
}

.witch-closing-quote {
  margin: 0;
  font-family: 'Cinzel', serif, Georgia;
  font-size: 1.15rem;
  line-height: 1.6;
  font-weight: 600;
  color: #ffffff;
  letter-spacing: 0.03em;
  text-shadow: 0 0 16px rgba(192, 132, 252, 0.65), 0 0 24px rgba(251, 191, 36, 0.4);
}

.witch-closing-author {
  margin-top: 14px;
  font-size: 0.85rem;
  font-weight: 700;
  color: #facc15;
  letter-spacing: 0.1em;
  text-transform: uppercase;
}

/* Bottom Navigation Bar between Chapters */
.kidult-behind-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 12px;
  border-top: 1px solid rgba(192, 132, 252, 0.24);
  gap: 16px;
  flex-shrink: 0;
}

.kidult-behind-nav-btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: rgba(36, 20, 60, 0.85);
  border: 1px solid rgba(192, 132, 252, 0.38);
  color: #f1f5f9;
  padding: 8px 20px;
  border-radius: 999px;
  font-size: 0.84rem;
  font-weight: 700;
  cursor: pointer;
  transition: all 0.25s ease;
}

.kidult-behind-nav-btn:hover:not(:disabled) {
  background: rgba(107, 33, 168, 0.9);
  border-color: #fde047;
  color: #ffffff;
  transform: translateY(-2px);
  box-shadow: 0 0 16px rgba(192, 132, 252, 0.5), 0 0 20px rgba(251, 191, 36, 0.4);
}

.kidult-behind-nav-btn:disabled {
  opacity: 0.35;
  cursor: not-allowed;
  transform: none;
}

.witch-chapter-indicators {
  display: flex;
  align-items: center;
  gap: 10px;
}

.witch-indicator-dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: rgba(192, 132, 252, 0.3);
  border: 1px solid rgba(251, 191, 36, 0.5);
  cursor: pointer;
  transition: all 0.25s ease;
  padding: 0;
}

.witch-indicator-dot:hover {
  background: rgba(251, 191, 36, 0.7);
  transform: scale(1.2);
}

.witch-indicator-dot.active {
  width: 28px;
  border-radius: 999px;
  background: linear-gradient(90deg, #facc15, #c084fc);
  border-color: #ffffff;
  box-shadow: 0 0 12px rgba(251, 191, 36, 0.85);
}

/* HUD Pill Button in KIDULT World */
.kidult-behind-pill {
  background: linear-gradient(135deg, rgba(38, 20, 64, 0.92), rgba(20, 12, 38, 0.95)) !important;
  border: 1.5px solid rgba(251, 191, 36, 0.55) !important;
  color: #f1f5f9 !important;
  display: inline-flex !important;
  align-items: center !important;
  gap: 8px !important;
  padding: 6px 14px !important;
  border-radius: 999px !important;
  cursor: pointer !important;
  transition: all 0.25s ease !important;
  backdrop-filter: blur(10px) !important;
  box-shadow: 0 4px 14px rgba(0, 0, 0, 0.4), 0 0 12px rgba(251, 191, 36, 0.25) !important;
}

.kidult-behind-pill:hover {
  background: linear-gradient(135deg, rgba(107, 33, 168, 0.95), rgba(46, 16, 101, 0.95)) !important;
  border-color: #fde047 !important;
  transform: translateY(-2px) !important;
  box-shadow: 0 0 18px rgba(192, 132, 252, 0.65), 0 0 24px rgba(251, 191, 36, 0.5) !important;
}

.kidult-behind-label {
  display: flex;
  flex-direction: column;
  text-align: left;
}

.kidult-behind-main {
  font-size: 0.75rem;
  font-weight: 800;
  letter-spacing: 0.08em;
  color: #ffffff;
  text-shadow: 0 0 8px rgba(251, 191, 36, 0.5);
}

.kidult-behind-sub {
  font-size: 0.62rem;
  font-weight: 500;
  color: #fde047;
  font-style: italic;
  max-width: 170px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* Responsive Rules */
@media (max-width: 960px) {
  .witch-chapter-grid {
    grid-template-columns: 1fr;
    gap: 20px;
  }
  .behind-witch-parchment {
    padding: 28px 24px;
  }
  .kidult-behind-container {
    padding: 14px 16px;
  }
  .witch-chapter-main-title {
    font-size: 1.45rem;
  }
}

@media (max-width: 640px) {
  .kidult-behind-header {
    flex-wrap: wrap;
  }
  .kidult-behind-title-badge {
    order: 3;
    width: 100%;
    justify-content: center;
  }
  .witch-behind-tab-btn {
    padding: 6px 10px;
    font-size: 0.75rem;
  }
  .witch-behind-chapter-panel {
    padding: 18px 14px;
  }
  .witch-closing-quote {
    font-size: 0.98rem;
  }
  .kidult-behind-footer {
    gap: 8px;
  }
  .kidult-behind-nav-btn {
    padding: 6px 14px;
    font-size: 0.76rem;
  }
  .kidult-behind-sub {
    display: none;
  }
}
