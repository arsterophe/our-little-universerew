  } else {
    if (fallbackImg) fallbackImg.style.display = 'none';
    if (placeholderEl) placeholderEl.style.display = 'flex';
  }

  updateCameraControlsUI();

  if (notify) {
    showPhotoboothToast('⏹️ Kamera dimatikan.');
  }
}

