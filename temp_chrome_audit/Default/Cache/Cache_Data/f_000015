/* ==========================================================================
   NEEDS GAUGES GRID (6 METERS)
   ========================================================================== */

.cat-needs-gauges-grid {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 10px;
}

.need-card {
  background: rgba(22, 11, 46, 0.65);
  border: 1px solid rgba(216, 180, 254, 0.2);
  border-radius: 12px;
  padding: 8px 10px;
}

.need-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 0.74rem;
  font-weight: 700;
  color: #e2e8f0;
  margin-bottom: 6px;
}

.need-val {
  color: #38bdf8;
  font-weight: 800;
}

.need-track {
  width: 100%;
  height: 8px;
  background: rgba(10, 5, 24, 0.8);
  border-radius: 999px;
  overflow: hidden;
}

.need-fill {
  height: 100%;
  border-radius: 999px;
