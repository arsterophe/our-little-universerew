/* ========================================================
   OUR LITTLE UNIVERSE — BEHIND THE SHADOW
   A Secret Journal — The Two Sides of Lele
   "The Angel I Show, The Devil I Hide."
   ======================================================== */

/* Fullscreen Overlay Dialog */
.shadow-behind-overlay {
  position: fixed;
  inset: 0;
  width: 100vw;
  height: 100vh;
  z-index: 9999;
  display: none;
  background: radial-gradient(circle at 50% 15%, rgba(18, 14, 38, 0.98) 0%, rgba(8, 9, 22, 0.98) 50%, rgba(3, 4, 12, 0.99) 100%);
  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);
  color: #f8fafc;
  font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
  overflow: hidden;
  animation: shadowBehindFadeIn 0.45s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

.shadow-behind-overlay.active {
  display: flex !important;
  flex-direction: column;
}

@keyframes shadowBehindFadeIn {
  from {
    opacity: 0;
    transform: scale(0.985);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

/* Floating Celestial Ambient Particles */
.shadow-behind-particles {
  position: absolute;
  inset: 0;
  pointer-events: none;
  overflow: hidden;
  z-index: 1;
}

.shadow-behind-particles .particle {
  position: absolute;
  color: rgba(167, 139, 250, 0.45);
  font-size: 1.2rem;
  animation: floatShadowParticle 9s ease-in-out infinite alternate;
  user-select: none;
}

.shadow-behind-particles .p1 { top: 10%; left: 7%; animation-delay: 0s; font-size: 1.5rem; color: rgba(199, 210, 254, 0.6); }
.shadow-behind-particles .p2 { top: 22%; right: 10%; animation-delay: 1.8s; font-size: 1.1rem; color: rgba(168, 85, 247, 0.5); }
.shadow-behind-particles .p3 { bottom: 16%; left: 12%; animation-delay: 3.2s; font-size: 1.7rem; color: rgba(129, 140, 248, 0.45); }
.shadow-behind-particles .p4 { bottom: 24%; right: 15%; animation-delay: 4.8s; font-size: 1.2rem; color: rgba(147, 197, 253, 0.55); }
.shadow-behind-particles .p5 { top: 48%; left: 4%; animation-delay: 2.4s; font-size: 1.4rem; color: rgba(238, 242, 255, 0.5); }
.shadow-behind-particles .p6 { top: 58%; right: 6%; animation-delay: 3.9s; font-size: 1.3rem; color: rgba(192, 132, 252, 0.4); }

@keyframes floatShadowParticle {
  0% { transform: translateY(0) rotate(0deg); opacity: 0.3; }
  50% { transform: translateY(-24px) rotate(40deg); opacity: 0.8; }
  100% { transform: translateY(-48px) rotate(80deg); opacity: 0.3; }
}

/* Main Container */
.shadow-behind-container {
  position: relative;
  z-index: 5;
  width: 100%;
  max-width: 1080px;
  height: 100%;
  margin: 0 auto;
  padding: 18px 24px;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

/* Header Bar */
.shadow-behind-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 14px;
  border-bottom: 1px solid rgba(167, 139, 250, 0.22);
  gap: 16px;
  flex-shrink: 0;
}

.shadow-behind-back-btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: rgba(28, 20, 52, 0.85);
  border: 1px solid rgba(167, 139, 250, 0.35);
  color: #f1f5f9;
  padding: 8px 18px;
  border-radius: 999px;
  font-size: 0.85rem;
  font-weight: 700;
  cursor: pointer;
  transition: all 0.25s ease;
  backdrop-filter: blur(10px);
}

.shadow-behind-back-btn:hover {
  background: rgba(76, 29, 149, 0.9);
  border-color: #cbd5e1;
  color: #ffffff;
  transform: translateX(-3px);
  box-shadow: 0 0 16px rgba(167, 139, 250, 0.5);
}

.shadow-behind-title-badge {
  display: flex;
  align-items: center;
  gap: 12px;
  text-align: center;
}

.shadow-badge-icon {
  font-size: 1.7rem;
  filter: drop-shadow(0 0 10px rgba(167, 139, 250, 0.75));
}

.shadow-badge-tag {
  display: block;
  font-size: 0.65rem;
  font-weight: 800;
  letter-spacing: 0.14em;
  color: #a78bfa;
  text-transform: uppercase;
}

.shadow-badge-title {
  margin: 2px 0 0 0;
  font-family: 'Cinzel', serif, Georgia;
  font-size: 1.35rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  color: #ffffff;
  text-shadow: 0 0 16px rgba(167, 139, 250, 0.7);
}

.shadow-behind-close-btn {
  background: transparent;
  border: 1px solid rgba(167, 139, 250, 0.3);
  color: #cbd5e1;
  width: 36px;
  height: 36px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.1rem;
  cursor: pointer;
  transition: all 0.2s ease;
}

.shadow-behind-close-btn:hover {
  background: rgba(255, 255, 255, 0.15);
  color: #ffffff;
  transform: scale(1.1);
  border-color: #ffffff;
}

/* Chapter Stepper Tabs */
.shadow-behind-nav {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
  padding: 12px 0;
  flex-shrink: 0;
  flex-wrap: wrap;
}

.shadow-behind-tab-btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: rgba(18, 14, 36, 0.65);
  border: 1px solid rgba(167, 139, 250, 0.25);
  color: #94a3b8;
  padding: 8px 16px;
  border-radius: 999px;
  font-size: 0.82rem;
  cursor: pointer;
  transition: all 0.25s ease;
}

.shadow-behind-tab-btn .tab-num {
  font-weight: 800;
  color: #c084fc;
  font-size: 0.72rem;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.shadow-behind-tab-btn .tab-title {
  font-weight: 600;
}

.shadow-behind-tab-btn:hover {
  background: rgba(45, 25, 85, 0.8);
  color: #e2e8f0;
  border-color: rgba(192, 132, 252, 0.5);
}

.shadow-behind-tab-btn.active {
  background: linear-gradient(135deg, rgba(76, 29, 149, 0.95), rgba(46, 16, 101, 0.95));
  border-color: #c084fc;
  color: #ffffff;
  box-shadow: 0 0 16px rgba(168, 85, 247, 0.45);
}

.shadow-behind-tab-btn.active .tab-num {
  color: #f1f5f9;
}

/* Book Deck & Chapter Panels */
.shadow-behind-book-deck {
  flex: 1;
  position: relative;
  overflow: hidden;
  margin: 6px 0 12px 0;
  border-radius: 18px;
  background: rgba(12, 10, 24, 0.65);
  border: 1px solid rgba(167, 139, 250, 0.22);
  box-shadow: inset 0 0 35px rgba(0, 0, 0, 0.65), 0 12px 36px rgba(0, 0, 0, 0.5);
}

.shadow-behind-chapter-panel {
  display: none;
  width: 100%;
  height: 100%;
  padding: 28px 32px;
  box-sizing: border-box;
  overflow-y: auto;
  scrollbar-width: thin;
  scrollbar-color: rgba(167, 139, 250, 0.4) transparent;
}

.shadow-behind-chapter-panel.active {
  display: block;
  animation: shadowPanelIn 0.35s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

@keyframes shadowPanelIn {
  from {
    opacity: 0;
    transform: translateY(12px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* Page Header */
.shadow-behind-page-header {
  text-align: center;
  margin-bottom: 24px;
}

.shadow-chapter-badge {
  display: inline-block;
  padding: 3px 12px;
  border-radius: 999px;
  background: rgba(124, 58, 237, 0.25);
  border: 1px solid rgba(167, 139, 250, 0.4);
  font-size: 0.68rem;
  font-weight: 800;
  letter-spacing: 0.15em;
  color: #c084fc;
  text-transform: uppercase;
  margin-bottom: 8px;
}

.shadow-chapter-main-title {
  margin: 0;
  font-family: 'Cinzel', serif, Georgia;
  font-size: 1.75rem;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 0.04em;
  text-shadow: 0 0 14px rgba(167, 139, 250, 0.6);
}

.shadow-chapter-sub-title {
  margin: 6px 0 0 0;
  font-size: 0.95rem;
  font-style: italic;
  color: #cbd5e1;
  letter-spacing: 0.02em;
}

/* Two-column Content Grid */
.shadow-chapter-grid {
  display: grid;
  grid-template-columns: 1.25fr 0.95fr;
  gap: 28px;
  align-items: start;
}

.shadow-text-column {
  font-size: 0.95rem;
  line-height: 1.75;
  color: #e2e8f0;
}

.shadow-journal-p {
  margin: 0 0 16px 0;
  text-align: justify;
}

.shadow-journal-p.drop-cap::first-letter {
  float: left;
  font-family: 'Cinzel', serif, Georgia;
  font-size: 2.8rem;
  line-height: 0.85;
  padding-top: 4px;
  padding-right: 10px;
  padding-bottom: 2px;
  color: #c084fc;
  text-shadow: 0 0 12px rgba(192, 132, 252, 0.6);
  font-weight: 700;
}

.shadow-journal-highlight {
  margin: 18px 0;
  padding: 12px 18px;
  border-left: 3px solid #a855f7;
  background: rgba(76, 29, 149, 0.2);
  border-radius: 0 10px 10px 0;
  font-weight: 600;
  color: #f1f5f9;
  font-style: italic;
}

.shadow-journal-quote {
  margin: 20px 0 10px 0;
  padding: 14px 20px;
  background: linear-gradient(135deg, rgba(46, 16, 101, 0.4), rgba(28, 20, 52, 0.6));
  border: 1px solid rgba(167, 139, 250, 0.35);
  border-radius: 12px;
  font-style: italic;
  color: #e0e7ff;
  text-align: center;
  font-size: 1rem;
  line-height: 1.6;
  box-shadow: 0 4px 18px rgba(0, 0, 0, 0.3);
}

/* Character Profile Card (Chapter I) */
.shadow-char-profile-card {
  background: linear-gradient(145deg, rgba(22, 15, 42, 0.85), rgba(10, 8, 20, 0.95));
  border: 1px solid rgba(167, 139, 250, 0.35);
  border-radius: 16px;
  padding: 20px;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.5), inset 0 0 20px rgba(124, 58, 237, 0.1);
}

.shadow-portrait-frame {
  position: relative;
  width: 100%;
  aspect-ratio: 4 / 4.5;
  max-height: 230px;
  border-radius: 12px;
  overflow: hidden;
  border: 1px solid rgba(192, 132, 252, 0.4);
  box-shadow: 0 6px 18px rgba(0, 0, 0, 0.6);
  margin-bottom: 14px;
}

.shadow-portrait-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center 20%;
  transition: transform 0.4s ease;
}

.shadow-char-profile-card:hover .shadow-portrait-img {
  transform: scale(1.04);
}

.shadow-dual-wings-badge {
  position: absolute;
  bottom: 8px;
  left: 50%;
  transform: translateX(-50%);
  background: rgba(15, 10, 30, 0.9);
  border: 1px solid rgba(192, 132, 252, 0.5);
  color: #f1f5f9;
  padding: 4px 12px;
  border-radius: 999px;
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.05em;
  white-space: nowrap;
  backdrop-filter: blur(8px);
}

.shadow-specs-list {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.shadow-spec-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 0.82rem;
  padding: 5px 0;
  border-bottom: 1px solid rgba(167, 139, 250, 0.15);
}

.shadow-spec-row:last-child {
  border-bottom: none;
}

.shadow-spec-row .spec-label {
  color: #a78bfa;
  font-weight: 600;
}

.shadow-spec-row .spec-val {
  color: #f1f5f9;
  font-weight: 700;
  text-align: right;
  max-width: 65%;
}

/* Symbolic Stage Card (Chapter II) */
.shadow-symbols-card {
  background: linear-gradient(145deg, rgba(20, 14, 40, 0.85), rgba(8, 7, 18, 0.95));
  border: 1px solid rgba(167, 139, 250, 0.35);
  border-radius: 16px;
  padding: 20px;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.5);
}

.shadow-symbols-visual {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-bottom: 16px;
}

.shadow-dual-stage-svg {
  filter: drop-shadow(0 0 14px rgba(167, 139, 250, 0.6));
  animation: shadowGlowPulse 4s ease-in-out infinite alternate;
}

@keyframes shadowGlowPulse {
  0% { transform: scale(1); filter: drop-shadow(0 0 10px rgba(167, 139, 250, 0.5)); }
  100% { transform: scale(1.03); filter: drop-shadow(0 0 20px rgba(192, 132, 252, 0.85)); }
}

.shadow-symbols-title {
  margin: 0 0 12px 0;
  font-size: 0.92rem;
  font-weight: 700;
  color: #c084fc;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  text-align: center;
}

.shadow-symbol-item {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  padding: 8px 0;
  border-bottom: 1px solid rgba(167, 139, 250, 0.12);
}

.shadow-symbol-item:last-child {
  border-bottom: none;
}

.shadow-symbol-icon {
  font-size: 1.3rem;
  line-height: 1;
  filter: drop-shadow(0 0 6px rgba(167, 139, 250, 0.6));
}

.shadow-symbol-info strong {
  display: block;
  font-size: 0.82rem;
  color: #ffffff;
  margin-bottom: 2px;
}

.shadow-symbol-info p {
  margin: 0;
  font-size: 0.76rem;
  color: #94a3b8;
  line-height: 1.4;
}

/* Gothic/Shadow Parchment Letter (Chapter III) */
.shadow-parchment-letter {
  max-width: 820px;
  margin: 0 auto;
  position: relative;
  background: linear-gradient(145deg, rgba(22, 18, 44, 0.9), rgba(12, 10, 26, 0.95));
  border: 1px solid rgba(167, 139, 250, 0.35);
  border-radius: 18px;
  padding: 36px 42px 42px 42px;
  box-shadow: 0 12px 32px rgba(0, 0, 0, 0.6), inset 0 0 30px rgba(76, 29, 149, 0.18);
}

.shadow-parchment-seal {
  position: absolute;
  top: -18px;
  right: 42px;
  width: 44px;
  height: 44px;
  background: radial-gradient(circle, #7c3aed 0%, #4c1d95 60%, #1e1035 100%);
  border: 2px solid #e0e7ff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4px 14px rgba(124, 58, 237, 0.7);
  font-size: 1.25rem;
}

.shadow-date-stamp {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 0.78rem;
  color: #a78bfa;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  margin-bottom: 22px;
  border-bottom: 1px solid rgba(167, 139, 250, 0.2);
  padding-bottom: 8px;
}

.shadow-letter-salutation {
  font-family: 'Cinzel', serif, Georgia;
  font-size: 1.15rem;
  color: #f1f5f9;
  font-weight: 700;
  margin-bottom: 16px;
}

.shadow-letter-body {
  font-size: 0.96rem;
  line-height: 1.8;
  color: #e2e8f0;
}

.shadow-letter-body p {
  margin: 0 0 14px 0;
  text-align: justify;
}

.shadow-letter-emphasis {
  font-style: italic;
  font-weight: 700;
  color: #c084fc;
  font-size: 1.05rem;
  margin: 16px 0;
}

.shadow-letter-signoff {
  margin-top: 24px;
  text-align: right;
  font-style: italic;
  color: #cbd5e1;
  font-size: 0.95rem;
}

/* Epilogue (Chapter IV) */
.shadow-epilogue-container {
  display: flex;
  flex-direction: column;
  gap: 28px;
  max-width: 920px;
  margin: 0 auto;
}

/* YouTube Player Card */
.shadow-player-card {
  background: linear-gradient(145deg, rgba(22, 17, 44, 0.85), rgba(11, 9, 24, 0.95));
  border: 1px solid rgba(167, 139, 250, 0.35);
  border-radius: 18px;
  padding: 20px;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.6);
}

.shadow-track-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14px;
  flex-wrap: wrap;
  gap: 10px;
}

.shadow-track-left {
  display: flex;
  align-items: center;
  gap: 12px;
}

.shadow-track-disc {
  font-size: 1.6rem;
  filter: drop-shadow(0 0 8px rgba(167, 139, 250, 0.7));
  animation: rotateDisc 12s linear infinite;
}

@keyframes rotateDisc {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.shadow-track-title {
  display: block;
  font-weight: 800;
  font-size: 1rem;
  color: #ffffff;
  letter-spacing: 0.04em;
}

.shadow-track-artist {
  display: block;
  font-size: 0.8rem;
  color: #a78bfa;
}

.shadow-track-badge {
  background: rgba(124, 58, 237, 0.25);
  border: 1px solid rgba(167, 139, 250, 0.4);
  padding: 4px 12px;
  border-radius: 999px;
  font-size: 0.72rem;
  font-weight: 700;
  color: #c084fc;
}

.shadow-youtube-box {
  position: relative;
  width: 100%;
  padding-bottom: 56.25%; /* 16:9 aspect ratio */
  height: 0;
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.7);
  background: #000000;
}

.shadow-youtube-box iframe {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  border: none;
}

.shadow-player-hint {
  margin: 12px 0 0 0;
  font-size: 0.8rem;
  color: #94a3b8;
  text-align: center;
  font-style: italic;
}

/* Song Meaning Card */
.shadow-meaning-card {
  background: linear-gradient(145deg, rgba(20, 15, 40, 0.85), rgba(10, 8, 22, 0.95));
  border: 1px solid rgba(167, 139, 250, 0.3);
  border-radius: 18px;
  padding: 24px 28px;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.5);
}

.shadow-meaning-header {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 16px;
  border-bottom: 1px solid rgba(167, 139, 250, 0.18);
  padding-bottom: 12px;
}

.shadow-meaning-icon {
  font-size: 1.6rem;
  filter: drop-shadow(0 0 8px rgba(167, 139, 250, 0.7));
}

.shadow-meaning-title {
  margin: 0;
  font-family: 'Cinzel', serif, Georgia;
  font-size: 1.2rem;
  font-weight: 700;
  color: #ffffff;
}

.shadow-meaning-sub {
  margin: 2px 0 0 0;
  font-size: 0.76rem;
  color: #a78bfa;
}

.shadow-meaning-body {
  font-size: 0.94rem;
  line-height: 1.75;
  color: #e2e8f0;
}

.shadow-meaning-body p {
  margin: 0 0 14px 0;
  text-align: justify;
}

.shadow-external-link {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  margin-top: 10px;
  padding: 8px 18px;
  background: rgba(76, 29, 149, 0.35);
  border: 1px solid rgba(167, 139, 250, 0.4);
  color: #e0e7ff;
  border-radius: 999px;
  font-size: 0.82rem;
  font-weight: 600;
  text-decoration: none;
  transition: all 0.2s ease;
}

.shadow-external-link:hover {
  background: rgba(124, 58, 237, 0.6);
  border-color: #ffffff;
  color: #ffffff;
  transform: translateY(-2px);
  box-shadow: 0 4px 14px rgba(124, 58, 237, 0.5);
}

/* Closing Atmosphere & Quote */
.shadow-closing-atmosphere {
  text-align: center;
  padding: 24px 20px 10px 20px;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.shadow-closing-halo {
  margin-bottom: 16px;
  filter: drop-shadow(0 0 18px rgba(167, 139, 250, 0.8));
}

.shadow-closing-quote-wrap {
  position: relative;
  max-width: 680px;
  margin: 0 auto;
}

.shadow-quote-symbol-top,
.shadow-quote-symbol-bottom {
  font-family: 'Cinzel', serif, Georgia;
  font-size: 2.2rem;
  color: rgba(167, 139, 250, 0.4);
  line-height: 1;
}

.shadow-closing-quote {
  margin: 0;
  font-family: 'Cinzel', serif, Georgia;
  font-size: 1.15rem;
  line-height: 1.6;
  font-weight: 600;
  color: #ffffff;
  letter-spacing: 0.03em;
  text-shadow: 0 0 16px rgba(167, 139, 250, 0.6);
}

.shadow-closing-author {
  margin-top: 14px;
  font-size: 0.85rem;
  font-weight: 700;
  color: #c084fc;
  letter-spacing: 0.1em;
  text-transform: uppercase;
}

/* Bottom Navigation Bar between Chapters */
.shadow-behind-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 12px;
  border-top: 1px solid rgba(167, 139, 250, 0.22);
  gap: 16px;
  flex-shrink: 0;
}

.shadow-behind-nav-btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: rgba(28, 20, 52, 0.85);
  border: 1px solid rgba(167, 139, 250, 0.35);
  color: #f1f5f9;
  padding: 8px 20px;
  border-radius: 999px;
  font-size: 0.84rem;
  font-weight: 700;
  cursor: pointer;
  transition: all 0.25s ease;
}

.shadow-behind-nav-btn:hover:not(:disabled) {
  background: rgba(76, 29, 149, 0.9);
  border-color: #ffffff;
  color: #ffffff;
  transform: translateY(-2px);
  box-shadow: 0 0 16px rgba(167, 139, 250, 0.5);
}

.shadow-behind-nav-btn:disabled {
  opacity: 0.35;
  cursor: not-allowed;
  transform: none;
}

.shadow-chapter-indicators {
  display: flex;
  align-items: center;
  gap: 10px;
}

.shadow-indicator-dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: rgba(167, 139, 250, 0.3);
  border: 1px solid rgba(167, 139, 250, 0.5);
  cursor: pointer;
  transition: all 0.25s ease;
  padding: 0;
}

.shadow-indicator-dot:hover {
  background: rgba(192, 132, 252, 0.7);
  transform: scale(1.2);
}

.shadow-indicator-dot.active {
  width: 28px;
  border-radius: 999px;
  background: linear-gradient(90deg, #c084fc, #818cf8);
  border-color: #ffffff;
  box-shadow: 0 0 10px rgba(192, 132, 252, 0.8);
}

/* HUD Pill Button in SHADOW World */
.shadow-behind-pill {
  background: linear-gradient(135deg, rgba(28, 18, 56, 0.9), rgba(15, 10, 32, 0.95)) !important;
  border: 1px solid rgba(167, 139, 250, 0.45) !important;
  color: #f1f5f9 !important;
  display: inline-flex !important;
  align-items: center !important;
  gap: 8px !important;
  padding: 6px 14px !important;
  border-radius: 999px !important;
  cursor: pointer !important;
  transition: all 0.25s ease !important;
  backdrop-filter: blur(10px) !important;
}

.shadow-behind-pill:hover {
  background: linear-gradient(135deg, rgba(76, 29, 149, 0.95), rgba(30, 16, 68, 0.95)) !important;
  border-color: #c084fc !important;
  transform: translateY(-2px) !important;
  box-shadow: 0 0 18px rgba(168, 85, 247, 0.55) !important;
}

.shadow-behind-label {
  display: flex;
  flex-direction: column;
  text-align: left;
}

.shadow-behind-main {
  font-size: 0.75rem;
  font-weight: 800;
  letter-spacing: 0.08em;
  color: #ffffff;
}

.shadow-behind-sub {
  font-size: 0.62rem;
  font-weight: 500;
  color: #cbd5e1;
  font-style: italic;
  max-width: 170px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* Responsive Rules */
@media (max-width: 960px) {
  .shadow-chapter-grid {
    grid-template-columns: 1fr;
    gap: 20px;
  }
  .shadow-parchment-letter {
    padding: 28px 24px;
  }
  .shadow-behind-container {
    padding: 14px 16px;
  }
  .shadow-chapter-main-title {
    font-size: 1.45rem;
  }
}

@media (max-width: 640px) {
  .shadow-behind-header {
    flex-wrap: wrap;
  }
  .shadow-behind-title-badge {
    order: 3;
    width: 100%;
    justify-content: center;
  }
  .shadow-behind-tab-btn {
    padding: 6px 10px;
    font-size: 0.75rem;
  }
  .shadow-behind-chapter-panel {
    padding: 18px 14px;
  }
  .shadow-closing-quote {
    font-size: 0.98rem;
  }
  .shadow-behind-footer {
    gap: 8px;
  }
  .shadow-behind-nav-btn {
    padding: 6px 14px;
    font-size: 0.76rem;
  }
  .shadow-behind-sub {
    display: none;
  }
}
