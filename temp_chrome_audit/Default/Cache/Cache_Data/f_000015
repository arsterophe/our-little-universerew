/* THE WHISPERING POND — RELAXING FISHING SIMULATOR (SYMA'S UNIVERSE)        */
/* ========================================================================== */

.pinwheel-whispering-pond-overlay {
  position: fixed;
  inset: 0;
  z-index: 12000;
  display: none;
  background: #09090b;
  overflow: hidden;
  font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
  color: #f8fafc;
}

.pinwheel-whispering-pond-overlay.active {
  display: block;
}

.pond-environment-backdrop {
  position: absolute;
  inset: 0;
  z-index: 0;
  background: linear-gradient(180deg, #030712 0%, #09090b 40%, #180d38 80%, #2e1065 100%);
  transition: background 1.2s ease;
}

/* Weather & Sky Particles */
.pond-weather-particles {
  position: absolute;
  inset: 0;
  z-index: 1;
  pointer-events: none;
  overflow: hidden;
}

.pond-sky-particle {
  position: absolute;
  color: rgba(233, 213, 255, 0.4);
  font-size: 1rem;
  animation: pondParticleFloat 10s infinite linear;
}

.pond-sky-particle.sp1 { top: 12%; left: 15%; animation-duration: 9s; }
.pond-sky-particle.sp2 { top: 28%; left: 75%; animation-duration: 13s; animation-delay: 2s; }
.pond-sky-particle.sp3 { top: 52%; left: 45%; animation-duration: 11s; animation-delay: 4s; }
.pond-sky-particle.sp4 { top: 75%; left: 85%; animation-duration: 14s; animation-delay: 1s; }
.pond-sky-particle.sp5 { top: 35%; left: 25%; animation-duration: 12s; animation-delay: 3s; }
.pond-sky-particle.sp6 { top: 82%; left: 18%; animation-duration: 8s; animation-delay: 5s; }

@keyframes pondParticleFloat {
  0% { transform: translateY(0) rotate(0deg); opacity: 0.2; }
  50% { opacity: 0.8; transform: translateY(-30px) rotate(180deg); }
  100% { transform: translateY(-60px) rotate(360deg); opacity: 0.1; }
}

