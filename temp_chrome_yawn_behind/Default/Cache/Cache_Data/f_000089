      }
      grid.innerHTML = logs.slice(0, 6).map((item) => `
        <div class="yawn-artifact-item">
          <span class="yawn-artifact-icon">${item.symbol}</span>
          <div class="yawn-artifact-info">
            <h4>${item.name}</h4>
            <p>Diamati pada ${item.dateStr}</p>
          </div>
        </div>
      `).join('');
    } catch {
      grid.innerHTML = '';
    }
  }

