  color: #1e293b;
  text-align: justify;
}

.pinwheel-letter-body p strong {
  color: #1e3a8a;
}

.pinwheel-letter-signoff {
  margin-top: 28px;
  padding-top: 18px;
  border-top: 1px solid rgba(147, 197, 253, 0.4);
  font-style: italic;
