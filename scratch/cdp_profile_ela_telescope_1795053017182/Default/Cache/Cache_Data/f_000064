          const q = state.dailyQuests.find(item => item.id === qid);
          if (q && q.completed && !q.claimed) {
            q.claimed = true;
            state.coins += q.rewardCoins;
            state.xp += q.rewardXp;
            checkLevelUp(state);
            saveState();
            updateHUD();
            openQuests();
