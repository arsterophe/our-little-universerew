}

.pinwheel-behind-back-btn:hover,
.pinwheel-behind-close-btn:hover {
  background: linear-gradient(135deg, rgba(79, 70, 229, 0.9), rgba(124, 58, 237, 0.9));
  border-color: #93c5fd;
  color: #ffffff;
