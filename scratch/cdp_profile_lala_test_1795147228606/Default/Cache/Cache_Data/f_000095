// -----------------------------------------------------------------------------
// 8. STORAGE PERSISTENCE (LOAD / SAVE / RESET)
// -----------------------------------------------------------------------------
export function loadAzurePalaceState(characterKey = 'akhira') {
  const key = `${AZURE_PALACE_STORAGE_KEY}_${characterKey || 'akhira'}`;
  try {
    const loaded = getSynchronousState(
      OLU_STORE_HOUSE_STATES,
      key,
      () => createDefaultAzurePalaceState()
