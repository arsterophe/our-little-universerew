.pinwheel-quote-box {
  margin: 12px 0;
  padding: 14px 20px;
  background: rgba(147, 197, 253, 0.08);
  border-left: 3px solid #93c5fd;
  border-radius: 0 14px 14px 0;
  font-family: 'Cormorant Garamond', serif;
  font-size: 1.2rem;
  font-style: italic;
  color: #bfdbfe;
  line-height: 1.6;
}

.pinwheel-highlight-text {
  font-size: 1.02rem;
  font-weight: 700;
  color: #fde047;
  text-shadow: 0 0 12px rgba(253, 224, 71, 0.45);
  margin: 4px 0;
}

/* Visual Feature Cards in Chapters */
.pinwheel-feature-card {
  background: rgba(20, 12, 38, 0.75);
  border: 1px solid rgba(147, 197, 253, 0.3);
  border-radius: 20px;
