            <strong style="color: #ffffff;">
              ${myResp.status === 'accepted' ? '✓ Setuju' : (myResp.status === 'rejected' || myResp.status === 'declined') ? '✕ Menolak' : myResp.status === 'proposed_alt' ? '⇄ Mengusulkan Alternatif' : 'Menunggu responsmu'}
            </strong>
