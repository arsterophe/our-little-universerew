/**
 * GAZEBO NYANYA — KIDULT EVERDREAM GAZEBO STYLING
 * Universe KIDULT (Storybook Fairytale Twilight Aesthetic)
 * =============================================================================
 */

:root {
  --kg-lavender-dark: #1b102e;
  --kg-purple-deep: #2a1645;
  --kg-lilac: #d8b4fe;
  --kg-gold: #fde047;
  --kg-gold-glow: rgba(253, 224, 71, 0.45);
  --kg-dusty-pink: #fbcfe8;
  --kg-mint: #a7f3d0;
  --kg-card-border: rgba(251, 207, 232, 0.45);
  --kg-champagne: #fef08a;
}

.view-kidult-gazebo {
  position: absolute;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  display: none;
  background-color: var(--kg-lavender-dark);
  font-family: 'Quicksand', 'Nunito', 'Segoe UI', system-ui, sans-serif;
  color: #fdf4ff;
  user-select: none;
  z-index: 105;
}

.view-kidult-gazebo.active {
  display: flex;
  flex-direction: column;
}

/* Background Scene Layer */
.kgazebo-scene-layer {
  position: absolute;
  inset: 0;
  background-image: url('/assets/kidult_gazebo_interior.jpg');
  background-size: cover;
  background-position: center center;
  background-repeat: no-repeat;
  filter: brightness(0.96) saturate(1.05);
  transition: filter 0.6s ease;
  z-index: 1;
}

/* Dynamic Atmosphere Lighting Overlay */
.kgazebo-lighting-overlay {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 2;
  transition: background 0.6s ease, opacity 0.6s ease;
}

.kgazebo-lighting-overlay.light-golden {
  background: radial-gradient(circle at 50% 25%, rgba(254, 240, 138, 0.16) 0%, rgba(245, 158, 11, 0.08) 50%, rgba(20, 10, 35, 0.3) 100%);
}

.kgazebo-lighting-overlay.light-lavender {
  background: radial-gradient(circle at 50% 30%, rgba(192, 132, 252, 0.2) 0%, rgba(147, 51, 234, 0.1) 60%, rgba(20, 10, 35, 0.4) 100%);
}

.kgazebo-lighting-overlay.light-firefly {
  background: radial-gradient(circle at 50% 40%, rgba(167, 243, 208, 0.16) 0%, rgba(16, 185, 129, 0.08) 50%, rgba(20, 10, 35, 0.35) 100%);
}

.kgazebo-lighting-overlay.light-rosy {
  background: radial-gradient(circle at 50% 30%, rgba(251, 207, 232, 0.18) 0%, rgba(244, 114, 182, 0.1) 60%, rgba(20, 10, 35, 0.35) 100%);
}

/* Floating Wisteria Petals & Magical Starlight */
.kgazebo-petals-layer {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 3;
  overflow: hidden;
}

.kg-petal {
  position: absolute;
  color: var(--kg-dusty-pink);
  opacity: 0.75;
  animation: kgPetalDrift 8s linear infinite;
}

@keyframes kgPetalDrift {
  0% { transform: translateY(-20px) rotate(0deg) scale(0.8); opacity: 0; }
  15% { opacity: 0.85; }
  85% { opacity: 0.8; }
  100% { transform: translateY(105vh) rotate(360deg) scale(1.1); opacity: 0; }
}

/* =============================================================================
   1. TOP BAR HUD (MATCHING LELE'S GAZEBO STRUCTURE IN KIDULT PALETTE)
   ============================================================================= */
.kgazebo-top-bar {
  position: relative;
  z-index: 20;
  min-height: 70px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0.6rem 2rem;
  background: linear-gradient(180deg, rgba(28, 16, 48, 0.92) 0%, rgba(38, 22, 64, 0.8) 80%, transparent 100%);
  border-bottom: 1px solid rgba(251, 207, 232, 0.22);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
}

.kgazebo-brand-group {
  display: flex;
  align-items: center;
  gap: 1.25rem;
}

.btn-kgazebo-back {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  background: rgba(255, 255, 255, 0.08);
  border: 1px solid rgba(251, 207, 232, 0.35);
  border-radius: 9999px;
  padding: 0.5rem 1.15rem;
  color: #fdf4ff;
  font-size: 0.88rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.25s ease;
  backdrop-filter: blur(8px);
}

.btn-kgazebo-back:hover {
  background: rgba(244, 114, 182, 0.25);
  border-color: #f472b6;
  transform: translateX(-3px);
  box-shadow: 0 4px 14px rgba(244, 114, 182, 0.3);
}

.kgazebo-title-group {
  display: flex;
  align-items: center;
  gap: 0.75rem;
}

.kgazebo-star-icon {
  font-size: 1.6rem;
  color: #fef08a;
  filter: drop-shadow(0 0 10px #fef08a);
  animation: kgStarPulse 3s ease-in-out infinite alternate;
}

@keyframes kgStarPulse {
  0% { transform: scale(1) rotate(0deg); }
  100% { transform: scale(1.12) rotate(15deg); }
}

.kgazebo-title-texts h1 {
  margin: 0;
  font-size: 1.25rem;
  letter-spacing: 0.08em;
  font-weight: 800;
  background: linear-gradient(135deg, #fbcfe8 0%, #e9d5ff 50%, #fef08a 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.kgazebo-title-texts p {
  margin: 0.15rem 0 0 0;
  font-size: 0.78rem;
  color: #e2e8f0;
}

.kgazebo-top-quote {
  font-family: 'Cormorant Garamond', 'Georgia', serif;
  font-size: 0.92rem;
  font-style: italic;
  color: #fed7aa;
  margin: 0 0 0 1.5rem;
  display: none;
  max-width: 380px;
  line-height: 1.35;
}

@media (min-width: 1200px) {
  .kgazebo-top-quote {
    display: block;
  }
}

/* Music Player Pill (Top Bar) */
.kgazebo-music-pill {
  display: inline-flex;
  align-items: center;
  gap: 0.85rem;
  background: rgba(30, 18, 52, 0.75);
  border: 1px solid rgba(251, 207, 232, 0.35);
  border-radius: 9999px;
  padding: 0.45rem 1.15rem;
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  box-shadow: 0 4px 18px rgba(0, 0, 0, 0.25);
}

.kgazebo-music-title-wrap {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  font-size: 0.82rem;
  font-weight: 600;
  color: #fbcfe8;
  max-width: 190px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.kgazebo-music-icon {
  font-size: 1rem;
  display: inline-block;
  animation: kgMusicBounce 1.8s ease-in-out infinite;
  animation-play-state: paused;
}

@keyframes kgMusicBounce {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-3px) scale(1.1); }
}

.btn-kgazebo-music-toggle {
  background: linear-gradient(135deg, #ec4899 0%, #a855f7 100%);
  border: none;
  color: #ffffff;
  width: 32px;
  height: 32px;
  border-radius: 50%;
  font-size: 0.95rem;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
  box-shadow: 0 2px 8px rgba(236, 72, 153, 0.4);
}

.btn-kgazebo-music-toggle:hover {
  transform: scale(1.12);
}

.kgazebo-music-vol-group {
  display: flex;
  align-items: center;
  gap: 0.45rem;
}

.btn-kgazebo-music-mute {
  background: transparent;
  border: none;
  color: #e2e8f0;
  cursor: pointer;
  font-size: 0.95rem;
  padding: 0 0.15rem;
}

.kgazebo-vol-slider {
  width: 75px;
  height: 5px;
  -webkit-appearance: none;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 9999px;
  outline: none;
}

.kgazebo-vol-slider::-webkit-slider-thumb {
  -webkit-appearance: none;
  width: 13px;
  height: 13px;
  border-radius: 50%;
  background: #f472b6;
  cursor: pointer;
  box-shadow: 0 0 6px rgba(244, 114, 182, 0.8);
}

/* =============================================================================
   2. FOUR CENTRAL ACTIVITY CARDS (KIDULT AESTHETIC)
   ============================================================================= */
.kgazebo-center-stage {
  position: relative;
  z-index: 10;
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 1.5rem 2rem;
}

.kgazebo-cards-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(215px, 255px));
  gap: 1.35rem;
  justify-content: center;
  max-width: 1100px;
  width: 100%;
}

.kgazebo-card {
  position: relative;
  background: linear-gradient(145deg, rgba(255, 245, 250, 0.82) 0%, rgba(245, 235, 255, 0.86) 50%, rgba(254, 240, 248, 0.9) 100%);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1.5px solid rgba(251, 207, 232, 0.85);
  border-radius: 24px;
  padding: 1.75rem 1.3rem;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: 0.75rem;
  cursor: pointer;
  transition: all 0.32s cubic-bezier(0.16, 1, 0.3, 1);
  box-shadow: 0 10px 28px rgba(112, 26, 117, 0.14), 0 0 16px rgba(244, 114, 182, 0.22), inset 0 1px 2px rgba(255, 255, 255, 0.95);
  overflow: hidden;
  color: #4a1d6a;
}

/* Cute Ribbon / Star Ornament */
.kgazebo-card::before {
  content: '⭐';
  position: absolute;
  top: 10px;
  right: 14px;
  font-size: 0.75rem;
  opacity: 0.45;
  transition: opacity 0.3s ease, transform 0.3s ease;
}

.kgazebo-card:hover {
  transform: translateY(-8px) scale(1.02);
  border-color: #f472b6;
  background: linear-gradient(145deg, rgba(255, 250, 253, 0.92) 0%, rgba(248, 240, 255, 0.94) 50%, rgba(255, 245, 250, 0.96) 100%);
  box-shadow: 0 16px 36px rgba(112, 26, 117, 0.22), 0 0 24px rgba(244, 114, 182, 0.4), inset 0 1px 2px #ffffff;
}

.kgazebo-card:hover::before {
  opacity: 1;
  transform: rotate(45deg) scale(1.2);
}

.kgazebo-card .card-icon-halo {
  width: 62px;
  height: 62px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 2rem;
  background: linear-gradient(135deg, #fce7f3 0%, #f3e8ff 100%);
  border: 1.5px solid rgba(244, 114, 182, 0.45);
  box-shadow: 0 4px 14px rgba(236, 72, 153, 0.2);
  transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
}

.kgazebo-card:hover .card-icon-halo {
  transform: scale(1.12) rotate(6deg);
  box-shadow: 0 6px 18px rgba(236, 72, 153, 0.35);
}

.kgazebo-card h3 {
  margin: 0;
  font-size: 1.18rem;
  font-weight: 700;
  color: #581c87;
  letter-spacing: -0.01em;
}

.kgazebo-card p {
  margin: 0;
  font-size: 0.82rem;
  color: #701a75;
  line-height: 1.45;
}

/* =============================================================================
   3. BOTTOM ACTION DOCK (POJOK KIRI BAWAH)
   ============================================================================= */
.kgazebo-bottom-bar {
  position: relative;
  z-index: 15;
  display: flex;
  align-items: flex-end;
  justify-content: flex-start;
  padding: 1rem 2.25rem 1.6rem 2.25rem;
  pointer-events: none;
}

.kgazebo-quick-actions {
  display: flex;
  align-items: center;
  gap: 1rem;
  pointer-events: auto;
}

/* Circular Action Buttons (KIDULT Pastel & Soft Glow Aesthetic) */
.btn-kgazebo-circle-action {
  position: relative;
  width: 52px;
  height: 52px;
  border-radius: 50%;
  background: linear-gradient(135deg, rgba(255, 240, 248, 0.45) 0%, rgba(233, 213, 255, 0.52) 100%);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  border: 1.5px solid rgba(251, 207, 232, 0.75);
  box-shadow: 0 6px 20px rgba(74, 29, 106, 0.28), 0 0 16px rgba(244, 114, 182, 0.32), inset 0 1px 2px rgba(255, 255, 255, 0.85);
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: all 0.28s cubic-bezier(0.16, 1, 0.3, 1);
  color: #ffffff;
  padding: 0;
  outline: none;
}

.btn-kgazebo-circle-action .circle-action-icon {
  font-size: 1.65rem;
  line-height: 1;
  filter: drop-shadow(0 2px 6px rgba(0, 0, 0, 0.25));
  transition: transform 0.25s ease;
}

.btn-kgazebo-circle-action:hover {
  transform: translateY(-5px) scale(1.08);
  background: linear-gradient(135deg, rgba(255, 245, 250, 0.78) 0%, rgba(243, 232, 255, 0.82) 100%);
  border-color: #f472b6;
  box-shadow: 0 10px 28px rgba(236, 72, 153, 0.45), 0 0 22px rgba(254, 240, 138, 0.55), inset 0 1px 2px #ffffff;
}

.btn-kgazebo-circle-action:hover .circle-action-icon {
  transform: scale(1.15) rotate(6deg);
}

.btn-kgazebo-circle-action:active {
  transform: translateY(-1px) scale(1.02);
}

/* Tooltip on hover */
.btn-kgazebo-circle-action::after {
  content: attr(data-tooltip);
  position: absolute;
  bottom: calc(100% + 10px);
  left: 50%;
  transform: translateX(-50%) translateY(4px);
  background: rgba(26, 14, 46, 0.94);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border: 1px solid rgba(251, 207, 232, 0.4);
  color: #fdf4ff;
  font-size: 0.78rem;
  font-weight: 600;
  white-space: nowrap;
  padding: 0.35rem 0.75rem;
  border-radius: 8px;
  box-shadow: 0 6px 18px rgba(0, 0, 0, 0.45);
  opacity: 0;
  pointer-events: none;
  visibility: hidden;
  transition: all 0.2s ease;
  z-index: 30;
}

.btn-kgazebo-circle-action:hover::after {
  opacity: 1;
  visibility: visible;
  transform: translateX(-50%) translateY(0);
}

/* Lele's Gazebo Songs We Share Button */
.btn-gazebo-songs-we-share {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.55rem 1.25rem;
  background: linear-gradient(135deg, #ec4899 0%, #a855f7 100%);
  border: 1px solid rgba(255, 255, 255, 0.3);
  border-radius: 9999px;
  font-size: 0.85rem;
  font-weight: 700;
  color: #ffffff;
  cursor: pointer;
  box-shadow: 0 4px 18px rgba(236, 72, 153, 0.45);
  transition: all 0.25s ease;
}

.btn-kgazebo-songs-we-share:hover,
.btn-gazebo-songs-we-share:hover {
  transform: translateY(-2px) scale(1.04);
  box-shadow: 0 6px 22px rgba(236, 72, 153, 0.65);
}

/* =============================================================================
   4. MODALS DIALOG & SHEETS (MATCHING LELE'S GAZEBO EXPERIENCES)
   ============================================================================= */
.kgazebo-modal-backdrop {
  position: fixed;
  inset: 0;
  z-index: 200;
  background: rgba(14, 8, 28, 0.78);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 1.5rem;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.3s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.3s;
}

.kgazebo-modal-backdrop.open {
  opacity: 1;
  visibility: visible;
}

.kgazebo-modal-dialog {
  width: 100%;
  max-width: 860px;
  max-height: 88vh;
  background: linear-gradient(145deg, rgba(34, 20, 56, 0.95) 0%, rgba(22, 12, 40, 0.97) 100%);
  border: 1.5px solid rgba(251, 207, 232, 0.4);
  border-radius: 28px;
  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.65), 0 0 32px rgba(244, 114, 182, 0.25);
  display: flex;
  flex-direction: column;
  overflow: hidden;
  color: #fdf4ff;
  transform: translateY(18px) scale(0.98);
  transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
}

.kgazebo-modal-backdrop.open .kgazebo-modal-dialog {
  transform: translateY(0) scale(1);
}

.kgazebo-modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 1.3rem 2rem 1.1rem 2rem;
  border-bottom: 1px solid rgba(251, 207, 232, 0.2);
  background: linear-gradient(90deg, rgba(236, 72, 153, 0.12), transparent);
}

.kgazebo-modal-header-meta {
  display: flex;
  align-items: center;
  gap: 0.9rem;
}

.kgazebo-modal-header-icon {
  font-size: 2rem;
  filter: drop-shadow(0 0 10px rgba(244, 114, 182, 0.5));
}

.kgazebo-modal-header h2 {
  margin: 0;
  font-size: 1.35rem;
  font-weight: 700;
  color: #ffffff;
}

.kgazebo-modal-header p {
  margin: 0.2rem 0 0 0;
  font-size: 0.8rem;
  color: #cbd5e1;
}

.btn-kgazebo-modal-close {
  background: rgba(255, 255, 255, 0.08);
  border: 1px solid rgba(255, 255, 255, 0.15);
  color: #f1f5f9;
  width: 36px;
  height: 36px;
  border-radius: 50%;
  font-size: 1.1rem;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
}

.btn-kgazebo-modal-close:hover {
  background: rgba(244, 63, 94, 0.35);
  transform: rotate(90deg);
}

.kgazebo-modal-body {
  padding: 1.5rem 2rem 2rem 2rem;
  overflow-y: auto;
  flex: 1;
}

/* =============================================================================
   4A. TEA TIME MODAL CONTENT
   ============================================================================= */
.tea-selection-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 1.1rem;
  margin-bottom: 1.5rem;
}

.tea-option-card {
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(251, 207, 232, 0.25);
  border-radius: 18px;
  padding: 1.15rem;
  cursor: pointer;
  transition: all 0.25s ease;
  text-align: center;
}

.tea-option-card:hover {
  background: rgba(255, 255, 255, 0.1);
  border-color: #f472b6;
  transform: translateY(-3px);
}

.tea-option-card.selected {
  background: linear-gradient(145deg, rgba(236, 72, 153, 0.25), rgba(168, 85, 247, 0.25));
  border-color: #f472b6;
  box-shadow: 0 4px 16px rgba(236, 72, 153, 0.35);
}

.tea-option-icon {
  font-size: 2.2rem;
  margin-bottom: 0.45rem;
}

.tea-option-card h4 {
  margin: 0;
  font-size: 0.95rem;
  color: #ffffff;
}

.tea-option-card p {
  margin: 0.35rem 0 0 0;
  font-size: 0.78rem;
  color: #cbd5e1;
  line-height: 1.4;
}

.tea-serving-display {
  display: flex;
  align-items: center;
  gap: 1.5rem;
  padding: 1.25rem;
  background: rgba(18, 10, 32, 0.6);
  border: 1px solid rgba(251, 207, 232, 0.25);
  border-radius: 18px;
  margin-bottom: 1.4rem;
}

.tea-cup-visual {
  width: 64px;
  height: 64px;
  border-radius: 50%;
  background: linear-gradient(135deg, rgba(244, 114, 182, 0.3), rgba(168, 85, 247, 0.3));
  border: 1.5px solid rgba(244, 114, 182, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 2.2rem;
  box-shadow: 0 0 16px rgba(244, 114, 182, 0.35);
}

.btn-brew-tea {
  width: 100%;
  background: linear-gradient(135deg, #ec4899 0%, #a855f7 100%);
  border: none;
  color: #ffffff;
  font-size: 0.95rem;
  font-weight: 700;
  padding: 0.85rem;
  border-radius: 14px;
  cursor: pointer;
  box-shadow: 0 4px 18px rgba(236, 72, 153, 0.45);
  transition: all 0.25s ease;
}

.btn-brew-tea:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 22px rgba(236, 72, 153, 0.65);
}

/* =============================================================================
   4B. PERPUSTAKAAN KECIL (STORY READER)
   ============================================================================= */
.library-books-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
  gap: 1.2rem;
}

.library-book-card {
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(251, 207, 232, 0.25);
  border-radius: 18px;
  padding: 1.25rem;
  cursor: pointer;
  transition: all 0.25s ease;
  display: flex;
  flex-direction: column;
}

.library-book-card:hover {
  background: rgba(255, 255, 255, 0.1);
  border-color: #f472b6;
  transform: translateY(-4px);
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35);
}

.book-card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 0.65rem;
}

.book-category-pill {
  font-size: 0.7rem;
  font-weight: 700;
  padding: 0.2rem 0.6rem;
  border-radius: 9999px;
  background: rgba(244, 114, 182, 0.25);
  color: #fbcfe8;
  border: 1px solid rgba(244, 114, 182, 0.4);
}

.library-book-card h4 {
  margin: 0;
  font-size: 1.05rem;
  font-weight: 700;
  color: #ffffff;
}

.library-book-card p {
  margin: 0.35rem 0 0 0;
  font-size: 0.8rem;
  color: #cbd5e1;
  line-height: 1.4;
  flex: 1;
}

.book-progress-bar-wrap {
  margin-top: 1rem;
}

.progress-track {
  width: 100%;
  height: 6px;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 9999px;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #ec4899, #a855f7);
  border-radius: 9999px;
  transition: width 0.3s ease;
}

.progress-label-text {
  display: flex;
  justify-content: space-between;
  margin-top: 0.4rem;
  font-size: 0.72rem;
  color: #94a3b8;
}

.gazebo-reader-container {
  display: flex;
  flex-direction: column;
  gap: 1.2rem;
}

.reader-nav-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.btn-reader-back {
  background: rgba(255, 255, 255, 0.08);
  border: 1px solid rgba(255, 255, 255, 0.15);
  color: #fdf4ff;
  font-size: 0.82rem;
  padding: 0.45rem 0.95rem;
  border-radius: 10px;
  cursor: pointer;
}

.reader-content-sheet {
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid rgba(251, 207, 232, 0.2);
  border-radius: 18px;
  padding: 1.75rem;
  color: #f1f5f9;
  line-height: 1.85;
  white-space: pre-wrap;
  font-family: 'Merriweather', 'Georgia', serif;
  max-height: 52vh;
  overflow-y: auto;
}

.reader-pager-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.btn-reader-page {
  background: linear-gradient(135deg, rgba(236, 72, 153, 0.3), rgba(168, 85, 247, 0.3));
  border: 1px solid rgba(244, 114, 182, 0.45);
  color: #ffffff;
  font-size: 0.85rem;
  font-weight: 600;
  padding: 0.55rem 1.15rem;
  border-radius: 12px;
  cursor: pointer;
}

.btn-reader-page:disabled {
  opacity: 0.4;
  cursor: not-allowed;
}

/* =============================================================================
   4C. JURNAL MALAM (KIDULT PHILOSOPHY)
   ============================================================================= */
.journal-tabs-row {
  display: flex;
  gap: 0.75rem;
  margin-bottom: 1.4rem;
}

.journal-tab-btn {
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid rgba(251, 207, 232, 0.2);
  color: #cbd5e1;
  font-size: 0.85rem;
  font-weight: 600;
  padding: 0.55rem 1.15rem;
  border-radius: 9999px;
  cursor: pointer;
  transition: all 0.2s ease;
}

.journal-tab-btn.active {
  background: linear-gradient(135deg, rgba(236, 72, 153, 0.4), rgba(168, 85, 247, 0.4));
  border-color: #f472b6;
  color: #ffffff;
}

.journal-entries-list {
  display: flex;
  flex-direction: column;
  gap: 0.95rem;
}

.journal-entry-card {
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(251, 207, 232, 0.2);
  border-radius: 16px;
  padding: 1.15rem 1.35rem;
  cursor: pointer;
  transition: all 0.25s ease;
}

.journal-entry-card:hover {
  background: rgba(255, 255, 255, 0.09);
  border-color: #f472b6;
  transform: translateX(4px);
}

.journal-card-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 0.4rem;
}

.journal-card-top h4 {
  margin: 0;
  font-size: 1.05rem;
  color: #ffffff;
}

.journal-card-date {
  font-size: 0.75rem;
  color: #fbcfe8;
}

.journal-card-snippet {
  margin: 0;
  font-size: 0.82rem;
  color: #cbd5e1;
  line-height: 1.45;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.journal-form {
  display: flex;
  flex-direction: column;
  gap: 1.15rem;
}

.journal-input-title {
  background: rgba(18, 10, 32, 0.65);
  border: 1.5px solid rgba(251, 207, 232, 0.3);
  border-radius: 12px;
  padding: 0.75rem 1rem;
  color: #ffffff;
  font-size: 0.95rem;
  font-weight: 600;
  outline: none;
}

.journal-input-title:focus {
  border-color: #f472b6;
  box-shadow: 0 0 12px rgba(244, 114, 182, 0.35);
}

.journal-mood-selector {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  flex-wrap: wrap;
}

.journal-mood-pill {
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid rgba(251, 207, 232, 0.25);
  color: #cbd5e1;
  font-size: 0.78rem;
  padding: 0.35rem 0.85rem;
  border-radius: 9999px;
  cursor: pointer;
}

.journal-mood-pill.selected {
  background: linear-gradient(135deg, rgba(236, 72, 153, 0.45), rgba(168, 85, 247, 0.45));
  border-color: #f472b6;
  color: #ffffff;
  font-weight: 700;
}

.journal-textarea-body {
  background: rgba(18, 10, 32, 0.65);
  border: 1.5px solid rgba(251, 207, 232, 0.3);
  border-radius: 14px;
  padding: 1rem;
  color: #f1f5f9;
  font-size: 0.9rem;
  line-height: 1.7;
  font-family: inherit;
  min-height: 160px;
  outline: none;
  resize: vertical;
}

.journal-textarea-body:focus {
  border-color: #f472b6;
  box-shadow: 0 0 12px rgba(244, 114, 182, 0.35);
}

/* =============================================================================
   4D. QUIET MOMENT MODAL
   ============================================================================= */
.ambient-options-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
  gap: 1.1rem;
  margin-bottom: 1.6rem;
}

.ambient-sound-card {
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(251, 207, 232, 0.25);
  border-radius: 18px;
  padding: 1.25rem;
  cursor: pointer;
  transition: all 0.25s ease;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: 0.65rem;
}

.ambient-sound-card:hover {
  background: rgba(255, 255, 255, 0.1);
  border-color: #f472b6;
  transform: translateY(-3px);
}

.ambient-sound-card.active {
  background: linear-gradient(145deg, rgba(236, 72, 153, 0.35), rgba(168, 85, 247, 0.35));
  border-color: #f472b6;
  box-shadow: 0 4px 18px rgba(236, 72, 153, 0.4);
}

.sound-card-icon {
  font-size: 2.2rem;
}

.ambient-sound-card h4 {
  margin: 0;
  font-size: 1rem;
  color: #ffffff;
}

.ambient-sound-card p {
  margin: 0;
  font-size: 0.78rem;
  color: #cbd5e1;
  line-height: 1.4;
}

.ambient-controls-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 1rem 1.4rem;
  background: rgba(18, 10, 32, 0.6);
  border: 1px solid rgba(251, 207, 232, 0.25);
  border-radius: 16px;
}

.ambient-active-name {
  font-size: 0.85rem;
  font-weight: 600;
  color: #fbcfe8;
}

/* Puppy & Steam Hotspots on Interior Scene */
.kg-hotspot-puppy {
  position: absolute;
  bottom: 12%;
  left: 12%;
  width: 140px;
  height: 90px;
  cursor: pointer;
  z-index: 8;
  border-radius: 20px;
}

.kg-hotspot-puppy:hover {
  box-shadow: 0 0 20px rgba(244, 114, 182, 0.4);
}

@media (max-width: 992px) {
  .kgazebo-cards-grid {
    grid-template-columns: repeat(2, minmax(180px, 1fr));
    gap: 1rem;
  }
  .kgazebo-bottom-bar {
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1rem 1.25rem 1rem;
  }
}

@media (max-width: 640px) {
  .kgazebo-top-bar {
    padding: 0.5rem 1rem;
  }
  .kgazebo-cards-grid {
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
  }
  .kgazebo-card {
    padding: 1.15rem 0.85rem;
  }
  .kgazebo-card .card-icon-halo {
    width: 48px;
    height: 48px;
    font-size: 1.5rem;
  }
  .kgazebo-card h3 {
    font-size: 1rem;
  }
  .kgazebo-card p {
    font-size: 0.72rem;
  }
}
