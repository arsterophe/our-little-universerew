/* ==========================================================================
   OUR LITTLE UNIVERSE — ROYAN'S UNIVERSE: THE ENCHANTED ELVEN SANCTUARY (HOT 🎆)
   Magical Elven Forest, Enchanted Woodland & Celestial Fantasy
   Color Palette: Lavender, Violet, Midnight Blue, Emerald Green, Soft Pink, Moonlight Silver, Warm Gold
   ========================================================================== */

/* --- 1. Base Container & Viewport --- */
.view-hot-world {
  position: fixed;
  inset: 0;
  width: 100vw;
  height: 100vh;
  height: 100dvh;
  overflow: hidden;
  display: none;
  background-color: #0b0717;
  z-index: 50;
  user-select: none;
  font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
}

.view-hot-world.active {
  display: block;
}

.hot-world-viewport {
  position: relative;
  width: 100%;
  height: 100%;
  height: 100dvh;
  overflow: hidden;
}

/* --- 2. Background Scenery --- */
.hot-world-bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  background-image: url('/assets/hot_world_bg.jpg');
  background-size: cover;
  background-position: center center;
  background-repeat: no-repeat;
  transform-origin: center center;
  transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  z-index: 1;
}

/* Atmospheric Overlay: Soft violet starlight, emerald canopy mist, vignette */
.hot-world-overlay {
  position: absolute;
  inset: 0;
  background: 
    radial-gradient(circle at 68% 18%, rgba(192, 132, 252, 0.16) 0%, transparent 48%),
    radial-gradient(circle at 20% 75%, rgba(52, 211, 153, 0.08) 0%, transparent 45%),
    radial-gradient(circle at 50% 88%, rgba(244, 114, 182, 0.1) 0%, transparent 50%),
    linear-gradient(180deg, rgba(11, 7, 23, 0.32) 0%, rgba(11, 7, 23, 0.04) 40%, rgba(11, 7, 23, 0.55) 100%);
  pointer-events: none;
  z-index: 2;
}

/* Canvas FX for Floating Fireflies, Petals, Butterflies & Stardust */
.hot-fx-canvas {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 3;
}

/* --- 3. Top Header Bar --- */
.hot-top-header {
  position: absolute;
  top: 1.15rem;
  left: 1.5rem;
  right: 1.5rem;
  display: flex;
  justify-content: space-between;
  align-items: center;
  z-index: 10;
  pointer-events: none;
}

.hot-top-header > * {
  pointer-events: auto;
}

/* Left Header: Universe Brand */
.hot-header-left {
  display: flex;
  align-items: center;
  gap: 0.85rem;
  background: rgba(18, 11, 35, 0.72);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid rgba(192, 132, 252, 0.35);
  padding: 0.45rem 1.25rem 0.45rem 0.6rem;
  border-radius: 9999px;
  box-shadow: 0 8px 32px rgba(11, 7, 23, 0.6), 0 0 16px rgba(192, 132, 252, 0.2);
  transition: all 0.3s ease;
}

.hot-header-icon-wrap {
  width: 38px;
  height: 38px;
  border-radius: 50%;
  background: linear-gradient(135deg, rgba(192, 132, 252, 0.4), rgba(52, 211, 153, 0.35));
  border: 1.5px solid rgba(233, 213, 255, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.25rem;
  box-shadow: 0 0 12px rgba(192, 132, 252, 0.4);
}

.hot-header-text {
  display: flex;
  flex-direction: column;
}

.hot-world-title-wrap {
  display: flex;
  align-items: center;
  gap: 0.35rem;
  flex-wrap: wrap;
}

.hot-preview-badge {
  display: inline-flex;
  align-items: center;
  gap: 0.25rem;
  padding: 0.18rem 0.55rem;
  border-radius: 9999px;
  background: rgba(245, 158, 11, 0.22);
  border: 1px solid rgba(251, 191, 36, 0.6);
  color: #fde68a;
  font-size: 0.62rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  box-shadow: 0 0 10px rgba(245, 158, 11, 0.35);
