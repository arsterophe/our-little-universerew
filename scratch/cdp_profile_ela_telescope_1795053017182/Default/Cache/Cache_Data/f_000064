                ${q.claimed
                  ? `<span style="font-size: 0.8rem; color: #81c784; font-weight: 700;">✓ Selesai</span>`
                  : `<button type="button" class="btn-gh-action btn-claim-quest" data-quest-id="${q.id}" ${!canClaim ? 'disabled' : ''}>
                      ${canClaim ? '🎁 Klaim' : `${q.progress}/${q.target}`}
