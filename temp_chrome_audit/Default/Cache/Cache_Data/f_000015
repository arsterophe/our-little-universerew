  border: 1px solid rgba(168, 85, 247, 0.25);
  color: #cbd5e1;
  padding: 10px 14px;
  border-radius: 12px;
  font-size: 0.82rem;
  font-weight: 700;
  cursor: pointer;
  transition: all 0.25s ease;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
}

.pond-tab-btn:hover {
  background: rgba(168, 85, 247, 0.2);
  color: #ffffff;
}

.pond-tab-btn.active {
  background: linear-gradient(135deg, rgba(168, 85, 247, 0.35), rgba(56, 189, 248, 0.25));
  border-color: #c084fc;
  color: #ffffff;
  box-shadow: 0 4px 16px rgba(168, 85, 247, 0.25);
}

/* Main Content */
.pinwheel-pond-main-content {
  flex: 1;
  overflow-y: auto;
  position: relative;
  display: flex;
  flex-direction: column;
}

/* -------------------------------------------------------------------------- */
/* TAB 1: POND STAGE & ANIMATED WATER                                         */
/* -------------------------------------------------------------------------- */
.whispering-pond-stage {
  position: relative;
  width: 100%;
  height: 440px;
  border-radius: 20px;
  overflow: hidden;
  border: 1px solid rgba(168, 85, 247, 0.35);
  box-shadow: 0 12px 40px rgba(0, 0, 0, 0.6);
  background: #020617;
}

/* Stage Sky */
.pond-stage-sky {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 45%;
  background: linear-gradient(180deg, rgba(15, 23, 42, 0.8) 0%, rgba(30, 27, 75, 0.4) 100%);
  pointer-events: none;
}

.pond-stage-moon {
  position: absolute;
  top: 20px;
  right: 80px;
  width: 46px;
  height: 46px;
  border-radius: 50%;
  background: radial-gradient(circle, #fef08a 0%, #fde047 60%, rgba(254, 240, 138, 0) 100%);
  box-shadow: 0 0 28px rgba(253, 224, 71, 0.6);
}

.pond-stage-cloud {
  position: absolute;
  font-size: 1.8rem;
  opacity: 0.35;
  animation: cloudDrift 28s infinite linear;
}
.pond-stage-cloud.c1 { top: 25px; left: 10%; animation-duration: 34s; }
.pond-stage-cloud.c2 { top: 55px; left: 55%; animation-duration: 40s; }

@keyframes cloudDrift {
  0% { transform: translateX(0); }
  50% { transform: translateX(60px); }
  100% { transform: translateX(0); }
}

.pond-falling-petal {
  position: absolute;
  font-size: 1.1rem;
  animation: petalFall 8s infinite linear;
  opacity: 0.6;
}
.pond-falling-petal.fp1 { top: 10px; left: 30%; animation-duration: 9s; }
.pond-falling-petal.fp2 { top: 40px; left: 65%; animation-duration: 12s; animation-delay: 2s; }
.pond-falling-petal.fp3 { top: 20px; left: 80%; animation-duration: 10s; animation-delay: 4s; }

@keyframes petalFall {
  0% { transform: translate(0, 0) rotate(0deg); opacity: 0.8; }
  100% { transform: translate(-80px, 200px) rotate(360deg); opacity: 0; }
}

/* Water Surface */
.whispering-pond-water {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 65%;
  background: radial-gradient(circle at 60% 80%, rgba(30, 27, 75, 0.85) 0%, #030712 100%);
  border-top: 1px solid rgba(147, 197, 253, 0.35);
  box-shadow: inset 0 20px 40px rgba(56, 189, 248, 0.15);
  overflow: hidden;
}

.pond-water-shimmer {
  position: absolute;
  inset: 0;
  background: linear-gradient(90deg, transparent 0%, rgba(255, 255, 255, 0.05) 50%, transparent 100%);
  background-size: 200% 100%;
  animation: waterShimmer 8s infinite linear;
  pointer-events: none;
}

@keyframes waterShimmer {
  0% { background-position: -200% 0; }
  100% { background-position: 200% 0; }
}

/* Concentric Ripples */
.pond-water-ripple {
  position: absolute;
  border-radius: 50%;
  border: 1px solid rgba(147, 197, 253, 0.35);
  pointer-events: none;
  animation: rippleExpand 6s infinite ease-out;
}
.pond-water-ripple.r1 { top: 40%; left: 45%; width: 120px; height: 50px; animation-delay: 0s; }
.pond-water-ripple.r2 { top: 60%; left: 65%; width: 160px; height: 65px; animation-delay: 2.2s; }
.pond-water-ripple.r3 { top: 25%; left: 75%; width: 90px; height: 40px; animation-delay: 4.4s; }

@keyframes rippleExpand {
  0% { transform: scale(0.4); opacity: 0.8; }
  100% { transform: scale(2.2); opacity: 0; }
}

/* Swimming Fish Silhouettes in Pond */
.pond-swimming-fish {
  position: absolute;
  width: 32px;
  height: 12px;
  border-radius: 50%;
  background: rgba(249, 115, 22, 0.55);
  box-shadow: 0 0 12px rgba(249, 115, 22, 0.7);
  pointer-events: none;
  animation: fishSwimAround 14s infinite ease-in-out;
}
.pond-swimming-fish.fish-1 {
  top: 55%; left: 50%;
  background: rgba(251, 191, 36, 0.65);
  box-shadow: 0 0 14px rgba(251, 191, 36, 0.8);
  animation-duration: 16s;
}
.pond-swimming-fish.fish-2 {
  top: 35%; left: 65%;
  background: rgba(192, 132, 252, 0.6);
  box-shadow: 0 0 16px rgba(192, 132, 252, 0.8);
  animation-duration: 20s;
  animation-delay: -5s;
}
.pond-swimming-fish.fish-3 {
  top: 70%; left: 78%;
  background: rgba(56, 189, 248, 0.65);
  box-shadow: 0 0 15px rgba(56, 189, 248, 0.75);
  animation-duration: 18s;
  animation-delay: -9s;
}

@keyframes fishSwimAround {
  0% { transform: translate(0, 0) scaleX(1); }
  25% { transform: translate(40px, -15px) scaleX(1); }
  49% { transform: translate(80px, 10px) scaleX(1); }
  50% { transform: translate(80px, 10px) scaleX(-1); }
  75% { transform: translate(30px, 25px) scaleX(-1); }
  99% { transform: translate(0, 0) scaleX(-1); }
  100% { transform: translate(0, 0) scaleX(1); }
}

/* Floating Lotus Pads */
.pond-lotus-pad {
  position: absolute;
  font-size: 1.5rem;
  filter: drop-shadow(0 4px 6px rgba(0, 0, 0, 0.5));
  animation: padBob 4.5s infinite ease-in-out;
}
.pond-lotus-pad.lp2 { animation-delay: 1.5s; }
.pond-lotus-pad.lp3 { animation-delay: 2.8s; }
.pond-lotus-pad.lp4 { animation-delay: 3.5s; }

@keyframes padBob {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-5px); }
}

/* Bobber (Pelampung) */
.whispering-pond-bobber {
  position: absolute;
  top: 50%;
  left: 60%;
  width: 22px;
  height: 28px;
  transform: translate(-50%, -50%);
  z-index: 10;
  cursor: pointer;
}

.whispering-pond-bobber.cast {
  animation: bobberFloat 2s infinite ease-in-out;
}

@keyframes bobberFloat {
  0%, 100% { transform: translate(-50%, -50%) translateY(0); }
  50% { transform: translate(-50%, -50%) translateY(-4px); }
}

.whispering-pond-bobber.bite-tugging {
  animation: bobberTug 0.25s infinite alternate ease-in-out;
}

@keyframes bobberTug {
  0% { transform: translate(-50%, -50%) translateY(0) scale(1); }
  100% { transform: translate(-50%, -50%) translateY(14px) scale(0.92); }
}

.bobber-buoy {
  width: 14px;
  height: 20px;
  border-radius: 50% 50% 40% 40%;
  background: linear-gradient(180deg, #ef4444 0%, #ef4444 50%, #ffffff 50%, #ffffff 100%);
  border: 1.5px solid #0f172a;
  box-shadow: 0 4px 8px rgba(0, 0, 0, 0.4);
  margin: 0 auto;
}

.bobber-ripple {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 32px;
  height: 12px;
  border-radius: 50%;
  border: 1px solid rgba(255, 255, 255, 0.5);
  animation: bobberRipplePulse 1.4s infinite ease-out;
}

@keyframes bobberRipplePulse {
  0% { transform: translateX(-50%) scale(0.5); opacity: 0.9; }
  100% { transform: translateX(-50%) scale(1.6); opacity: 0; }
}

/* Bite Alert */
.whispering-pond-bite-alert {
  position: absolute;
  top: 32%;
  left: 60%;
  transform: translate(-50%, -50%);
  background: linear-gradient(135deg, #ef4444, #dc2626);
  color: #ffffff;
  padding: 8px 16px;
  border-radius: 999px;
  font-weight: 800;
  font-size: 0.88rem;
  letter-spacing: 0.05em;
  display: flex;
  align-items: center;
  gap: 6px;
  box-shadow: 0 0 24px rgba(239, 68, 68, 0.8);
  animation: bitePulse 0.4s infinite alternate;
  z-index: 15;
}

@keyframes bitePulse {
  0% { transform: translate(-50%, -50%) scale(0.95); }
  100% { transform: translate(-50%, -50%) scale(1.08); }
}

/* Wooden Pier on Left */
.whispering-pond-pier {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 250px;
  height: 160px;
  background: linear-gradient(135deg, #3f2a1d 0%, #291b12 100%);
  border-top: 3px solid #78350f;
  border-right: 3px solid #78350f;
  border-radius: 0 24px 0 0;
  box-shadow: 6px -6px 20px rgba(0, 0, 0, 0.6);
  z-index: 8;
  display: flex;
  align-items: flex-end;
  padding: 14px;
  box-sizing: border-box;
}

.pier-post {
  position: absolute;
  top: -30px;
  right: 18px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
}

.pier-pinwheel {
  font-size: 1.6rem;
  animation: pinwheelBreeze 3s infinite linear;
}

@keyframes pinwheelBreeze {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.pier-lantern {
  font-size: 1.4rem;
  filter: drop-shadow(0 0 10px rgba(251, 191, 36, 0.8));
}

/* Cat Companion on Dock */
.whispering-pond-cat-companion {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  cursor: pointer;
  transition: transform 0.2s ease;
}

.whispering-pond-cat-companion:hover {
  transform: scale(1.06);
}

.pond-cat-nametag {
  background: rgba(88, 28, 135, 0.85);
  color: #f3e8ff;
  border: 1px solid #c084fc;
  padding: 2px 8px;
  border-radius: 999px;
  font-size: 0.68rem;
  font-weight: 700;
  margin-bottom: 2px;
}

.pond-cat-visual {
  animation: catBreathe 3s infinite ease-in-out;
}

@keyframes catBreathe {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.03) translateY(-2px); }
}

.cat-dock-tail {
  transform-origin: 22px 56px;
  animation: catTailWag 2s infinite ease-in-out;
}

@keyframes catTailWag {
  0%, 100% { transform: rotate(-5deg); }
  50% { transform: rotate(15deg); }
}

.pond-cat-paw-indicator {
  position: absolute;
  right: -10px;
  bottom: 12px;
  font-size: 0.85rem;
  opacity: 0.7;
}

/* Speech Bubble */
.whispering-pond-cat-speech {
  position: absolute;
  top: -42px;
  left: 10px;
  background: rgba(15, 23, 42, 0.92);
  border: 1px solid rgba(192, 132, 252, 0.55);
  color: #f3e8ff;
  padding: 6px 12px;
  border-radius: 12px;
  font-size: 0.74rem;
  font-style: italic;
  max-width: 210px;
  white-space: normal;
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.5);
  pointer-events: none;
  opacity: 0;
  transform: translateY(6px);
  transition: all 0.3s ease;
  z-index: 12;
}

.whispering-pond-cat-speech.visible {
  opacity: 1;
  transform: translateY(0);
}

/* -------------------------------------------------------------------------- */
/* REEL SWEET-SPOT MINI-GAME PANEL                                            */
/* -------------------------------------------------------------------------- */
.fishing-reeling-minigame {
  position: absolute;
  inset: 0;
  z-index: 30;
  display: none;
  background: rgba(3, 7, 18, 0.78);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  align-items: center;
  justify-content: center;
}

.fishing-reeling-minigame.active {
  display: flex;
}

.reeling-minigame-card {
  width: 90%;
  max-width: 520px;
  background: linear-gradient(135deg, rgba(30, 27, 75, 0.95), rgba(15, 23, 42, 0.95));
  border: 2px solid #a855f7;
  border-radius: 20px;
  padding: 20px;
  box-shadow: 0 16px 50px rgba(168, 85, 247, 0.35);
  box-sizing: border-box;
  text-align: center;
}

.reeling-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8px;
}

.reeling-title {
  font-size: 0.95rem;
  font-weight: 800;
  color: #ffffff;
  letter-spacing: 0.04em;
}

.reeling-badge {
  font-size: 0.68rem;
  font-weight: 700;
  background: rgba(168, 85, 247, 0.25);
  color: #d8b4fe;
  padding: 3px 8px;
  border-radius: 999px;
  border: 1px solid rgba(192, 132, 252, 0.4);
}

.reeling-instruction {
  font-size: 0.8rem;
  color: #cbd5e1;
  margin-bottom: 16px;
  min-height: 22px;
}

/* Tension Track */
.reeling-track-container {
  position: relative;
  width: 100%;
  height: 48px;
  background: rgba(2, 6, 23, 0.85);
  border: 2px solid rgba(147, 197, 253, 0.4);
  border-radius: 999px;
  overflow: hidden;
  margin-bottom: 16px;
}

.reeling-sweet-spot {
  position: absolute;
  top: 0;
  bottom: 0;
  background: rgba(34, 197, 94, 0.35);
  border-left: 2px solid #22c55e;
  border-right: 2px solid #22c55e;
  box-shadow: inset 0 0 16px rgba(34, 197, 94, 0.5);
  transition: background 0.2s ease;
}

.fishing-reeling-minigame.in-zone .reeling-sweet-spot {
  background: rgba(34, 197, 94, 0.6);
  box-shadow: 0 0 20px rgba(34, 197, 94, 0.8);
}

.reeling-fish-indicator {
  position: absolute;
  top: 50%;
  transform: translate(-50%, -50%);
  font-size: 1.6rem;
  transition: transform 0.1s ease;
  z-index: 3;
}

.reeling-hook-cursor {
  position: absolute;
  top: 50%;
  transform: translate(-50%, -50%);
  font-size: 1.5rem;
  z-index: 2;
  filter: drop-shadow(0 0 8px rgba(168, 85, 247, 0.8));
}

/* Catch Progress Bar */
.reeling-catch-progress-wrap {
  margin-bottom: 16px;
  text-align: left;
}

.reeling-progress-label {
  display: flex;
  justify-content: space-between;
  font-size: 0.72rem;
  font-weight: 700;
  color: #d8b4fe;
  margin-bottom: 6px;
}

.reeling-progress-label .progress-sub {
  color: #94a3b8;
  font-weight: 500;
}

.reeling-progress-bar {
  width: 100%;
  height: 12px;
  background: rgba(15, 23, 42, 0.8);
  border-radius: 999px;
  overflow: hidden;
  border: 1px solid rgba(168, 85, 247, 0.35);
}

.reeling-progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #a855f7, #22c55e);
  border-radius: 999px;
  box-shadow: 0 0 12px rgba(34, 197, 94, 0.5);
  transition: width 0.1s linear;
}

/* Hold Button */
.btn-reeling-hold {
  width: 100%;
  padding: 14px;
  background: linear-gradient(135deg, #a855f7, #6366f1);
  color: #ffffff;
  border: 1px solid rgba(255, 255, 255, 0.3);
  border-radius: 14px;
  font-size: 0.96rem;
  font-weight: 800;
  cursor: pointer;
  box-shadow: 0 6px 20px rgba(168, 85, 247, 0.4);
  transition: all 0.15s ease;
  user-select: none;
  -webkit-user-select: none;
}

.btn-reeling-hold:active,
.btn-reeling-hold.holding {
  background: linear-gradient(135deg, #22c55e, #16a34a);
  box-shadow: 0 0 24px rgba(34, 197, 94, 0.6);
  transform: scale(0.98);
}

/* Stage Action Bar */
.pond-stage-action-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12px 18px;
  background: rgba(15, 23, 42, 0.65);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border: 1px solid rgba(168, 85, 247, 0.25);
  border-radius: 14px;
  margin-top: 12px;
}

.pond-stage-hints {
  display: flex;
  align-items: center;
  gap: 8px;
  color: #cbd5e1;
  font-size: 0.8rem;
}

.hint-bullet {
  color: #c084fc;
  font-size: 1rem;
}

.pinwheel-pond-action-btn {
  background: linear-gradient(135deg, #a855f7 0%, #6366f1 100%);
  color: #ffffff;
  border: 1px solid rgba(255, 255, 255, 0.3);
  padding: 12px 26px;
  border-radius: 12px;
  font-weight: 800;
  font-size: 0.92rem;
  cursor: pointer;
  box-shadow: 0 6px 20px rgba(168, 85, 247, 0.35);
  transition: all 0.25s ease;
  display: flex;
  align-items: center;
  gap: 8px;
  white-space: nowrap;
}

.pinwheel-pond-action-btn:hover:not(:disabled) {
  transform: translateY(-2px);
  box-shadow: 0 8px 25px rgba(168, 85, 247, 0.55);
}

.pinwheel-pond-action-btn:disabled {
  opacity: 0.65;
  cursor: not-allowed;
}

.pinwheel-pond-action-btn.btn-bite-active {
  background: linear-gradient(135deg, #ef4444, #f97316);
  box-shadow: 0 0 25px rgba(239, 68, 68, 0.8);
  animation: bitePulseBtn 0.4s infinite alternate;
}

@keyframes bitePulseBtn {
  0% { transform: scale(1); }
  100% { transform: scale(1.05); }
}

/* -------------------------------------------------------------------------- */
/* TAB 2: FISH COLLECTION (10 SLOTS)                                          */
/* -------------------------------------------------------------------------- */
.pond-collection-header-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16px;
}

.pond-section-title {
  margin: 0 0 4px 0;
  font-size: 1.05rem;
  font-weight: 800;
  color: #ffffff;
}

.pond-section-subtitle {
  margin: 0;
  font-size: 0.78rem;
  color: #94a3b8;
}

.pond-collection-total-badge {
  background: rgba(168, 85, 247, 0.25);
  border: 1px solid #c084fc;
  color: #f3e8ff;
  padding: 6px 14px;
  border-radius: 999px;
  font-size: 0.82rem;
  font-weight: 700;
}

.pond-fish-collection-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
  gap: 14px;
  padding-bottom: 24px;
}

.pond-fish-card {
  background: rgba(15, 23, 42, 0.75);
  border: 1px solid rgba(168, 85, 247, 0.25);
  border-radius: 16px;
  padding: 14px;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  transition: all 0.25s ease;
  position: relative;
  overflow: hidden;
}

.pond-fish-card:hover {
  transform: translateY(-3px);
  border-color: rgba(192, 132, 252, 0.5);
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
}

.pond-fish-card.undiscovered {
  opacity: 0.65;
  filter: grayscale(0.5);
}

.pond-fish-card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10px;
}

.pond-fish-rarity-pill {
  padding: 3px 8px;
  border-radius: 999px;
  font-size: 0.65rem;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.rarity-common {
  background: rgba(148, 163, 184, 0.2);
  color: #cbd5e1;
  border: 1px solid rgba(148, 163, 184, 0.4);
}
.rarity-rare {
  background: rgba(56, 189, 248, 0.2);
  color: #7dd3fc;
  border: 1px solid #38bdf8;
  box-shadow: 0 0 10px rgba(56, 189, 248, 0.2);
}
.rarity-epic {
  background: rgba(168, 85, 247, 0.25);
  color: #d8b4fe;
  border: 1px solid #c084fc;
  box-shadow: 0 0 12px rgba(168, 85, 247, 0.35);
}
.rarity-legendary {
  background: rgba(250, 204, 21, 0.2);
  color: #fde047;
  border: 1px solid #facc15;
  box-shadow: 0 0 16px rgba(250, 204, 21, 0.4);
}

.pond-fish-count-badge {
  font-size: 0.7rem;
  color: #94a3b8;
  font-weight: 600;
}

.pond-fish-card-visual {
  height: 90px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 10px;
  background: rgba(2, 6, 23, 0.4);
  border-radius: 12px;
}

.pond-fish-name {
  margin: 0;
  font-size: 0.95rem;
  font-weight: 800;
  color: #ffffff;
}

.pond-fish-localname {
  font-size: 0.74rem;
  color: #c084fc;
  font-weight: 600;
  margin-bottom: 6px;
}

.pond-fish-desc {
  font-size: 0.74rem;
  color: #94a3b8;
  line-height: 1.45;
  margin: 0 0 10px 0;
  flex: 1;
}

.pond-fish-meta-row {
  display: flex;
  justify-content: space-between;
  font-size: 0.7rem;
  padding: 3px 0;
  border-top: 1px solid rgba(255, 255, 255, 0.05);
}

.pond-fish-meta-row .meta-label {
  color: #64748b;
}

.pond-fish-meta-row .meta-val {
  color: #e2e8f0;
  font-weight: 600;
}

/* -------------------------------------------------------------------------- */
/* TAB 3: FISHING JOURNAL                                                     */
/* -------------------------------------------------------------------------- */
.pond-journal-stats-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12px;
  margin-bottom: 20px;
}

.journal-stat-card {
  background: rgba(15, 23, 42, 0.75);
  border: 1px solid rgba(168, 85, 247, 0.25);
  border-radius: 14px;
  padding: 12px 16px;
  display: flex;
  align-items: center;
  gap: 12px;
}

.journal-stat-card .stat-icon {
  font-size: 1.8rem;
}

.journal-stat-card .stat-val {
  display: block;
  font-size: 1.1rem;
  font-weight: 800;
  color: #ffffff;
}

.journal-stat-card .stat-label {
  display: block;
  font-size: 0.7rem;
  color: #94a3b8;
}

.pond-journal-history-list {
  display: flex;
  flex-direction: column;
  gap: 10px;
  padding-bottom: 24px;
}

.pond-journal-entry-card {
  background: rgba(15, 23, 42, 0.65);
  border: 1px solid rgba(168, 85, 247, 0.2);
  border-radius: 12px;
  padding: 10px 14px;
  display: flex;
  align-items: center;
  gap: 14px;
  transition: all 0.2s ease;
}

.pond-journal-entry-card:hover {
  background: rgba(30, 27, 75, 0.5);
  border-color: rgba(192, 132, 252, 0.4);
}

.entry-icon-col {
  width: 60px;
  height: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.entry-info-col {
  flex: 1;
}

.entry-header-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 4px;
}

.entry-fish-name {
  font-weight: 800;
  font-size: 0.88rem;
  color: #ffffff;
}

.entry-rarity-badge {
  font-size: 0.65rem;
  font-weight: 700;
  padding: 2px 8px;
  border-radius: 999px;
}

.entry-sub-row {
  font-size: 0.74rem;
  color: #cbd5e1;
  display: flex;
  gap: 8px;
  align-items: center;
}

.entry-time-row {
  font-size: 0.68rem;
  color: #64748b;
  margin-top: 2px;
}

.journal-empty-state {
  text-align: center;
  padding: 40px 20px;
  color: #94a3b8;
}

.journal-empty-state .empty-icon {
  font-size: 2.5rem;
  display: block;
  margin-bottom: 8px;
}

/* -------------------------------------------------------------------------- */
/* TAB 4: GEAR & SECRET AREAS                                                 */
/* -------------------------------------------------------------------------- */
.pond-gear-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  gap: 12px;
  margin-top: 10px;
}

.pond-gear-card {
  background: rgba(15, 23, 42, 0.75);
  border: 1px solid rgba(168, 85, 247, 0.25);
  border-radius: 14px;
  padding: 14px;
  display: flex;
  flex-direction: column;
  gap: 10px;
  transition: all 0.2s ease;
}

.pond-gear-card.equipped {
  border-color: #38bdf8;
  background: rgba(30, 27, 75, 0.65);
  box-shadow: 0 4px 18px rgba(56, 189, 248, 0.25);
}

.pond-gear-card.locked {
  opacity: 0.55;
  filter: grayscale(0.6);
}

.gear-card-icon {
  font-size: 1.8rem;
}

.gear-card-title {
  font-size: 0.92rem;
  font-weight: 800;
  color: #ffffff;
  margin-bottom: 4px;
}

.gear-card-desc {
  font-size: 0.75rem;
  color: #cbd5e1;
  line-height: 1.4;
  margin-bottom: 6px;
}

.gear-card-perks {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  font-size: 0.7rem;
  color: #38bdf8;
  font-weight: 700;
}

.gear-card-action {
  margin-top: auto;
}

.btn-gear-equip {
  width: 100%;
  padding: 8px;
  background: rgba(168, 85, 247, 0.2);
  border: 1px solid #c084fc;
  color: #ffffff;
  border-radius: 8px;
  font-weight: 700;
  font-size: 0.78rem;
  cursor: pointer;
  transition: all 0.2s ease;
}

.btn-gear-equip:hover {
  background: #a855f7;
}

.btn-gear-equip.btn-active {
  background: #38bdf8;
  border-color: #38bdf8;
  color: #0f172a;
}

.gear-locked-badge {
  display: block;
  text-align: center;
  font-size: 0.72rem;
  font-weight: 700;
  color: #ef4444;
  padding: 6px;
  background: rgba(239, 68, 68, 0.12);
  border-radius: 8px;
  border: 1px solid rgba(239, 68, 68, 0.3);
}

/* -------------------------------------------------------------------------- */
/* POPUPS & MODALS: CATCH & LEVEL UP                                          */
/* -------------------------------------------------------------------------- */
.fishing-catch-modal,
.fishing-levelup-modal {
  position: fixed;
  inset: 0;
  z-index: 13000;
  display: none;
  background: rgba(2, 6, 23, 0.85);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  align-items: center;
  justify-content: center;
  padding: 16px;
  box-sizing: border-box;
}

.fishing-catch-modal.active,
.fishing-levelup-modal.active {
  display: flex;
}

.fishing-catch-card,
.fishing-levelup-card {
  width: 100%;
  max-width: 440px;
  background: linear-gradient(135deg, #1e1b4b, #0f172a);
  border: 2px solid #a855f7;
  border-radius: 24px;
  padding: 24px;
  text-align: center;
  box-shadow: 0 20px 60px rgba(168, 85, 247, 0.45);
  box-sizing: border-box;
  animation: catchCardPopup 0.35s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}

@keyframes catchCardPopup {
  0% { transform: scale(0.85); opacity: 0; }
  100% { transform: scale(1); opacity: 1; }
}

.catch-new-species-banner {
  background: linear-gradient(90deg, #ec4899, #8b5cf6);
  color: #ffffff;
  padding: 5px 12px;
  border-radius: 999px;
  font-weight: 800;
  font-size: 0.74rem;
  letter-spacing: 0.08em;
  display: inline-block;
  margin-bottom: 12px;
  box-shadow: 0 0 16px rgba(236, 72, 153, 0.6);
}

.catch-new-record-banner {
  background: linear-gradient(90deg, #eab308, #f97316);
  color: #ffffff;
  padding: 4px 10px;
  border-radius: 999px;
  font-weight: 800;
  font-size: 0.72rem;
  display: inline-block;
  margin-bottom: 8px;
}

.catch-fish-icon-box {
  height: 110px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12px;
}

.catch-fish-rarity-badge {
  display: inline-block;
  font-size: 0.72rem;
  font-weight: 800;
  padding: 4px 12px;
  border-radius: 999px;
  margin-bottom: 6px;
}

.catch-fish-title {
  margin: 0;
  font-size: 1.4rem;
  font-weight: 900;
  color: #ffffff;
}

.catch-fish-localname {
  font-size: 0.85rem;
  color: #d8b4fe;
  font-weight: 600;
  margin-bottom: 4px;
}

.catch-fish-length {
  font-size: 1.15rem;
  font-weight: 800;
  color: #38bdf8;
  margin-bottom: 8px;
}

.catch-fish-desc {
  font-size: 0.78rem;
  color: #cbd5e1;
  font-style: italic;
  line-height: 1.45;
  margin: 0 0 14px 0;
}

.catch-exp-badge {
  display: inline-block;
  background: rgba(34, 197, 94, 0.2);
  border: 1px solid #22c55e;
  color: #4ade80;
  font-weight: 800;
  padding: 4px 14px;
  border-radius: 999px;
  font-size: 0.82rem;
  margin-bottom: 18px;
}

.catch-modal-actions {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.btn-catch-action {
  width: 100%;
  padding: 12px;
  border-radius: 12px;
  font-weight: 800;
  font-size: 0.88rem;
  cursor: pointer;
  transition: all 0.2s ease;
  border: none;
}

.btn-catch-action.primary {
  background: linear-gradient(135deg, #a855f7, #6366f1);
  color: #ffffff;
  box-shadow: 0 4px 18px rgba(168, 85, 247, 0.4);
}

.btn-catch-action.secondary {
  background: rgba(30, 27, 75, 0.8);
  border: 1px solid rgba(192, 132, 252, 0.4);
  color: #e9d5ff;
}

.btn-catch-action:hover {
  transform: translateY(-2px);
}

/* Level Up Card */
.levelup-sparkles {
  font-size: 2rem;
  margin-bottom: 8px;
}

.levelup-title {
  margin: 0 0 8px 0;
  font-size: 1.3rem;
  font-weight: 900;
  color: #fde047;
}

.levelup-badge {
  font-size: 0.95rem;
  font-weight: 800;
  color: #ffffff;
  margin-bottom: 8px;
}

.levelup-reward {
  font-size: 0.82rem;
  color: #a7f3d0;
  background: rgba(16, 185, 129, 0.15);
  border: 1px solid rgba(16, 185, 129, 0.4);
  padding: 8px 14px;
  border-radius: 10px;
  display: inline-block;
}

/* -------------------------------------------------------------------------- */
/* INTEGRATION: CAT GARDEN AQUARIUM PROP                                      */
/* -------------------------------------------------------------------------- */
.cat-prop-aquarium {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  position: relative;
  font-size: 1.5rem;
  cursor: pointer;
  animation: aquariumBob 4s infinite ease-in-out;
  filter: drop-shadow(0 4px 10px rgba(56, 189, 248, 0.4));
  transition: transform 0.2s ease;
}

.cat-prop-aquarium:hover {
  transform: scale(1.15);
}

.cat-aquarium-fish {
  position: absolute;
  font-size: 0.9rem;
  animation: aquariumFishSwim 2.5s infinite alternate ease-in-out;
}

@keyframes aquariumBob {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-4px); }
}

@keyframes aquariumFishSwim {
  0% { transform: translate(-3px, 1px) scaleX(1); }
  100% { transform: translate(3px, -2px) scaleX(-1); }
}

/* -------------------------------------------------------------------------- */
/* RESPONSIVE DESIGN (MOBILE & TABLET)                                        */
/* -------------------------------------------------------------------------- */
@media (max-width: 768px) {
  .pinwheel-whispering-pond-container {
    padding: 10px;
  }
  .pinwheel-pond-header {
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
  }
  .pinwheel-pond-header-stats {
    width: 100%;
    justify-content: space-between;
    flex-wrap: wrap;
  }
  .whispering-pond-stage {
    height: 360px;
  }
  .whispering-pond-pier {
    width: 200px;
    height: 130px;
  }
  .pond-journal-stats-grid {
    grid-template-columns: 1fr;
  }
  .pond-tab-btn {
    padding: 8px 10px;
    font-size: 0.74rem;
  }
}
