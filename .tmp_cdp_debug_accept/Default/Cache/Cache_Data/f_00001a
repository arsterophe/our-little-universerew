/* ==========================================================================
   KIDULT DREAM HOUSE — NYANYA ⭐ (UNIVERSE KIDULT)
   Cozy Dreamy Childhood Home — 2D Interactive Simulation Styles
   ========================================================================== */

:root {
  --kh-pink-primary: #f472b6;
  --kh-pink-soft: #fbcfe8;
  --kh-pink-deep: #db2777;
  --kh-lavender: #c084fc;
  --kh-lavender-soft: #e9d5ff;
  --kh-peach: #fed7aa;
  --kh-cream: #fef3c7;
  --kh-gold: #fbbf24;
  --kh-sage: #a7f3d0;
  --kh-dark: #1e1b4b;
  --kh-card-bg: rgba(30, 27, 75, 0.88);
  --kh-glass-border: rgba(244, 114, 182, 0.45);
  --kh-glow-pink: rgba(244, 114, 182, 0.4);
  --kh-glow-gold: rgba(251, 191, 36, 0.35);
}

/* Base View Container */
.view-kidult-house,
.view-everdream-house {
  position: fixed;
  inset: 0;
  width: 100vw;
  height: 100vh;
  background-color: #0f0a1c;
  color: #fdf2f8;
  font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
  z-index: 105;
  display: none;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  user-select: none;
  opacity: 0;
  transition: opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1);
}

.view-kidult-house.active,
.view-everdream-house.active {
  display: flex;
  opacity: 1;
}

/* 16:9 Simulation Stage */
.kidult-house-stage {
  position: relative;
  width: min(100vw, 177.78vh);
  height: min(56.25vw, 100vh);
  aspect-ratio: 16 / 9;
  background-color: #17112b;
  overflow: hidden;
  box-shadow: 0 0 60px rgba(0, 0, 0, 0.9), 0 0 35px var(--kh-glow-pink);
}

/* Background Room Image Layer */
.kidult-house-bg-layer {
  position: absolute;
  inset: 0;
  z-index: 1;
  pointer-events: none;
}

.kidult-house-bg-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  display: block;
  filter: brightness(0.98) contrast(1.04);
  transition: filter 0.8s ease, transform 0.8s ease;
}

/* Atmosphere Lighting Overlay */
.kidult-house-atmo-overlay {
  position: absolute;
  inset: 0;
  z-index: 2;
  pointer-events: none;
  background: radial-gradient(circle at 50% 30%, rgba(244, 114, 182, 0.12) 0%, rgba(30, 27, 75, 0.35) 60%, rgba(15, 10, 28, 0.7) 100%);
  mix-blend-mode: screen;
  transition: background 1s ease;
}

/* Drifting Fairy Stardust Particles */
.kidult-house-particles-layer {
  position: absolute;
  inset: 0;
  z-index: 3;
  pointer-events: none;
  overflow: hidden;
}

.kidult-house-star {
  position: absolute;
  color: var(--kh-pink-soft);
  font-size: 0.9rem;
  opacity: 0.75;
  animation: kidultStarDrift 14s infinite linear;
  text-shadow: 0 0 8px var(--kh-pink-primary);
}

.kidult-house-star.s1 { left: 14%; top: 22%; animation-delay: 0s; font-size: 0.8rem; }
.kidult-house-star.s2 { left: 42%; top: 16%; animation-delay: 3s; font-size: 1.15rem; color: var(--kh-gold); }
.kidult-house-star.s3 { left: 74%; top: 32%; animation-delay: 6s; font-size: 0.85rem; color: var(--kh-lavender); }
.kidult-house-star.s4 { left: 86%; top: 68%; animation-delay: 4.5s; font-size: 0.75rem; }
.kidult-house-star.s5 { left: 28%; top: 62%; animation-delay: 8s; font-size: 1rem; color: var(--kh-peach); }

@keyframes kidultStarDrift {
  0% { transform: translateY(0) rotate(0deg) scale(0.9); opacity: 0.2; }
  50% { transform: translateY(-24px) rotate(180deg) scale(1.15); opacity: 0.85; }
  100% { transform: translateY(-48px) rotate(360deg) scale(0.9); opacity: 0.2; }
}

/* Hotspots Layer */
.kidult-house-hotspots-layer {
  position: absolute;
  inset: 0;
  z-index: 10;
  pointer-events: none;
}

.kidult-house-hotspot-item {
  position: absolute;
  transform: translate(-50%, -50%);
  pointer-events: auto;
  background: none;
  border: none;
  cursor: pointer;
  padding: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  transition: transform 0.25s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}

.kidult-house-hotspot-item:hover,
.kidult-house-hotspot-item:focus-visible {
  transform: translate(-50%, -58%) scale(1.1);
  outline: none;
}

.kidult-house-hotspot-beacon {
  width: 44px;
  height: 44px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(244, 114, 182, 0.85) 0%, rgba(219, 39, 119, 0.9) 70%);
  border: 2px solid #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.3rem;
  color: #fff;
  box-shadow: 0 0 18px var(--kh-glow-pink), inset 0 0 8px rgba(255, 255, 255, 0.4);
  position: relative;
  animation: kidultBeaconPulse 3s infinite ease-in-out;
}

@keyframes kidultBeaconPulse {
  0%, 100% { box-shadow: 0 0 14px var(--kh-glow-pink), 0 0 25px rgba(244, 114, 182, 0.4); }
  50% { box-shadow: 0 0 24px rgba(251, 191, 36, 0.85), 0 0 40px rgba(244, 114, 182, 0.7); }
}

.kidult-house-hotspot-label {
  margin-top: 6px;
  background: rgba(30, 27, 75, 0.9);
  backdrop-filter: blur(8px);
  border: 1px solid var(--kh-glass-border);
  color: #fff;
  font-size: 0.74rem;
  font-weight: 700;
  padding: 3px 10px;
  border-radius: 12px;
  white-space: nowrap;
  box-shadow: 0 4px 14px rgba(0, 0, 0, 0.6);
  opacity: 0.92;
  transition: opacity 0.2s, border-color 0.2s, transform 0.2s;
}

.kidult-house-hotspot-item:hover .kidult-house-hotspot-label {
  opacity: 1;
  border-color: #fff;
  transform: translateY(-2px);
  color: var(--kh-gold);
}

/* 2D Player Avatar: Nyanya */
.kidult-house-player-avatar {
  position: absolute;
  left: 50%;
  top: 72%;
  width: 76px;
  height: 96px;
  transform: translate(-50%, -85%);
  z-index: 15;
  pointer-events: none;
  transition: transform 0.1s linear;
}

.kidult-house-player-avatar.facing-left .kidult-avatar-body {
  transform: scaleX(-1);
}

.kidult-house-player-avatar.is-walking .kidult-avatar-body {
  animation: kidultAvatarWalk 0.5s infinite alternate ease-in-out;
}

.kidult-house-player-avatar.is-sitting {
  transform: translate(-50%, -68%) scale(0.92);
}

@keyframes kidultAvatarWalk {
  0% { transform: translateY(0) rotate(-2deg); }
  100% { transform: translateY(-6px) rotate(2deg); }
}

.kidult-avatar-body {
  position: relative;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.kidult-avatar-img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  filter: drop-shadow(0 6px 12px rgba(0, 0, 0, 0.65));
}

.kidult-player-shadow {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 56px;
  height: 16px;
  background: radial-gradient(ellipse, rgba(0, 0, 0, 0.65) 0%, transparent 70%);
  border-radius: 50%;
  z-index: -1;
}

/* Proximity Interaction Prompt */
.kidult-house-interaction-prompt {
  position: absolute;
  top: -40px;
  left: 50%;
  transform: translateX(-50%) translateY(6px);
  background: linear-gradient(135deg, rgba(30, 27, 75, 0.95), rgba(76, 29, 149, 0.95));
  border: 1.5px solid var(--kh-pink-primary);
  color: #fff;
  padding: 5px 14px;
  border-radius: 18px;
  font-size: 0.78rem;
  font-weight: 700;
  white-space: nowrap;
  pointer-events: auto;
  cursor: pointer;
  box-shadow: 0 0 18px var(--kh-glow-pink);
  opacity: 0;
  transition: opacity 0.2s, transform 0.2s;
  z-index: 25;
}

.kidult-house-interaction-prompt.show {
  opacity: 1;
  transform: translateX(-50%) translateY(0);
}

.kidult-house-interaction-prompt:hover {
  border-color: var(--kh-gold);
  color: var(--kh-gold);
}

/* TOP-LEFT HUD */
.kidult-house-hud-topleft {
  position: absolute;
  top: 14px;
  left: 14px;
  z-index: 20;
  display: flex;
  align-items: center;
  gap: 12px;
  pointer-events: auto;
}

.kidult-house-back-orb {
  width: 44px;
  height: 44px;
  border-radius: 50%;
  background: rgba(30, 27, 75, 0.88);
  border: 1.5px solid var(--kh-pink-primary);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.3rem;
  cursor: pointer;
  backdrop-filter: blur(8px);
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.5);
  transition: all 0.25s ease;
}

.kidult-house-back-orb:hover {
  border-color: var(--kh-gold);
  color: var(--kh-gold);
  transform: scale(1.08);
  box-shadow: 0 0 16px var(--kh-glow-gold);
}

.kidult-house-title-badge {
  background: rgba(30, 27, 75, 0.88);
  border: 1px solid var(--kh-glass-border);
  padding: 6px 14px;
  border-radius: 14px;
  backdrop-filter: blur(8px);
}

.kidult-house-title-badge h2 {
  margin: 0;
  font-size: 1.05rem;
  font-weight: 700;
  color: #fff;
  display: flex;
  align-items: center;
  gap: 6px;
}

.kidult-house-title-badge span {
  font-size: 0.68rem;
  color: var(--kh-pink-soft);
  font-weight: 600;
  letter-spacing: 0.05em;
  text-transform: uppercase;
}

/* TOP-RIGHT HUD: Room Navigation Pills & Quick Tools */
.kidult-house-hud-topright {
  position: absolute;
  top: 14px;
  right: 14px;
  z-index: 20;
  display: flex;
  align-items: center;
  gap: 8px;
  pointer-events: auto;
}

.kidult-house-nav-pills {
  display: flex;
  gap: 6px;
  background: rgba(30, 27, 75, 0.88);
  padding: 4px;
  border-radius: 20px;
  border: 1px solid var(--kh-glass-border);
  backdrop-filter: blur(8px);
  max-width: 62vw;
  overflow-x: auto;
}

.kidult-house-room-btn {
  background: none;
  border: none;
  color: #e2e8f0;
  padding: 6px 12px;
  border-radius: 16px;
  font-size: 0.76rem;
  font-weight: 600;
  cursor: pointer;
  display: flex;
  align-items: center;
  gap: 6px;
  transition: all 0.2s ease;
  white-space: nowrap;
}

.kidult-house-room-btn:hover {
  color: #fff;
  background: rgba(244, 114, 182, 0.25);
}

.kidult-house-room-btn.active {
  background: linear-gradient(135deg, var(--kh-pink-deep), #9333ea);
  color: #fff;
  border: 1px solid var(--kh-pink-soft);
  box-shadow: 0 0 14px var(--kh-glow-pink);
}

.kidult-house-hud-quick-tools {
  display: flex;
  gap: 6px;
}

.kidult-house-tool-btn {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  background: rgba(30, 27, 75, 0.88);
  border: 1px solid var(--kh-glass-border);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.15rem;
  cursor: pointer;
  transition: all 0.2s ease;
  backdrop-filter: blur(8px);
}

.kidult-house-tool-btn:hover {
  border-color: var(--kh-gold);
  color: var(--kh-gold);
  transform: scale(1.08);
  box-shadow: 0 0 14px var(--kh-glow-gold);
}

/* Control Hint */
.kidult-house-hud-controls-hint {
  position: absolute;
  bottom: 12px;
  left: 14px;
  z-index: 20;
  background: rgba(30, 27, 75, 0.8);
  border: 1px solid var(--kh-glass-border);
  padding: 4px 12px;
  border-radius: 12px;
  font-size: 0.7rem;
  color: #e2e8f0;
  display: flex;
  align-items: center;
  gap: 6px;
}

.kidult-house-kbd-pill {
  background: rgba(76, 29, 149, 0.85);
  border: 1px solid rgba(255, 255, 255, 0.4);
  color: #fff;
  padding: 1px 6px;
  border-radius: 4px;
  font-weight: 700;
  font-size: 0.65rem;
}

/* Mobile Virtual Touch Controls */
.kidult-house-touch-controls {
  position: absolute;
  inset: 0;
  z-index: 25;
  pointer-events: none;
  display: none;
}

@media (pointer: coarse), (max-width: 900px) {
  .kidult-house-touch-controls {
    display: block;
  }
}

.kidult-house-dpad-grid {
  position: absolute;
  left: 20px;
  bottom: 24px;
  width: 126px;
  height: 126px;
  pointer-events: auto;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  grid-template-rows: repeat(3, 1fr);
  gap: 4px;
}

.kidult-house-dpad-btn {
  background: rgba(30, 27, 75, 0.85);
  border: 1px solid var(--kh-glass-border);
  color: #fff;
  border-radius: 8px;
  font-size: 1.1rem;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  touch-action: manipulation;
}

.kidult-house-dpad-btn:active {
  background: var(--kh-pink-primary);
  color: #fff;
}

.kidult-house-dpad-btn.dpad-up { grid-column: 2; grid-row: 1; }
.kidult-house-dpad-btn.dpad-left { grid-column: 1; grid-row: 2; }
.kidult-house-dpad-btn.dpad-center { grid-column: 2; grid-row: 2; background: rgba(76, 29, 149, 0.9); font-size: 0.9rem; border: none; }
.kidult-house-dpad-btn.dpad-right { grid-column: 3; grid-row: 2; }
.kidult-house-dpad-btn.dpad-down { grid-column: 2; grid-row: 3; }

.kidult-house-touch-action-btn {
  position: absolute;
  right: 24px;
  bottom: 30px;
  width: 64px;
  height: 64px;
  border-radius: 50%;
  pointer-events: auto;
  background: linear-gradient(135deg, var(--kh-pink-primary), var(--kh-pink-deep));
  border: 2px solid #fff;
  color: #fff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  font-size: 0.72rem;
  box-shadow: 0 0 20px var(--kh-glow-pink);
  cursor: pointer;
  touch-action: manipulation;
}

.kidult-house-touch-action-btn:active {
  transform: scale(0.94);
}

/* Modals & Dialogs */
.kidult-house-modal-backdrop {
  position: absolute;
  inset: 0;
  z-index: 50;
  background: rgba(15, 10, 28, 0.84);
  backdrop-filter: blur(10px);
  display: none;
  align-items: center;
  justify-content: center;
  padding: 20px;
  opacity: 0;
  transition: opacity 0.3s ease;
}

.kidult-house-modal-backdrop.active {
  display: flex;
  opacity: 1;
}

.kidult-house-modal-card {
  background: linear-gradient(145deg, #1e1b4b, #2e1065);
  border: 1.5px solid var(--kh-pink-primary);
  box-shadow: 0 0 45px rgba(0, 0, 0, 0.9), 0 0 25px var(--kh-glow-pink);
  border-radius: 20px;
  width: min(92vw, 680px);
  max-height: 85vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  position: relative;
  color: #fdf2f8;
}

.kidult-house-modal-header {
  padding: 16px 20px;
  border-bottom: 1px solid var(--kh-glass-border);
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(76, 29, 149, 0.5);
}

.kidult-house-modal-header h3 {
  margin: 0;
  font-size: 1.15rem;
  color: #fff;
  display: flex;
  align-items: center;
  gap: 8px;
}

.kidult-house-modal-close-btn {
  background: none;
  border: none;
  color: #fbcfe8;
  font-size: 1.4rem;
  cursor: pointer;
  line-height: 1;
  padding: 4px;
  transition: color 0.2s;
}

.kidult-house-modal-close-btn:hover {
  color: #fff;
}

.kidult-house-modal-body {
  padding: 20px;
  overflow-y: auto;
  flex: 1;
}

/* Modal Content Components */
.kidult-card-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
  gap: 12px;
}

.kidult-item-card {
  background: rgba(46, 16, 101, 0.6);
  border: 1px solid var(--kh-glass-border);
  border-radius: 14px;
  padding: 12px 14px;
  display: flex;
  flex-direction: column;
  gap: 6px;
  transition: all 0.2s ease;
}

.kidult-item-card:hover {
  border-color: var(--kh-gold);
  box-shadow: 0 0 16px var(--kh-glow-pink);
  transform: translateY(-2px);
}

.kidult-item-card-header {
  display: flex;
  align-items: center;
  gap: 10px;
}

.kidult-item-card-icon {
  font-size: 1.5rem;
  width: 38px;
  height: 38px;
  border-radius: 10px;
  background: rgba(76, 29, 149, 0.8);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px solid var(--kh-glass-border);
}

.kidult-item-card-title {
  margin: 0;
  font-size: 0.92rem;
  font-weight: 700;
  color: #fff;
}

.kidult-item-card-desc {
  font-size: 0.78rem;
  color: #fce7f3;
  line-height: 1.4;
  margin: 0;
}

/* Playable Toy Piano */
.kidult-piano-keyboard {
  display: flex;
  justify-content: center;
  gap: 6px;
  margin-top: 14px;
  padding: 14px;
  background: rgba(15, 10, 28, 0.7);
  border-radius: 14px;
  border: 1px solid var(--kh-glass-border);
}

.kidult-piano-key {
  width: 48px;
  height: 120px;
  background: linear-gradient(to bottom, #ffffff 0%, #fbcfe8 100%);
  border: 1.5px solid #db2777;
  border-radius: 0 0 8px 8px;
  cursor: pointer;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  padding-bottom: 10px;
  font-weight: 700;
  font-size: 0.8rem;
  color: #9d174d;
  box-shadow: 0 4px 8px rgba(0, 0, 0, 0.4);
  transition: transform 0.1s, background 0.1s;
}

.kidult-piano-key:active {
  transform: translateY(4px);
  background: #f472b6;
  color: #fff;
}

/* Sleep / Rest Transition Overlay */
.kidult-house-sleep-overlay {
  position: absolute;
  inset: 0;
  z-index: 40;
  background: rgba(15, 10, 28, 0.95);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 14px;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.8s ease;
}

.kidult-house-sleep-overlay.active {
  opacity: 1;
  pointer-events: auto;
}

.kidult-sleep-star {
  font-size: 3rem;
  animation: kidultSleepPulse 2s infinite ease-in-out;
}

@keyframes kidultSleepPulse {
  0%, 100% { transform: scale(0.9); filter: drop-shadow(0 0 10px var(--kh-gold)); }
  50% { transform: scale(1.15); filter: drop-shadow(0 0 25px var(--kh-gold)); }
}

.kidult-sleep-text {
  font-size: 1.1rem;
  font-weight: 600;
  color: var(--kh-pink-soft);
  text-align: center;
  max-width: 420px;
}
