/**
 * OUR LITTLE UNIVERSE — BEHIND THE ASH (RUBEN)
 * The Dragon's Den · Gothic Celestial Fantasy Narrative Experience
 * =============================================================================
 * Aesthetic: Midnight black, deep violet, cosmic purple, silver, lavender,
 *            ash grey, glowing embers, and soft moonlight white.
 */

/* =============================================================================
   1. FULLSCREEN OVERLAY & ATMOSPHERIC BACKDROP
   ============================================================================= */
.ash-behind-overlay {
  position: fixed;
  inset: 0;
  width: 100vw;
  height: 100vh;
  z-index: 10000;
  display: none !important;
  visibility: hidden !important;
  pointer-events: none !important;
  opacity: 0;
  background: radial-gradient(circle at 50% 20%, #1a0f2e 0%, #0d0718 60%, #05030a 100%);
  color: #f1f5f9;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", sans-serif;
  overflow: hidden;
  transition: opacity 0.4s cubic-bezier(0.16, 1, 0.3, 1);
}

.ash-behind-overlay.active {
  display: flex !important;
  visibility: visible !important;
  pointer-events: auto !important;
  opacity: 1;
}

body:has(#view-selection.active) .ash-behind-overlay,
body:has(#view-login.active) .ash-behind-overlay {
  display: none !important;
  visibility: hidden !important;
  pointer-events: none !important;
}

/* Atmospheric Layer: Floating Embers & Ash Dust */
.ash-behind-backdrop {
  position: absolute;
  inset: 0;
  background-image: 
    radial-gradient(circle at 20% 30%, rgba(168, 85, 247, 0.15) 0%, transparent 50%),
    radial-gradient(circle at 80% 70%, rgba(244, 114, 182, 0.12) 0%, transparent 60%),
    radial-gradient(circle at 50% 90%, rgba(99, 102, 241, 0.1) 0%, transparent 60%);
  z-index: 0;
  pointer-events: none;
}

/* Floating Particles (Embers, Crystals, Dragon Sparkles) */
.ash-behind-particles {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 1;
  overflow: hidden;
}

.ash-particle {
  position: absolute;
  font-size: 1rem;
  opacity: 0.35;
  user-select: none;
  animation: floatAshParticle 10s ease-in-out infinite alternate;
}

.ash-particle.p1 { top: 12%; left: 8%; animation-duration: 9s; font-size: 1.2rem; }
.ash-particle.p2 { top: 25%; right: 12%; animation-duration: 12s; font-size: 0.9rem; animation-delay: 1.5s; }
.ash-particle.p3 { bottom: 20%; left: 15%; animation-duration: 11s; font-size: 1.4rem; animation-delay: 3s; }
.ash-particle.p4 { bottom: 35%; right: 20%; animation-duration: 8s; font-size: 1rem; animation-delay: 2s; }
.ash-particle.p5 { top: 60%; left: 5%; animation-duration: 13s; font-size: 1.1rem; animation-delay: 4s; }
.ash-particle.p6 { top: 40%; right: 6%; animation-duration: 10s; font-size: 0.85rem; animation-delay: 0.5s; }

@keyframes floatAshParticle {
  0% { transform: translateY(0) scale(0.9) rotate(0deg); opacity: 0.25; }
  50% { transform: translateY(-24px) scale(1.1) rotate(15deg); opacity: 0.65; }
  100% { transform: translateY(-45px) scale(1) rotate(-10deg); opacity: 0.3; }
}

/* Bottom Ash Meadow Glow */
.ash-behind-glow-bottom {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 180px;
  background: linear-gradient(180deg, transparent 0%, rgba(22, 13, 41, 0.8) 60%, rgba(13, 7, 24, 0.98) 100%);
  pointer-events: none;
  z-index: 2;
}

/* =============================================================================
   2. MAIN OVERLAY CONTAINER & TOP HEADER
   ============================================================================= */
.ash-behind-container {
  position: relative;
  z-index: 10;
  display: flex;
  flex-direction: column;
  width: 100%;
  height: 100%;
  max-width: 1200px;
  margin: 0 auto;
  box-sizing: border-box;
}

/* Header Bar */
.ash-behind-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px 24px;
  background: rgba(15, 10, 26, 0.75);
  backdrop-filter: blur(16px);
  border-bottom: 1px solid rgba(196, 181, 253, 0.22);
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
  flex-shrink: 0;
}

.ash-behind-back-btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 8px 18px;
  border-radius: 9999px;
  background: rgba(46, 26, 71, 0.6);
  border: 1px solid rgba(196, 181, 253, 0.35);
  color: #e2e8f0;
  font-size: 0.9rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.25s ease;
}

.ash-behind-back-btn:hover {
  background: rgba(88, 28, 135, 0.8);
  border-color: #c4b5fd;
  color: #ffffff;
  transform: translateX(-3px);
  box-shadow: 0 0 15px rgba(168, 85, 247, 0.4);
}

.ash-behind-title-badge {
  display: flex;
  align-items: center;
  gap: 12px;
}

.ash-badge-icon {
  font-size: 1.8rem;
  filter: drop-shadow(0 0 10px rgba(196, 181, 253, 0.6));
  animation: dragonIconPulse 4s ease-in-out infinite alternate;
}

@keyframes dragonIconPulse {
  0% { transform: scale(1) rotate(0deg); }
  50% { transform: scale(1.1) rotate(6deg); }
  100% { transform: scale(1) rotate(0deg); }
}

.ash-badge-tag {
  display: block;
  font-size: 0.72rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: #c4b5fd;
  font-weight: 700;
}

.ash-badge-title {
  margin: 0;
  font-family: 'Cinzel', serif, Georgia;
  font-size: 1.35rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  background: linear-gradient(135deg, #ffffff 0%, #e2e8f0 40%, #c4b5fd 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.ash-behind-close-btn {
  background: transparent;
  border: 1px solid rgba(196, 181, 253, 0.25);
  color: #cbd5e1;
  width: 38px;
  height: 38px;
  border-radius: 50%;
  font-size: 1.1rem;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: all 0.25s ease;
}

.ash-behind-close-btn:hover {
  background: rgba(220, 38, 38, 0.25);
  border-color: #f87171;
  color: #ffffff;
  transform: rotate(90deg);
}

/* =============================================================================
   3. PROGRESS TRACK & 5-CHAPTER STEPPER NAVIGATION
   ============================================================================= */
.ash-behind-progress-track {
  width: 100%;
  height: 3px;
  background: rgba(255, 255, 255, 0.08);
  position: relative;
  flex-shrink: 0;
}

.ash-behind-progress-bar {
  height: 100%;
  width: 20%;
  background: linear-gradient(90deg, #7c3aed, #a855f7, #f472b6);
  box-shadow: 0 0 10px rgba(168, 85, 247, 0.8);
  transition: width 0.4s cubic-bezier(0.16, 1, 0.3, 1);
}

.ash-behind-nav {
  display: flex;
  align-items: stretch;
  background: rgba(13, 8, 22, 0.9);
  border-bottom: 1px solid rgba(196, 181, 253, 0.15);
  overflow-x: auto;
  scrollbar-width: none;
  flex-shrink: 0;
}

.ash-behind-nav::-webkit-scrollbar {
  display: none;
}

.ash-behind-tab-btn {
  flex: 1;
  min-width: 160px;
  padding: 12px 14px;
  background: transparent;
  border: none;
  border-bottom: 2px solid transparent;
  color: #94a3b8;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2px;
  cursor: pointer;
  transition: all 0.25s ease;
  user-select: none;
}

.ash-behind-tab-btn .tab-num {
  font-size: 0.72rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: #a78bfa;
}

.ash-behind-tab-btn .tab-title {
  font-size: 0.88rem;
  font-weight: 600;
  color: #cbd5e1;
  white-space: nowrap;
}

.ash-behind-tab-btn:hover {
  background: rgba(139, 92, 246, 0.08);
  color: #ffffff;
}

.ash-behind-tab-btn.active {
  background: rgba(139, 92, 246, 0.15);
  border-bottom-color: #c084fc;
  box-shadow: inset 0 -4px 12px rgba(192, 132, 252, 0.2);
}

.ash-behind-tab-btn.active .tab-title {
  color: #ffffff;
  font-weight: 700;
}

/* =============================================================================
   4. OPENING SCENE HERO CARD (THE DRAGON'S DEN SANCTUARY)
   ============================================================================= */
.ash-behind-intro {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24px;
  overflow-y: auto;
  box-sizing: border-box;
}

.ash-behind-intro-card {
  max-width: 780px;
  width: 100%;
  background: rgba(18, 12, 32, 0.85);
  backdrop-filter: blur(20px);
  border: 1px solid rgba(196, 181, 253, 0.3);
  border-radius: 28px;
  padding: 44px 38px;
  text-align: center;
  box-shadow: 
    0 24px 60px rgba(0, 0, 0, 0.65),
    0 0 35px rgba(168, 85, 247, 0.25),
    inset 0 0 20px rgba(196, 181, 253, 0.08);
  position: relative;
  overflow: hidden;
  animation: ashIntroFadeIn 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

@keyframes ashIntroFadeIn {
  from { opacity: 0; transform: translateY(20px) scale(0.97); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}

.ash-intro-ambient-moon {
  position: absolute;
  top: -80px;
  left: 50%;
  transform: translateX(-50%);
  width: 220px;
  height: 220px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(196, 181, 253, 0.35) 0%, rgba(139, 92, 246, 0.15) 50%, transparent 75%);
  filter: blur(25px);
  pointer-events: none;
  z-index: 0;
}

.ash-intro-dragon-silhouette {
  font-size: 3.5rem;
  margin-bottom: 12px;
  display: inline-block;
  filter: drop-shadow(0 0 16px rgba(196, 181, 253, 0.7));
  animation: dragonFloat 5s ease-in-out infinite alternate;
}

@keyframes dragonFloat {
  0% { transform: translateY(0) scale(1); }
  50% { transform: translateY(-10px) scale(1.05); }
  100% { transform: translateY(0) scale(1); }
}

.ash-intro-eyebrow {
  display: inline-block;
  font-size: 0.82rem;
  font-weight: 700;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: #c4b5fd;
  margin-bottom: 8px;
}

.ash-intro-main-title {
  font-family: 'Cinzel', serif, Georgia;
  font-size: 2.8rem;
  font-weight: 800;
  letter-spacing: 0.08em;
  margin: 0 0 8px 0;
  background: linear-gradient(135deg, #ffffff 0%, #e2e8f0 40%, #c4b5fd 80%, #f472b6 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.ash-intro-subtitle {
  font-size: 1.15rem;
  font-style: italic;
  color: #cbd5e1;
  margin-bottom: 24px;
}

.ash-intro-divider {
  width: 80px;
  height: 2px;
  background: linear-gradient(90deg, transparent, #c4b5fd, transparent);
  margin: 0 auto 24px auto;
}

.ash-intro-desc {
  font-size: 1.05rem;
  line-height: 1.75;
  color: #cbd5e1;
  max-width: 620px;
  margin: 0 auto 32px auto;
}

.ash-intro-desc strong {
  color: #f1f5f9;
}

.btn-ash-begin-journey {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 14px 34px;
  border-radius: 9999px;
  background: linear-gradient(135deg, #6d28d9 0%, #9333ea 50%, #db2777 100%);
  border: 1px solid rgba(255, 255, 255, 0.4);
  color: #ffffff;
  font-size: 1.05rem;
  font-weight: 700;
  letter-spacing: 0.05em;
  cursor: pointer;
  box-shadow: 0 8px 25px rgba(147, 51, 234, 0.45);
  transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
}

.btn-ash-begin-journey:hover {
  transform: translateY(-3px) scale(1.02);
  box-shadow: 0 12px 35px rgba(219, 39, 119, 0.55);
}

/* =============================================================================
   5. BOOK DECK & CHAPTER PANELS
   ============================================================================= */
.ash-behind-deck {
  flex: 1;
  position: relative;
  overflow: hidden;
  display: none;
}

.ash-behind-chapter-panel {
  position: absolute;
  inset: 0;
  overflow-y: auto;
  padding: 36px 32px 50px;
  box-sizing: border-box;
  display: none;
  opacity: 0;
  transition: opacity 0.35s ease;
}

.ash-behind-chapter-panel.active {
  display: block;
  opacity: 1;
  animation: ashChapterPanelIn 0.45s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

@keyframes ashChapterPanelIn {
  from { opacity: 0; transform: translateY(16px); }
  to { opacity: 1; transform: translateY(0); }
}

/* Chapter Headers */
.ash-behind-page-header {
  text-align: center;
  max-width: 820px;
  margin: 0 auto 34px;
}

.ash-chapter-badge {
  display: inline-block;
  padding: 4px 14px;
  border-radius: 999px;
  background: rgba(147, 51, 234, 0.2);
  border: 1px solid rgba(196, 181, 253, 0.35);
  color: #c4b5fd;
  font-size: 0.78rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  margin-bottom: 12px;
}

.ash-chapter-main-title {
  font-family: 'Cinzel', serif, Georgia;
  font-size: 2.3rem;
  font-weight: 700;
  letter-spacing: 0.05em;
  margin: 0 0 10px;
  color: #ffffff;
  text-shadow: 0 0 20px rgba(196, 181, 253, 0.4);
}

.ash-chapter-sub-title {
  font-size: 1.08rem;
  font-style: italic;
  color: #cbd5e1;
  margin: 0;
}

/* Two-Column Layout for Chapter 1-3 */
.ash-chapter-grid {
  display: grid;
  grid-template-columns: 1fr 340px;
  gap: 36px;
  max-width: 980px;
  margin: 0 auto;
  align-items: start;
}

.ash-text-column {
  font-size: 1.05rem;
  line-height: 1.85;
  color: #e2e8f0;
}

.ash-journal-p {
  margin: 0 0 20px;
}

.ash-journal-p.drop-cap::first-letter {
  font-family: 'Cinzel', serif;
  float: left;
  font-size: 3.4rem;
  line-height: 0.85;
  padding-top: 4px;
  padding-right: 10px;
  padding-bottom: 2px;
  color: #c4b5fd;
  font-weight: 700;
  text-shadow: 0 0 14px rgba(168, 85, 247, 0.6);
}

.ash-journal-highlight {
  margin: 28px 0;
  padding: 18px 24px;
  border-left: 3px solid #c084fc;
  background: rgba(139, 92, 246, 0.12);
  border-radius: 0 14px 14px 0;
  font-style: italic;
  font-size: 1.08rem;
  color: #f1f5f9;
  line-height: 1.65;
}

.ash-journal-quote {
  margin: 24px 0;
  padding: 16px 20px;
  background: rgba(22, 13, 41, 0.65);
  border: 1px solid rgba(196, 181, 253, 0.2);
  border-radius: 14px;
  font-size: 0.98rem;
  color: #e2e8f0;
  text-align: center;
  font-style: italic;
}

/* Side Profile Card */
.ash-char-profile-card {
  background: rgba(18, 12, 32, 0.85);
  backdrop-filter: blur(14px);
  border: 1px solid rgba(196, 181, 253, 0.25);
  border-radius: 20px;
  padding: 20px;
  box-shadow: 0 12px 35px rgba(0, 0, 0, 0.45);
}

.ash-portrait-frame {
  position: relative;
  border-radius: 16px;
  overflow: hidden;
  border: 1px solid rgba(196, 181, 253, 0.35);
  margin-bottom: 16px;
  box-shadow: 0 8px 20px rgba(0, 0, 0, 0.5);
}

.ash-portrait-img {
  width: 100%;
  height: auto;
  display: block;
  object-fit: cover;
  transition: transform 0.4s ease;
}

.ash-portrait-frame:hover .ash-portrait-img {
  transform: scale(1.04);
}

.ash-dragon-badge {
  position: absolute;
  bottom: 10px;
  left: 50%;
  transform: translateX(-50%);
  background: rgba(15, 10, 26, 0.85);
  backdrop-filter: blur(8px);
  border: 1px solid #c084fc;
  padding: 4px 14px;
  border-radius: 999px;
  font-size: 0.78rem;
  font-weight: 700;
  color: #ffffff;
  white-space: nowrap;
}

.ash-specs-list {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.ash-spec-row {
  display: flex;
  justify-content: space-between;
  font-size: 0.88rem;
  padding-bottom: 6px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
}

.ash-spec-row .spec-label {
  color: #94a3b8;
}

.ash-spec-row .spec-val {
  color: #e2e8f0;
  font-weight: 600;
}

/* =============================================================================
   6. CHAPTER IV: A LETTER FROM LELE (UNABRIDGED PERSONAL MANUSCRIPT)
   ============================================================================= */
.ash-manuscript-parchment {
  max-width: 820px;
  margin: 0 auto;
  background: rgba(22, 14, 38, 0.92);
  backdrop-filter: blur(20px);
  border: 1px solid rgba(196, 181, 253, 0.35);
  border-radius: 24px;
  padding: 46px 42px;
  box-shadow: 
    0 24px 60px rgba(0, 0, 0, 0.7),
    0 0 35px rgba(168, 85, 247, 0.2),
