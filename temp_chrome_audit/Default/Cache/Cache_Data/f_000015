/* ==========================================================================
   PINWHEEL — SYMA'S UNIVERSE: THE NINE TAILED SANCTUARY
   Gaya Visual & Layout: Presisi sesuai gambar referensi UI
   Warna: Violet, Lavender, Pink Sakura, Cahaya Bulan, Arsitektur Jepang Magis
   ========================================================================== */

/* 1. SECTION & STAGE CONTAINER */
.view-pinwheel-world {
  position: fixed;
  inset: 0;
  width: 100vw;
  height: 100vh;
  margin: 0;
  padding: 0;
  overflow: hidden;
  background-color: #0b0616;
  z-index: 40;
  display: none;
  font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
  user-select: none;
  -webkit-user-select: none;
}

.view-section.view-pinwheel-world.active,
.view-pinwheel-world.active {
  display: block !important;
  opacity: 1 !important;
  transform: none !important;
  animation: pinwheelWorldFadeIn 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

@keyframes pinwheelWorldFadeIn {
  0% { opacity: 0; transform: scale(1.02); }
  100% { opacity: 1; transform: scale(1); }
}

.pinwheel-2d-stage {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  overflow: hidden;
}

/* 2. BASE IMAGE (PRISTINE ARTWORK) */
.pinwheel-base-layer {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 1;
}

.pinwheel-scene-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  display: block;
}

.pinwheel-color-grade {
  position: absolute;
  inset: 0;
  background: radial-gradient(circle at 70% 18%, rgba(216, 180, 254, 0.08) 0%, rgba(11, 6, 22, 0.22) 70%),
              linear-gradient(180deg, rgba(11, 6, 22, 0.25) 0%, rgba(11, 6, 22, 0) 25%, rgba(11, 6, 22, 0.38) 100%);
  pointer-events: none;
}

/* 3. ATMOSPHERIC PARTICLES & CANVAS FX */
.pinwheel-magic-canvas {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  z-index: 2;
  pointer-events: none;
}

/* 4. TOP HEADER BAR (EXACT REFERENCE LAYOUT) */
.pinwheel-top-header {
  position: absolute;
  top: 18px;
  left: 24px;
  right: 24px;
  z-index: 12;
  display: flex;
  align-items: center;
  justify-content: space-between;
  pointer-events: none;
}

/* A. Top-Left: Universe Identity Badge */
.pinwheel-header-left {
  display: flex;
  align-items: center;
  gap: 12px;
  background: rgba(22, 11, 42, 0.78);
  border: 1px solid rgba(220, 180, 255, 0.42);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  padding: 8px 18px 8px 12px;
  border-radius: 999px;
  box-shadow: 0 8px 24px rgba(11, 5, 24, 0.6), 0 0 16px rgba(168, 85, 247, 0.35);
  pointer-events: auto;
}

.pinwheel-header-avatar-wrap {
  position: relative;
  width: 44px;
  height: 44px;
  border-radius: 50%;
  overflow: hidden;
  border: 1.5px solid rgba(220, 180, 255, 0.85);
  box-shadow: 0 0 14px rgba(192, 132, 252, 0.75), inset 0 0 8px rgba(147, 51, 234, 0.4);
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(22, 11, 42, 0.9);
}

.pinwheel-header-avatar {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.pinwheel-sakura-accent {
  font-size: 0.9rem;
  filter: drop-shadow(0 0 4px rgba(244, 114, 182, 0.8));
}

.pinwheel-header-titles {
  display: flex;
  flex-direction: column;
  line-height: 1.15;
}

.pinwheel-header-main-title {
  margin: 0;
  font-size: 1.05rem;
  font-weight: 800;
  letter-spacing: 0.08em;
  color: #ffffff;
  text-shadow: 0 0 10px rgba(216, 180, 254, 0.6);
}

.pinwheel-header-sub-title {
  margin: 2px 0 0 0;
  font-size: 0.72rem;
  font-weight: 600;
  letter-spacing: 0.08em;
  color: #e9d5ff;
}

/* B. Top-Center: Explore Universe & Story Buttons */
.pinwheel-header-center {
  display: flex;
  align-items: center;
  gap: 12px;
  pointer-events: auto;
}

.pinwheel-nav-pill-btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: rgba(22, 11, 42, 0.8);
  border: 1px solid rgba(220, 180, 255, 0.45);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  color: #f5f3ff;
  padding: 8px 20px;
  border-radius: 999px;
  font-size: 0.85rem;
  font-weight: 700;
  letter-spacing: 0.04em;
  cursor: pointer;
  transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  box-shadow: 0 6px 20px rgba(11, 5, 24, 0.5), 0 0 12px rgba(168, 85, 247, 0.25);
}

.pinwheel-nav-pill-btn:hover {
  background: rgba(76, 29, 149, 0.85);
  border-color: rgba(255, 255, 255, 0.75);
  color: #ffffff;
  transform: translateY(-2px);
  box-shadow: 0 8px 26px rgba(168, 85, 247, 0.55), 0 0 18px rgba(216, 180, 254, 0.6);
}

.pinwheel-nav-pill-btn .pill-icon {
  font-size: 1.05rem;
}

/* C. Top-Right: Profile & Settings Panel */
.pinwheel-header-right {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  pointer-events: auto;
}

.pinwheel-settings-btn {
  width: 42px;
  height: 42px;
  border-radius: 50%;
  background: rgba(22, 11, 42, 0.8);
  border: 1px solid rgba(220, 180, 255, 0.42);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  color: #f5f3ff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.15rem;
  cursor: pointer;
  transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  box-shadow: 0 6px 20px rgba(11, 5, 24, 0.5);
}

.pinwheel-settings-btn:hover {
  transform: rotate(45deg) scale(1.08);
  background: rgba(76, 29, 149, 0.85);
  border-color: rgba(255, 255, 255, 0.75);
  box-shadow: 0 0 18px rgba(192, 132, 252, 0.6);
}

/* 5. INTERACTIVE LOCATION BUTTONS (EXACT COORDINATES & REFERENCE STYLE) */
.pinwheel-locations-stage {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  z-index: 8;
  pointer-events: none;
}

.pinwheel-loc-btn {
  position: absolute;
  transform: translate(-50%, -50%);
  background: linear-gradient(90deg, rgba(25, 12, 48, 0.86) 0%, rgba(45, 18, 80, 0.86) 100%);
  border: 1.5px solid rgba(220, 180, 255, 0.55);
  border-radius: 999px;
  color: #ffffff;
  padding: 8px 18px;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-size: 0.84rem;
  font-weight: 700;
  letter-spacing: 0.03em;
  cursor: pointer;
  pointer-events: auto;
  box-shadow: 0 6px 22px rgba(11, 5, 24, 0.7), 0 0 16px rgba(168, 85, 247, 0.35);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  outline: none;
  white-space: nowrap;
}

.pinwheel-loc-btn:hover,
.pinwheel-loc-btn:focus-visible {
  background: linear-gradient(90deg, rgba(88, 28, 135, 0.95) 0%, rgba(126, 34, 206, 0.95) 100%);
  border-color: #ffffff;
  transform: translate(-50%, -50%) scale(1.08);
  box-shadow: 0 10px 30px rgba(11, 5, 24, 0.85), 0 0 24px rgba(216, 180, 254, 0.8);
  z-index: 15;
}

.pinwheel-loc-icon {
  font-size: 1.15rem;
  filter: drop-shadow(0 0 6px rgba(238, 210, 255, 0.8));
}

/* Exact Reference Coordinates */
