/* ==========================================================================
   CAT CARE SIMULATOR — PINWHEEL SANCTUARY STYLING
   ========================================================================== */

.pinwheel-catgarden-overlay {
  position: fixed;
  inset: 0;
  width: 100vw;
  height: 100vh;
  z-index: 60;
  display: none;
  background: radial-gradient(circle at 50% 15%, rgba(30, 16, 68, 0.98) 0%, rgba(14, 8, 36, 0.98) 55%, rgba(6, 3, 16, 0.99) 100%);
  backdrop-filter: blur(22px);
  -webkit-backdrop-filter: blur(22px);
  color: #f8fafc;
  font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
  overflow: hidden;
  animation: catGardenFadeIn 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

.pinwheel-catgarden-overlay.active {
  display: flex !important;
  flex-direction: column;
}

@keyframes catGardenFadeIn {
  from { opacity: 0; transform: scale(0.98); }
  to { opacity: 1; transform: scale(1); }
}

.pinwheel-catgarden-particles {
  position: absolute;
  inset: 0;
  pointer-events: none;
  overflow: hidden;
  z-index: 1;
}

.pinwheel-catgarden-particles .particle {
  position: absolute;
  font-size: 1.1rem;
  color: #d8b4fe;
  opacity: 0.35;
  filter: drop-shadow(0 0 6px rgba(216, 180, 254, 0.7));
  animation: catParticleFloat 10s infinite linear;
}

.pinwheel-catgarden-particles .p1 { top: 12%; left: 8%; animation-duration: 9s; }
.pinwheel-catgarden-particles .p2 { top: 68%; left: 14%; animation-duration: 12s; }
.pinwheel-catgarden-particles .p3 { top: 25%; right: 12%; animation-duration: 11s; }
.pinwheel-catgarden-particles .p4 { top: 78%; right: 9%; animation-duration: 13s; }
.pinwheel-catgarden-particles .p5 { top: 45%; left: 45%; animation-duration: 14s; }
.pinwheel-catgarden-particles .p6 { top: 88%; left: 75%; animation-duration: 10s; }

@keyframes catParticleFloat {
  0% { transform: translateY(0) rotate(0deg); opacity: 0.1; }
  50% { opacity: 0.6; transform: translateY(-40px) rotate(180deg); }
  100% { transform: translateY(-90px) rotate(360deg); opacity: 0; }
}

.pinwheel-catgarden-container {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  width: 100%;
  height: 100%;
  max-width: 1280px;
  margin: 0 auto;
  padding: 16px 24px;
  box-sizing: border-box;
}

/* Header */
.pinwheel-catgarden-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 14px;
  border-bottom: 1px solid rgba(216, 180, 254, 0.2);
  gap: 16px;
  flex-shrink: 0;
}

.pinwheel-catgarden-header-brand {
  display: flex;
  align-items: center;
  gap: 12px;
}

.catgarden-header-icon {
  font-size: 2rem;
  padding: 8px;
  border-radius: 14px;
  background: rgba(168, 85, 247, 0.2);
  border: 1.5px solid rgba(216, 180, 254, 0.4);
  box-shadow: 0 0 16px rgba(168, 85, 247, 0.35);
}

.catgarden-header-badge {
  font-size: 0.72rem;
  letter-spacing: 0.08em;
  color: #c084fc;
  font-weight: 800;
  text-transform: uppercase;
}

.catgarden-header-title {
  margin: 2px 0 0 0;
  font-size: 1.35rem;
  font-weight: 800;
  color: #ffffff;
  display: flex;
  align-items: center;
  gap: 8px;
}

.catgarden-header-catname {
  color: #fbbf24;
  text-shadow: 0 0 12px rgba(251, 191, 36, 0.4);
}

/* Navigation Tabs */
.catgarden-nav-tabs {
  display: flex;
  gap: 8px;
  background: rgba(22, 11, 46, 0.75);
  padding: 5px;
  border-radius: 999px;
  border: 1px solid rgba(216, 180, 254, 0.25);
}

.catgarden-tab-btn {
  background: transparent;
  border: none;
  color: #cbd5e1;
  padding: 8px 16px;
  border-radius: 999px;
  font-size: 0.84rem;
  font-weight: 700;
  cursor: pointer;
  display: flex;
  align-items: center;
  gap: 6px;
  transition: all 0.25s ease;
}

.catgarden-tab-btn:hover {
  color: #ffffff;
  background: rgba(168, 85, 247, 0.2);
}

.catgarden-tab-btn.active {
  color: #ffffff;
  background: linear-gradient(135deg, #7c3aed, #0284c7);
  box-shadow: 0 4px 14px rgba(124, 58, 237, 0.4);
  border: 1px solid #c084fc;
}

.pinwheel-catgarden-close-btn {
  background: rgba(255, 255, 255, 0.08);
  border: 1px solid rgba(216, 180, 254, 0.3);
  color: #ffffff;
  width: 38px;
  height: 38px;
  border-radius: 50%;
  font-size: 1.1rem;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
}

.pinwheel-catgarden-close-btn:hover {
  background: rgba(244, 63, 94, 0.3);
  border-color: #f43f5e;
  transform: rotate(90deg);
}

/* Main Content Area */
.pinwheel-catgarden-main {
  flex: 1;
  overflow-y: auto;
  overflow-x: hidden;
  padding: 14px 4px;
}

.catgarden-panel {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

/* ==========================================================================
   TAB 1: SANCTUARY STAGE & CARE
   ========================================================================== */

.cat-sanctuary-stage {
  position: relative;
  height: 290px;
  border-radius: 20px;
  background: linear-gradient(180deg, rgba(32, 16, 72, 0.8) 0%, rgba(18, 9, 44, 0.95) 75%, rgba(30, 20, 56, 1) 100%);
  border: 1.5px solid rgba(216, 180, 254, 0.35);
  box-shadow: 0 10px 30px rgba(8, 4, 20, 0.6), inset 0 0 40px rgba(168, 85, 247, 0.15);
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cat-stage-sky-fx {
  position: absolute;
  inset: 0;
  pointer-events: none;
}

.cat-stage-cloud {
  position: absolute;
  font-size: 2.4rem;
  opacity: 0.2;
}

.cat-stage-cloud.c1 { top: 12%; left: 8%; animation: stageCloudDrift 30s infinite linear; }
.cat-stage-cloud.c2 { top: 22%; right: 14%; animation: stageCloudDrift 38s infinite linear reverse; }

@keyframes stageCloudDrift {
  0% { transform: translateX(0); }
  50% { transform: translateX(40px); }
  100% { transform: translateX(0); }
}

.cat-scenery-props {
  position: absolute;
  inset: 0;
  pointer-events: none;
}

.cat-prop-house {
  position: absolute;
  left: 36px;
  bottom: 40px;
  font-size: 3.5rem;
  filter: drop-shadow(0 4px 10px rgba(0, 0, 0, 0.4));
  opacity: 0.9;
}

.cat-prop-cushion {
  position: absolute;
  right: 50px;
  bottom: 38px;
  font-size: 2.6rem;
  opacity: 0.9;
}

.cat-prop-foodbowl {
  position: absolute;
  left: 140px;
  bottom: 26px;
  font-size: 1.8rem;
}

.cat-prop-fountain {
  position: absolute;
  right: 140px;
  bottom: 30px;
  font-size: 2.2rem;
}

.cat-prop-pinwheel {
  position: absolute;
  right: 32px;
  top: 36px;
  font-size: 2.4rem;
  animation: pinwheelTurn 8s infinite linear;
}

@keyframes pinwheelTurn {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

/* Dynamic Speech Bubble */
.cat-speech-bubble-wrap {
  position: absolute;
  top: 26px;
  left: 50%;
  transform: translateX(-50%);
  z-index: 10;
  pointer-events: none;
}

.cat-speech-bubble {
  background: rgba(15, 7, 32, 0.88);
  border: 1.5px solid rgba(216, 180, 254, 0.6);
  color: #fdf4ff;
  padding: 8px 18px;
  border-radius: 999px;
  font-size: 0.86rem;
  font-weight: 600;
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.5), 0 0 12px rgba(168, 85, 247, 0.4);
  white-space: nowrap;
  animation: catBubbleBob 3s infinite ease-in-out;
}

@keyframes catBubbleBob {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-6px); }
}

/* Center Interactive Cat */
.cat-center-avatar-wrap {
  position: relative;
  z-index: 5;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.2s ease;
  user-select: none;
}

.cat-center-avatar-wrap:hover {
  transform: scale(1.08);
}

.cat-center-avatar-wrap:active {
  transform: scale(0.96);
}

.cat-chibi-svg {
  filter: drop-shadow(0 6px 14px rgba(15, 7, 32, 0.5));
}

.cat-tail-anim {
  transform-origin: 68px 95px;
  animation: catWagTail 2.8s infinite ease-in-out;
}

@keyframes catWagTail {
  0%, 100% { transform: rotate(0deg); }
  50% { transform: rotate(14deg); }
}

.nine-tails-aura {
  animation: nineTailsGlow 3s infinite ease-in-out;
}

@keyframes nineTailsGlow {
  0%, 100% { opacity: 0.75; transform: scale(1); }
  50% { opacity: 1; transform: scale(1.05); }
}

/* Stage Ground */
.cat-stage-ground {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 38px;
  background: linear-gradient(180deg, rgba(76, 29, 149, 0.5) 0%, rgba(46, 16, 101, 0.85) 100%);
  border-top: 1px solid rgba(216, 180, 254, 0.25);
  display: flex;
  align-items: center;
  justify-content: space-around;
  pointer-events: none;
}

.cat-stage-ground .flower-dec {
  font-size: 1.1rem;
  opacity: 0.75;
}

/* Resident Adult Cats */
.cat-garden-residents-layer {
  position: absolute;
  inset: 0;
  pointer-events: auto;
}

.cat-resident-bubble {
  position: absolute;
  cursor: pointer;
  display: flex;
  flex-direction: column;
  align-items: center;
  transition: transform 0.25s ease;
  z-index: 4;
}

.cat-resident-bubble:hover {
  transform: scale(1.15) translateY(-4px);
}

.resident-tag {
  font-size: 0.65rem;
  background: rgba(15, 7, 32, 0.85);
  color: #fbbf24;
  padding: 2px 6px;
  border-radius: 999px;
  border: 1px solid rgba(251, 191, 36, 0.5);
  margin-top: 2px;
  white-space: nowrap;
}

/* Floating Effects & Feedback */
.cat-floating-pill {
  position: absolute;
  transform: translate(-50%, -50%);
  background: linear-gradient(135deg, #7c3aed, #0284c7);
  color: #ffffff;
  padding: 6px 14px;
  border-radius: 999px;
  border: 1.5px solid #ffffff;
  font-size: 0.88rem;
  font-weight: 800;
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.4), 0 0 16px rgba(124, 58, 237, 0.7);
  pointer-events: none;
  z-index: 25;
  animation: floatUpPill 1.2s forwards ease-out;
}

@keyframes floatUpPill {
  0% { opacity: 0; transform: translate(-50%, -30%) scale(0.8); }
  25% { opacity: 1; transform: translate(-50%, -60%) scale(1.1); }
  100% { opacity: 0; transform: translate(-50%, -120%) scale(1); }
}

