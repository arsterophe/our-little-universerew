}

/* --- 4. Left Minimalist Character Identity & Mood (Natural Floating Elven Style, Like Lele) --- */
.hot-profile-sidebar {
  position: absolute;
  top: 4.8rem;
  left: 1.5rem;
  width: auto;
  max-width: 380px;
  background: transparent;
  backdrop-filter: none;
  -webkit-backdrop-filter: none;
  border: none;
  border-radius: 0;
  padding: 0;
  box-shadow: none;
  z-index: 10;
  color: #f3e8ff;
  display: flex;
  flex-direction: column;
  gap: 0.45rem;
  pointer-events: auto;
  transition: all 0.3s ease;
}

.hot-profile-sidebar:hover {
  border: none;
  box-shadow: none;
}

.hot-profile-main-row {
  display: flex;
  align-items: center;
  gap: 0.85rem;
}

.hot-profile-avatar-wrap {
  position: relative;
  width: 58px;
  height: 58px;
  border-radius: 50%;
  padding: 2.5px;
  background: linear-gradient(135deg, #c084fc, #34d399, #f472b6);
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.45), 0 0 16px rgba(192, 132, 252, 0.55);
