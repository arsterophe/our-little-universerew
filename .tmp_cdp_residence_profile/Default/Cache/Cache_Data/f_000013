/* --- 6. Bottom Interface Bar --- */
.hot-bottom-bar {
  position: absolute;
  bottom: clamp(0.75rem, 2vh, 1.25rem);
  left: clamp(1rem, 2vw, 1.5rem);
  right: clamp(1rem, 2vw, 1.5rem);
  display: flex;
  justify-content: space-between;
  align-items: center;
  z-index: 10;
  pointer-events: none;
  gap: clamp(0.75rem, 1.5vw, 1.25rem);
}

.hot-bottom-bar > * {
  pointer-events: auto;
}

/* Bottom Left: Web Audio API Music Player */
.hot-music-player {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  background: rgba(18, 11, 35, 0.75);
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
  border: 1px solid rgba(192, 132, 252, 0.35);
  border-radius: 9999px;
  padding: 0.38rem 1rem 0.38rem 0.55rem;
  box-shadow: 0 8px 32px rgba(11, 7, 23, 0.6), 0 0 16px rgba(192, 132, 252, 0.2);
  min-width: 250px;
  max-width: 310px;
  flex-shrink: 0;
}

.hot-music-disc {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  background: linear-gradient(135deg, #1e1138, #3b1968);
  border: 1.5px solid #c084fc;
