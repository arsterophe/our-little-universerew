  box-shadow: 0 8px 24px rgba(11, 7, 23, 0.8), 0 0 20px rgba(192, 132, 252, 0.5);
  transform: translateY(-3px) scale(1.08);
}

.hot-big-action-label {
  font-size: 0.66rem;
  font-weight: 600;
  letter-spacing: 0.03em;
  color: #d8b4fe;
}

/* --- 7. Sub-Modals & Interactive Dialogs --- */
.hot-modal-overlay {
  position: fixed;
  inset: 0;
  width: 100vw;
  height: 100vh;
  background: rgba(7, 4, 15, 0.75);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s ease;
  padding: 1.5rem;
}

.hot-modal-overlay.open {
  opacity: 1;
  pointer-events: auto;
}

.hot-modal-card {
  width: 100%;
  max-width: 580px;
  background: linear-gradient(145deg, rgba(22, 13, 44, 0.94), rgba(13, 8, 27, 0.96));
  border: 1px solid rgba(192, 132, 252, 0.45);
  border-radius: 22px;
  box-shadow: 0 24px 64px rgba(7, 4, 15, 0.85), 0 0 40px rgba(192, 132, 252, 0.25);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  max-height: 88vh;
  transform: scale(0.94) translateY(12px);
  transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  color: #f3e8ff;
}

.hot-modal-overlay.open .hot-modal-card {
  transform: scale(1) translateY(0);
}

.hot-modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 1.15rem 1.4rem;
  border-bottom: 1px solid rgba(192, 132, 252, 0.2);
  background: rgba(30, 18, 58, 0.45);
}

.hot-modal-header-left {
  display: flex;
  align-items: center;
  gap: 0.85rem;
}

.hot-modal-icon-badge {
  width: 44px;
  height: 44px;
  border-radius: 14px;
  background: linear-gradient(135deg, rgba(192, 132, 252, 0.35), rgba(52, 211, 153, 0.3));
  border: 1px solid rgba(233, 213, 255, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.35rem;
  box-shadow: 0 0 14px rgba(192, 132, 252, 0.3);
}

.hot-modal-tag {
  font-size: 0.65rem;
  font-weight: 700;
  letter-spacing: 0.12em;
  color: #34d399;
  text-transform: uppercase;
}

.hot-modal-title {
  font-family: 'Cinzel', 'Playfair Display', serif;
  font-size: 1.15rem;
  font-weight: 700;
  color: #ffffff;
  margin: 0.1rem 0 0;
}

.hot-modal-close-btn {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
  border: none;
  color: #e9d5ff;
  font-size: 1.05rem;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
}

.hot-modal-close-btn:hover {
  background: rgba(239, 68, 68, 0.8);
  color: #fff;
}

.hot-modal-body {
  padding: 1.25rem 1.4rem;
  overflow-y: auto;
  line-height: 1.5;
  font-size: 0.85rem;
  color: #e2d4f8;
}

.hot-modal-body::-webkit-scrollbar {
  width: 6px;
}
.hot-modal-body::-webkit-scrollbar-thumb {
  background: rgba(192, 132, 252, 0.4);
  border-radius: 9999px;
}

.hot-form-group {
  margin-bottom: 1rem;
}

.hot-form-label {
  display: block;
  font-size: 0.75rem;
  font-weight: 600;
  color: #c4b5fd;
  margin-bottom: 0.4rem;
}

.hot-input,
.hot-select,
.hot-textarea {
  width: 100%;
  background: rgba(11, 7, 23, 0.6);
  border: 1px solid rgba(192, 132, 252, 0.3);
  border-radius: 10px;
  padding: 0.55rem 0.8rem;
  color: #fff;
  font-family: inherit;
  font-size: 0.82rem;
  outline: none;
  transition: border-color 0.2s ease;
}

.hot-input:focus,
.hot-select:focus,
.hot-textarea:focus {
  border-color: #c084fc;
  box-shadow: 0 0 12px rgba(192, 132, 252, 0.35);
}

.hot-primary-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.45rem;
  width: 100%;
  padding: 0.65rem 1.2rem;
  border-radius: 12px;
  background: linear-gradient(135deg, #9333ea, #6b21a8);
  border: 1px solid rgba(233, 213, 255, 0.5);
  color: #fff;
  font-weight: 600;
  font-size: 0.85rem;
  cursor: pointer;
  transition: all 0.25s ease;
  box-shadow: 0 4px 18px rgba(147, 51, 234, 0.4);
  margin-top: 0.5rem;
}

.hot-primary-btn:hover {
  background: linear-gradient(135deg, #a855f7, #7e22ce);
  box-shadow: 0 6px 24px rgba(168, 85, 247, 0.6);
  transform: translateY(-1px);
}

.hot-secondary-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.35rem;
  padding: 0.45rem 0.85rem;
  border-radius: 8px;
  background: rgba(192, 132, 252, 0.18);
  border: 1px solid rgba(192, 132, 252, 0.35);
  color: #f3e8ff;
  font-size: 0.78rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s ease;
}

.hot-secondary-btn:hover {
  background: rgba(192, 132, 252, 0.35);
  border-color: #c084fc;
}

/* Feature Specific: Gecko Sanctuary */
.hot-gecko-card {
  background: rgba(22, 13, 44, 0.65);
  border: 1px solid rgba(52, 211, 153, 0.35);
  border-radius: 14px;
  padding: 1rem;
  margin-bottom: 1rem;
}

.hot-gecko-status-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 0.5rem;
  margin-bottom: 0.85rem;
}

.hot-gecko-stat-box {
  background: rgba(11, 7, 23, 0.7);
  border-radius: 8px;
  padding: 0.45rem;
  text-align: center;
}

.hot-gecko-stat-val {
  font-weight: 700;
  color: #34d399;
  font-size: 0.82rem;
}

.hot-gecko-stat-lbl {
  font-size: 0.65rem;
  color: #c4b5fd;
}

.hot-gecko-actions {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 0.5rem;
}

/* Grid Collection Items */
.hot-items-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(110px, 1fr));
  gap: 0.75rem;
  margin-top: 0.6rem;
}

.hot-item-cell {
  background: rgba(11, 7, 23, 0.65);
  border: 1px solid rgba(192, 132, 252, 0.25);
  border-radius: 12px;
  padding: 0.75rem 0.5rem;
  text-align: center;
  transition: all 0.2s ease;
}

.hot-item-cell:hover {
  border-color: #c084fc;
  box-shadow: 0 0 14px rgba(192, 132, 252, 0.3);
  transform: translateY(-2px);
}

.hot-item-icon {
  font-size: 1.6rem;
  margin-bottom: 0.35rem;
}

.hot-item-name {
  font-size: 0.72rem;
  font-weight: 600;
  color: #fff;
}

.hot-item-desc {
  font-size: 0.62rem;
  color: #c4b5fd;
  margin-top: 0.15rem;
}

/* --- 8. Responsive Design Breakpoints --- */
@media (max-width: 1024px) {
  .hot-top-header {
    top: 1rem;
    left: 1rem;
    right: 1rem;
  }
  .hot-profile-sidebar {
    top: 4.5rem;
    left: 1rem;
    max-width: 340px;
  }
  .hot-bottom-bar {
    bottom: 0.85rem;
    left: 1rem;
    right: 1rem;
  }
}

/* Laptop and Low-Height Viewports (e.g. 1366x768, 1280x720, 1920x800) */
@media (max-height: 800px) {
  .hot-top-header {
    top: 0.65rem;
    left: 1rem;
    right: 1rem;
  }
  .hot-profile-sidebar {
    top: 3.8rem;
    left: 1rem;
  }
  .hot-bottom-bar {
    bottom: 0.65rem;
    left: 1rem;
    right: 1rem;
    gap: 0.65rem;
  }
  .hot-music-player {
    min-width: 230px;
    max-width: 270px;
    padding: 0.3rem 0.75rem 0.3rem 0.5rem;
    gap: 0.5rem;
  }
  .hot-music-disc {
    width: 32px;
    height: 32px;
    font-size: 0.95rem;
  }
  .hot-music-title {
    font-size: 0.74rem;
  }
  .hot-music-sub {
    font-size: 0.62rem;
  }
  .hot-music-ctrl-btn {
    width: 26px;
    height: 26px;
    font-size: 0.72rem;
  }
  .hot-tagline-panel {
    padding: 0.25rem 0.85rem;
    max-width: 340px;
  }
  .hot-tagline-main {
    font-size: 1.15rem;
  }
  .hot-tagline-sub {
    font-size: 0.62rem;
  }
  .hot-big-action-circle {
    width: 36px;
    height: 36px;
    font-size: 1rem;
  }
  .hot-big-action-label {
    font-size: 0.62rem;
  }
  .hot-loc-btn {
    padding: 0.35rem 0.75rem;
    font-size: 0.74rem;
  }
}

@media (max-width: 768px) {
  .hot-top-header {
    top: 0.65rem;
    left: 0.65rem;
    right: 0.65rem;
  }
  .hot-header-left {
    padding: 0.3rem 0.75rem 0.3rem 0.45rem;
  }
  .hot-header-icon-wrap {
    width: 30px;
    height: 30px;
    font-size: 1rem;
  }
  .hot-world-title {
    font-size: 0.8rem;
  }
  .hot-world-subtitle {
    display: none;
  }
  .hot-back-universes-btn {
    padding: 0.35rem 0.75rem;
    font-size: 0.75rem;
  }
  .hot-circle-btn {
    width: 34px;
    height: 34px;
    font-size: 0.9rem;
  }
  .hot-profile-sidebar {
    position: absolute;
    top: 3.8rem;
    left: 0.75rem;
    right: auto;
    width: auto;
    max-width: calc(100vw - 1.5rem);
    max-height: none;
    overflow: visible;
  }
  .hot-profile-avatar-wrap {
    width: 44px;
    height: 44px;
  }
  .hot-profile-name {
    font-size: 0.95rem;
  }
  .hot-profile-race-title {
    font-size: 0.66rem;
  }
  .hot-profile-status-row {
    font-size: 0.62rem;
  }
  .hot-mood-pills-row {
    gap: 0.25rem;
  }
  .hot-mood-pill {
    padding: 0.15rem 0.4rem;
    font-size: 0.62rem;
  }
  .hot-bottom-bar {
    bottom: 0.6rem;
    left: 0.6rem;
    right: 0.6rem;
    gap: 0.5rem;
  }
  .hot-tagline-panel {
    display: none;
  }
  .hot-music-player {
    min-width: 170px;
    max-width: 220px;
    padding: 0.25rem 0.6rem;
    gap: 0.4rem;
  }
  .hot-music-disc {
    width: 28px;
    height: 28px;
    font-size: 0.85rem;
  }
  .hot-music-title {
    font-size: 0.7rem;
  }
  .hot-music-sub {
    display: none;
  }
  .hot-big-action-circle {
    width: 34px;
    height: 34px;
    font-size: 0.95rem;
  }
  .hot-big-action-label {
    font-size: 0.58rem;
  }
  .hot-loc-btn {
    padding: 0.3rem 0.6rem;
    font-size: 0.68rem;
  }
}

