  /**
   * Helper: Category labels with symbols
   */
  function getCategoryLabel(catId) {
    const cat = STORY_CATEGORIES.find((c) => c.id === catId);
    return cat ? `${cat.icon} ${cat.label}` : '📖 Karya';
