/* ========================================================
   OUR LITTLE UNIVERSE — BEHIND THE YAWN
   A Secret Deep-Ocean Journal — Akhira's Universe
   "The Mermaid Who Loved Beyond the Ocean."
   ======================================================== */

/* --- 1. FULLSCREEN OVERLAY DIALOG --- */
.yawn-behind-overlay {
  position: fixed;
  inset: 0;
  width: 100vw;
  height: 100vh;
  z-index: 9999;
  display: none;
  background: radial-gradient(circle at 50% 12%, rgba(4, 30, 58, 0.98) 0%, rgba(2, 22, 39, 0.98) 45%, rgba(1, 10, 20, 0.99) 100%);
  backdrop-filter: blur(28px);
  -webkit-backdrop-filter: blur(28px);
  color: #f1f5f9;
  font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
  overflow: hidden;
  animation: yawnBehindFadeIn 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

.yawn-behind-overlay.active {
  display: flex !important;
  flex-direction: column;
}

@keyframes yawnBehindFadeIn {
  from {
    opacity: 0;
    transform: scale(0.985);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

/* --- 2. UNDERWATER AMBIENT STAGE & PARTICLES --- */
.yawn-behind-stage {
  position: absolute;
  inset: 0;
  pointer-events: none;
  overflow: hidden;
  z-index: 1;
}

/* Moonlight Caustic Rays piercing through the ocean surface */
.yawn-behind-caustics {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 55%;
  background: linear-gradient(175deg, rgba(125, 211, 252, 0.12) 0%, rgba(167, 139, 250, 0.08) 35%, transparent 100%);
  filter: blur(35px);
  pointer-events: none;
  animation: causticsWave 8s ease-in-out infinite alternate;
}

@keyframes causticsWave {
  0% { transform: translateY(-5px) scaleX(1); opacity: 0.65; }
  50% { transform: translateY(10px) scaleX(1.05); opacity: 0.95; }
  100% { transform: translateY(-5px) scaleX(1); opacity: 0.65; }
}

/* Underwater Palace Silhouette & Mermaid Shimmer */
.yawn-behind-backdrop-art {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 100%;
  max-width: 1200px;
  height: 400px;
  opacity: 0.18;
  background: radial-gradient(ellipse at 50% 100%, rgba(56, 189, 248, 0.35) 0%, rgba(99, 102, 241, 0.18) 50%, transparent 80%);
  pointer-events: none;
  z-index: 1;
}

/* Floating Ocean Bubbles & Sea Foam */
.yawn-behind-bubbles {
  position: absolute;
  inset: 0;
  pointer-events: none;
}

.yawn-behind-bubble {
  position: absolute;
  border-radius: 50%;
  background: radial-gradient(circle at 30% 30%, rgba(255, 255, 255, 0.75), rgba(125, 211, 252, 0.35) 60%, rgba(56, 189, 248, 0.1) 100%);
  box-shadow: 0 0 10px rgba(186, 230, 253, 0.4), inset 0 0 6px rgba(255, 255, 255, 0.6);
  pointer-events: none;
  animation: floatBubble 12s linear infinite;
}

.yawn-behind-bubble.b1 { width: 14px; height: 14px; left: 8%; bottom: -20px; animation-duration: 11s; animation-delay: 0s; }
.yawn-behind-bubble.b2 { width: 22px; height: 22px; left: 22%; bottom: -30px; animation-duration: 14s; animation-delay: 2.5s; }
.yawn-behind-bubble.b3 { width: 10px; height: 10px; left: 45%; bottom: -15px; animation-duration: 9s; animation-delay: 1.2s; }
.yawn-behind-bubble.b4 { width: 28px; height: 28px; left: 68%; bottom: -40px; animation-duration: 16s; animation-delay: 4.8s; }
.yawn-behind-bubble.b5 { width: 16px; height: 16px; left: 85%; bottom: -25px; animation-duration: 13s; animation-delay: 3s; }
.yawn-behind-bubble.b6 { width: 8px; height: 8px; left: 93%; bottom: -10px; animation-duration: 8s; animation-delay: 6s; }

@keyframes floatBubble {
  0% { transform: translateY(0) translateX(0); opacity: 0; }
  15% { opacity: 0.8; }
  85% { opacity: 0.8; }
  100% { transform: translateY(-105vh) translateX(30px); opacity: 0; }
}

/* Floating Jellyfish & Pearl Spangles */
.yawn-behind-particles {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 1;
}

.yawn-behind-particles .particle {
  position: absolute;
  color: rgba(186, 230, 253, 0.5);
  font-size: 1.2rem;
  animation: floatSeaParticle 10s ease-in-out infinite alternate;
  user-select: none;
}

.yawn-behind-particles .p1 { top: 12%; left: 9%; animation-delay: 0s; font-size: 1.6rem; color: rgba(199, 210, 254, 0.65); }
.yawn-behind-particles .p2 { top: 25%; right: 12%; animation-delay: 2.1s; font-size: 1.2rem; color: rgba(147, 197, 253, 0.6); }
.yawn-behind-particles .p3 { bottom: 20%; left: 14%; animation-delay: 3.8s; font-size: 1.8rem; color: rgba(165, 180, 252, 0.55); }
.yawn-behind-particles .p4 { bottom: 28%; right: 18%; animation-delay: 5.5s; font-size: 1.3rem; color: rgba(125, 211, 252, 0.7); }

@keyframes floatSeaParticle {
  from { transform: translateY(0) rotate(0deg); }
  to { transform: translateY(-24px) rotate(12deg); }
}

/* --- 3. MAIN CONTAINER & MODAL FRAME --- */
.yawn-behind-container {
  position: relative;
  z-index: 10;
  display: flex;
  flex-direction: column;
  width: 100%;
  max-width: 1140px;
  height: 94vh;
  margin: auto;
  border-radius: 24px;
  background: rgba(4, 20, 38, 0.82);
  border: 1px solid rgba(125, 211, 252, 0.35);
  box-shadow: 0 20px 60px rgba(0, 5, 16, 0.8), 0 0 45px rgba(56, 189, 248, 0.18), inset 0 0 35px rgba(125, 211, 252, 0.08);
  overflow: hidden;
}

/* --- 4. TOP BAR (HEADER) --- */
.yawn-behind-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px 28px;
  border-bottom: 1px solid rgba(125, 211, 252, 0.18);
  background: linear-gradient(90deg, rgba(2, 22, 39, 0.95), rgba(4, 30, 58, 0.9), rgba(2, 22, 39, 0.95));
  backdrop-filter: blur(16px);
  gap: 16px;
  flex-shrink: 0;
}

.yawn-behind-back-btn,
.yawn-behind-close-btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: rgba(12, 35, 64, 0.7);
  border: 1px solid rgba(125, 211, 252, 0.3);
  color: #e0f2fe;
  padding: 8px 16px;
  border-radius: 999px;
  font-size: 0.84rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  white-space: nowrap;
}

.yawn-behind-back-btn:hover,
.yawn-behind-close-btn:hover {
  background: rgba(14, 45, 85, 0.95);
  border-color: rgba(186, 230, 253, 0.75);
  color: #ffffff;
  transform: translateY(-1px);
  box-shadow: 0 4px 16px rgba(56, 189, 248, 0.3);
}

.yawn-behind-title-badge {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.yawn-behind-author-tag {
  font-size: 0.68rem;
  font-weight: 800;
  letter-spacing: 0.15em;
  color: #7dd3fc;
  text-transform: uppercase;
  margin-bottom: 2px;
}

.yawn-behind-main-title {
  margin: 0;
  font-family: 'Cinzel', serif, Georgia;
  font-size: 1.25rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  color: #ffffff;
  text-shadow: 0 0 16px rgba(125, 211, 252, 0.6);
}

/* --- 5. CHAPTER NAVIGATION TABS (5 CHAPTERS) --- */
.yawn-behind-nav {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 10px 24px;
  background: rgba(3, 16, 30, 0.9);
  border-bottom: 1px solid rgba(125, 211, 252, 0.12);
  flex-wrap: wrap;
  flex-shrink: 0;
}

.yawn-behind-tab-btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 7px 15px;
  border-radius: 999px;
  border: 1px solid rgba(125, 211, 252, 0.2);
  background: rgba(6, 24, 46, 0.6);
  color: #cbd5e1;
  font-size: 0.8rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.25s ease;
}

.yawn-behind-tab-btn .tab-num {
  font-size: 0.7rem;
  color: #7dd3fc;
  font-weight: 700;
  letter-spacing: 0.05em;
}

.yawn-behind-tab-btn .tab-title {
  color: #e2e8f0;
}

.yawn-behind-tab-btn:hover {
  background: rgba(14, 40, 75, 0.8);
  border-color: rgba(125, 211, 252, 0.5);
  color: #ffffff;
  transform: translateY(-1px);
}

.yawn-behind-tab-btn.active {
  background: linear-gradient(135deg, rgba(2, 132, 199, 0.35), rgba(99, 102, 241, 0.35));
  border-color: rgba(125, 211, 252, 0.85);
  color: #ffffff;
  box-shadow: 0 0 16px rgba(56, 189, 248, 0.35);
}

.yawn-behind-tab-btn.active .tab-num {
  color: #ffffff;
  text-shadow: 0 0 8px rgba(125, 211, 252, 0.8);
}

/* Reading Progress Bar */
.yawn-behind-progress-track {
  width: 100%;
  height: 3px;
  background: rgba(125, 211, 252, 0.1);
  position: relative;
  flex-shrink: 0;
}

.yawn-behind-progress-bar {
  height: 100%;
  width: 20%;
  background: linear-gradient(90deg, #38bdf8, #818cf8, #c084fc);
  box-shadow: 0 0 10px rgba(56, 189, 248, 0.8);
  transition: width 0.4s cubic-bezier(0.16, 1, 0.3, 1);
}

/* --- 6. STORYBOOK DECK & PANELS --- */
.yawn-behind-book-deck {
  position: relative;
  flex: 1;
  overflow-y: auto;
  overflow-x: hidden;
  padding: 32px 42px;
  scrollbar-width: thin;
  scrollbar-color: rgba(125, 211, 252, 0.3) rgba(2, 14, 26, 0.4);
}

.yawn-behind-book-deck::-webkit-scrollbar {
  width: 6px;
}
.yawn-behind-book-deck::-webkit-scrollbar-thumb {
  background: rgba(125, 211, 252, 0.3);
  border-radius: 999px;
}

/* Chapter Panel Transition (Ocean Wave Fade) */
.yawn-behind-chapter-panel {
  display: none;
  animation: oceanWaveFade 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

.yawn-behind-chapter-panel.active {
  display: block;
}

@keyframes oceanWaveFade {
  0% {
    opacity: 0;
    transform: translateY(18px) scale(0.99);
  }
  100% {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

/* Chapter Header */
.yawn-chapter-header {
  text-align: center;
  margin-bottom: 30px;
  position: relative;
}

.yawn-chapter-badge {
  display: inline-block;
  padding: 4px 14px;
  border-radius: 999px;
  background: rgba(14, 42, 75, 0.6);
  border: 1px solid rgba(125, 211, 252, 0.4);
  font-size: 0.72rem;
  font-weight: 800;
  letter-spacing: 0.16em;
  color: #7dd3fc;
  text-transform: uppercase;
  margin-bottom: 10px;
}

.yawn-chapter-main-title {
  margin: 0 0 6px 0;
  font-family: 'Cinzel', serif, Georgia;
  font-size: 1.85rem;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 0.05em;
  text-shadow: 0 0 18px rgba(125, 211, 252, 0.65);
}

.yawn-chapter-sub-title {
  margin: 0;
  font-size: 0.98rem;
  font-style: italic;
  color: #cbd5e1;
  letter-spacing: 0.02em;
}

/* Narrative Body Typography & Drop Caps */
.yawn-journal-p {
  font-size: 1.02rem;
  line-height: 1.88;
  color: #e2e8f0;
  margin-bottom: 20px;
  text-align: justify;
}

.yawn-journal-p.drop-cap::first-letter {
  float: left;
  font-family: 'Cinzel', serif, Georgia;
  font-size: 3.2rem;
  line-height: 0.85;
  padding-top: 4px;
  padding-right: 12px;
  padding-bottom: 2px;
  color: #7dd3fc;
  font-weight: 700;
  text-shadow: 0 0 16px rgba(125, 211, 252, 0.75);
}

/* Narrative Layout Cards & Grids */
.yawn-story-grid-2col {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24px;
  margin: 28px 0;
}

.yawn-story-card {
  padding: 24px;
  border-radius: 18px;
  background: rgba(6, 26, 48, 0.65);
  border: 1px solid rgba(125, 211, 252, 0.25);
  backdrop-filter: blur(12px);
  box-shadow: 0 10px 28px rgba(0, 0, 0, 0.4);
  transition: all 0.3s ease;
}

.yawn-story-card:hover {
  border-color: rgba(125, 211, 252, 0.55);
  transform: translateY(-2px);
  box-shadow: 0 14px 34px rgba(0, 0, 0, 0.5), 0 0 20px rgba(56, 189, 248, 0.2);
}

.yawn-story-card-icon {
  font-size: 2.2rem;
  margin-bottom: 12px;
  display: block;
}

.yawn-story-card h4 {
  margin: 0 0 8px 0;
  font-size: 1.15rem;
  color: #ffffff;
  font-weight: 700;
  letter-spacing: 0.02em;
}

.yawn-story-card p {
  margin: 0;
  font-size: 0.92rem;
  line-height: 1.7;
  color: #cbd5e1;
}

/* Mermaid Hero Callout Banner */
.yawn-mermaid-hero-banner {
  display: flex;
  align-items: center;
  gap: 24px;
  padding: 24px 28px;
  border-radius: 20px;
  background: linear-gradient(135deg, rgba(3, 105, 161, 0.3), rgba(99, 102, 241, 0.2));
  border: 1px solid rgba(125, 211, 252, 0.4);
  margin: 26px 0;
  position: relative;
  overflow: hidden;
}

.yawn-mermaid-hero-banner::before {
  content: '';
  position: absolute;
  top: -50%;
  right: -20%;
  width: 200px;
  height: 200px;
  background: radial-gradient(circle, rgba(125, 211, 252, 0.25), transparent 70%);
  pointer-events: none;
}

.mermaid-avatar-frame {
  width: 80px;
  height: 80px;
  border-radius: 50%;
  border: 2px solid rgba(125, 211, 252, 0.7);
  box-shadow: 0 0 20px rgba(56, 189, 248, 0.5);
  overflow: hidden;
  flex-shrink: 0;
}

.mermaid-avatar-frame img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.mermaid-banner-text h3 {
  margin: 0 0 6px 0;
  font-size: 1.15rem;
  color: #ffffff;
  font-weight: 700;
}

.mermaid-banner-text p {
  margin: 0;
  font-size: 0.94rem;
  line-height: 1.6;
  color: #cbd5e1;
  font-style: italic;
}

/* Sea Foam Quote Box */
.yawn-seafoam-quote {
  padding: 22px 28px;
  border-radius: 16px;
  background: rgba(8, 30, 56, 0.75);
  border-left: 4px solid #7dd3fc;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35);
  margin: 24px 0;
}

.yawn-seafoam-quote p {
  margin: 0;
  font-size: 1.05rem;
  line-height: 1.75;
  color: #f0f9ff;
  font-style: italic;
}

.yawn-seafoam-quote span {
  display: block;
  margin-top: 8px;
  font-size: 0.8rem;
  font-weight: 700;
  color: #7dd3fc;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

/* --- 7. CHAPTER IV: PEARL PARCHMENT LETTER --- */
.yawn-pearl-parchment {
  max-width: 840px;
  margin: 0 auto;
  position: relative;
  background: radial-gradient(circle at 50% 20%, rgba(14, 40, 72, 0.95), rgba(6, 25, 48, 0.98));
  border: 1px solid rgba(186, 230, 253, 0.45);
  border-radius: 22px;
  padding: 42px 48px;
  box-shadow: 0 16px 45px rgba(0, 0, 0, 0.65), 0 0 30px rgba(125, 211, 252, 0.2), inset 0 0 40px rgba(125, 211, 252, 0.08);
}

.yawn-pearl-seal {
  position: absolute;
  top: -20px;
  right: 48px;
  background: linear-gradient(135deg, #0284c7, #6366f1);
  color: #ffffff;
  padding: 6px 16px;
  border-radius: 999px;
  font-size: 0.75rem;
  font-weight: 800;
  letter-spacing: 0.12em;
  border: 1px solid rgba(255, 255, 255, 0.6);
  box-shadow: 0 4px 18px rgba(2, 132, 199, 0.6);
  text-transform: uppercase;
}

.yawn-letter-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1px solid rgba(125, 211, 252, 0.25);
  padding-bottom: 12px;
  margin-bottom: 24px;
}

.yawn-letter-tag {
  font-size: 0.78rem;
  color: #7dd3fc;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
}

.yawn-letter-date {
  font-size: 0.76rem;
  color: #94a3b8;
  font-style: italic;
}

.yawn-letter-salutation {
  font-family: 'Cinzel', serif, Georgia;
  font-size: 1.28rem;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 20px;
  text-shadow: 0 0 12px rgba(125, 211, 252, 0.5);
}

.yawn-letter-body {
  font-size: 0.98rem;
  line-height: 1.88;
  color: #e2e8f0;
}

.yawn-letter-body p {
  margin: 0 0 16px 0;
  text-align: justify;
}

.yawn-letter-body p strong {
  color: #7dd3fc;
  font-weight: 700;
}

.yawn-letter-body .letter-highlight {
  background: rgba(56, 189, 248, 0.12);
  border-left: 3px solid #38bdf8;
  padding: 10px 16px;
  border-radius: 0 8px 8px 0;
  font-style: italic;
  color: #f0f9ff;
  margin: 18px 0;
}

.yawn-letter-signoff {
  margin-top: 30px;
  text-align: right;
  font-style: italic;
  color: #bae6fd;
}

.yawn-letter-signoff .author-signature {
  font-family: 'Cinzel', serif, Georgia;
  font-size: 1.25rem;
  font-weight: 700;
  color: #ffffff;
  display: block;
  margin-top: 4px;
  text-shadow: 0 0 10px rgba(125, 211, 252, 0.6);
}

/* Read Again Button (Replay Letter) */
.yawn-letter-actions {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 32px;
}

.btn-yawn-letter-replay {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 10px 24px;
  border-radius: 999px;
  background: linear-gradient(135deg, rgba(2, 132, 199, 0.4), rgba(99, 102, 241, 0.4));
  border: 1px solid rgba(125, 211, 252, 0.6);
  color: #ffffff;
  font-size: 0.88rem;
  font-weight: 700;
  cursor: pointer;
  box-shadow: 0 6px 20px rgba(2, 132, 199, 0.35);
  transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
}

.btn-yawn-letter-replay:hover {
  transform: translateY(-2px);
  background: linear-gradient(135deg, rgba(2, 132, 199, 0.6), rgba(99, 102, 241, 0.6));
  border-color: #bae6fd;
  box-shadow: 0 8px 26px rgba(2, 132, 199, 0.55), 0 0 16px rgba(125, 211, 252, 0.4);
}

/* --- 8. CHAPTER V: YAWN SONG & EPILOGUE --- */
.yawn-music-player-container {
  max-width: 860px;
  margin: 0 auto 30px auto;
  border-radius: 20px;
  background: rgba(3, 18, 36, 0.85);
  border: 1px solid rgba(125, 211, 252, 0.3);
  padding: 26px;
  box-shadow: 0 12px 35px rgba(0, 0, 0, 0.5);
}

.yawn-song-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18px;
  gap: 16px;
  flex-wrap: wrap;
}

.yawn-song-info {
  display: flex;
  align-items: center;
  gap: 14px;
}

.yawn-song-disc {
  width: 52px;
  height: 52px;
  border-radius: 50%;
  background: radial-gradient(circle, #0284c7 20%, #082f49 60%, #0369a1 100%);
  border: 2px solid rgba(125, 211, 252, 0.7);
  box-shadow: 0 0 16px rgba(56, 189, 248, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.4rem;
  animation: discSpin 14s linear infinite;
  animation-play-state: paused;
}

.yawn-song-disc.playing {
  animation-play-state: running;
}

@keyframes discSpin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.yawn-song-titles h4 {
  margin: 0;
  font-size: 1.12rem;
  font-weight: 700;
  color: #ffffff;
}

.yawn-song-titles p {
  margin: 2px 0 0 0;
  font-size: 0.82rem;
  color: #7dd3fc;
  font-style: italic;
}

.yawn-song-controls {
  display: flex;
  align-items: center;
  gap: 12px;
}

.btn-yawn-song-toggle {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 8px 20px;
  border-radius: 999px;
  background: linear-gradient(135deg, #0284c7, #6366f1);
  border: 1px solid rgba(186, 230, 253, 0.6);
  color: #ffffff;
  font-size: 0.84rem;
  font-weight: 700;
  cursor: pointer;
  box-shadow: 0 4px 16px rgba(2, 132, 199, 0.4);
  transition: all 0.25s ease;
}

.btn-yawn-song-toggle:hover {
  transform: translateY(-1px);
  box-shadow: 0 6px 22px rgba(2, 132, 199, 0.6);
}

/* YouTube Video Responsive Wrapper */
.yawn-youtube-wrapper {
  position: relative;
  width: 100%;
  padding-bottom: 56.25%; /* 16:9 Aspect Ratio */
  height: 0;
  overflow: hidden;
  border-radius: 14px;
  border: 1px solid rgba(125, 211, 252, 0.25);
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.5);
  background: #000;
  margin-bottom: 20px;
}

.yawn-youtube-wrapper iframe {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  border: none;
}

/* Epilogue Climax Quote Box */
.yawn-epilogue-climax {
  max-width: 860px;
  margin: 28px auto 10px auto;
  text-align: center;
  padding: 34px 38px;
  border-radius: 20px;
  background: linear-gradient(135deg, rgba(3, 105, 161, 0.35), rgba(99, 102, 241, 0.25));
  border: 1px solid rgba(125, 211, 252, 0.5);
  box-shadow: 0 12px 35px rgba(0, 0, 0, 0.5), 0 0 25px rgba(56, 189, 248, 0.2);
}

.yawn-epilogue-climax h3 {
  margin: 0 0 12px 0;
  font-family: 'Cinzel', serif, Georgia;
  font-size: 1.45rem;
  font-weight: 700;
  color: #ffffff;
  text-shadow: 0 0 14px rgba(125, 211, 252, 0.7);
}

.yawn-epilogue-climax p {
  margin: 0;
  font-size: 1.05rem;
  line-height: 1.8;
  color: #f0f9ff;
  font-style: italic;
}

/* --- 9. FOOTER NAVIGATION --- */
.yawn-behind-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14px 28px;
  background: linear-gradient(90deg, rgba(2, 22, 39, 0.95), rgba(4, 30, 58, 0.9), rgba(2, 22, 39, 0.95));
  border-top: 1px solid rgba(125, 211, 252, 0.18);
  flex-shrink: 0;
}

.yawn-behind-nav-btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 8px 18px;
  border-radius: 999px;
  background: rgba(12, 35, 64, 0.7);
  border: 1px solid rgba(125, 211, 252, 0.3);
  color: #e0f2fe;
  font-size: 0.84rem;
  font-weight: 700;
  cursor: pointer;
  transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
}

.yawn-behind-nav-btn:hover:not(:disabled) {
  background: rgba(14, 45, 85, 0.95);
  border-color: rgba(186, 230, 253, 0.75);
  color: #ffffff;
  transform: translateY(-1px);
  box-shadow: 0 4px 16px rgba(56, 189, 248, 0.3);
}

.yawn-behind-nav-btn:disabled {
  opacity: 0.35;
  cursor: not-allowed;
  transform: none !important;
}

.yawn-behind-footer-indicator {
  display: flex;
  align-items: center;
  gap: 8px;
}

.yawn-indicator-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: rgba(125, 211, 252, 0.3);
  cursor: pointer;
  transition: all 0.25s ease;
}

.yawn-indicator-dot.active {
  width: 24px;
  border-radius: 999px;
  background: #38bdf8;
  box-shadow: 0 0 10px rgba(56, 189, 248, 0.8);
}

/* --- 10. UNIVERSE HUD PILL BUTTON STYLES --- */
.yawn-behind-pill {
  display: inline-flex;
  align-items: center;
  gap: 0.55rem;
  background: linear-gradient(135deg, rgba(8, 28, 56, 0.85) 0%, rgba(14, 45, 85, 0.85) 100%);
  border: 1px solid rgba(125, 211, 252, 0.5);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  color: #f0f9ff;
  padding: 0.42rem 0.95rem;
  border-radius: 999px;
  cursor: pointer;
  box-shadow: 0 4px 18px rgba(2, 14, 26, 0.5), 0 0 14px rgba(56, 189, 248, 0.25);
  transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  text-decoration: none;
}

.yawn-behind-pill:hover {
  background: linear-gradient(135deg, rgba(12, 38, 75, 0.95) 0%, rgba(18, 58, 110, 0.95) 100%);
  border-color: rgba(186, 230, 253, 0.9);
  color: #ffffff;
  transform: translateY(-2px);
  box-shadow: 0 6px 24px rgba(2, 14, 26, 0.65), 0 0 20px rgba(56, 189, 248, 0.5);
}

.yawn-behind-pill .goto-icon {
  font-size: 1.1rem;
}

.yawn-behind-label {
  display: flex;
  flex-direction: column;
  text-align: left;
  line-height: 1.15;
}

.yawn-behind-main {
  font-size: 0.74rem;
  font-weight: 800;
  letter-spacing: 0.08em;
  color: #ffffff;
  text-shadow: 0 0 8px rgba(125, 211, 252, 0.6);
}

.yawn-behind-sub {
  font-size: 0.62rem;
  font-weight: 500;
  color: #bae6fd;
}

/* --- 11. RESPONSIVENESS (MOBILE / TABLET) --- */
@media (max-width: 768px) {
  .yawn-behind-container {
    height: 98vh;
    border-radius: 16px;
  }
  .yawn-behind-header {
    padding: 12px 16px;
  }
  .yawn-behind-book-deck {
    padding: 20px 16px;
  }
  .yawn-behind-nav {
    padding: 8px 12px;
    gap: 6px;
  }
  .yawn-behind-tab-btn {
    padding: 6px 10px;
    font-size: 0.74rem;
  }
  .yawn-story-grid-2col {
    grid-template-columns: 1fr;
    gap: 16px;
  }
  .yawn-pearl-parchment {
    padding: 26px 20px;
  }
  .yawn-pearl-seal {
    right: 20px;
    font-size: 0.68rem;
    padding: 4px 12px;
  }
  .yawn-chapter-main-title {
    font-size: 1.45rem;
  }
  .yawn-behind-pill .yawn-behind-sub {
    display: none;
  }
}
