// -----------------------------------------------------------------------------
// 9. STORAGE PERSISTENCE (LOAD / SAVE / RESET)
// -----------------------------------------------------------------------------
export function loadDragonDenState(characterKey = 'ruben') {
  try {
    return getSynchronousState(
      OLU_STORE_HOUSE_STATES,
      DRAGON_DEN_STORAGE_KEY,
      () => createDefaultDragonDenState()
    );
  } catch (err) {
    console.warn('[DragonDenState] Failed to load from storage engine, returning defaults:', err);
    return createDefaultDragonDenState();
  }
}

export function saveDragonDenState(characterKey = 'ruben', stateObj = null) {
  if (!stateObj) return;
  try {
    const payload = {
      ...stateObj,
      character: characterKey || 'ruben',
      updatedAt: Date.now()
    };
    setSynchronousState(
      OLU_STORE_HOUSE_STATES,
      DRAGON_DEN_STORAGE_KEY,
      payload,
      { character: characterKey || 'ruben', universe: 'ASH' }
    );
  } catch (err) {
    console.error('[DragonDenState] Failed to persist to storage engine:', err);
  }
}

export function resetDragonDenState(characterKey = 'ruben') {
  const fresh = createDefaultDragonDenState();
  saveDragonDenState(characterKey, fresh);
  return fresh;
}

